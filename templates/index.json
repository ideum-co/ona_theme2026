        "testimonials": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<!-- Placeholder testimonial -- Sasa offered to source real, named ONA Coffee Club member\n     quotes (DES-8 thread, 2026-08-10) but none were provided yet. This is the same\n     placeholder shown in the approved club-benefits.png design reference, not a real\n     customer quote. Swap TESTIMONIALS below once real ones land. -->\n<div class=\"ona-testimonials\" data-testimonials>\n  <style>\n    .ona-testimonials { position: relative; max-width: 640px; margin: 0 auto; text-align: center; padding: 0 56px; }\n    .ona-testimonials [data-quote] { font-size: 1.125rem; margin: 0 0 20px; }\n    .ona-testimonials [data-name] { margin: 0; }\n    .ona-testimonials [data-role] { margin: 2px 0 0; font-style: italic; opacity: .85; }\n    .ona-testimonials button { position: absolute; top: 40%; background: none; border: none; color: inherit; cursor: pointer; padding: 8px; }\n    .ona-testimonials [data-prev] { left: 0; }\n    .ona-testimonials [data-next] { right: 0; }\n  </style>\n  <button type=\"button\" data-prev aria-label=\"Previous testimonial\"><svg width=\"9\" height=\"16\" viewBox=\"0 0 9 16\" fill=\"none\"><path d=\"M8 1L1 8L8 15\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>\n  <p data-quote></p>\n  <p data-name></p>\n  <p data-role></p>\n  <button type=\"button\" data-next aria-label=\"Next testimonial\"><svg width=\"9\" height=\"16\" viewBox=\"0 0 9 16\" fill=\"none\"><path d=\"M1 1L8 8L1 15\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>\n  <script>\n    (() => {\n      const TESTIMONIALS = [\n        { quote: \"The easiest way to make sure I never run out of great coffee. I love getting to discover new ONA coffees along the way.\", name: \"Sarah\", role: \"ONA Coffee Club member\" },\n      ];\n      document.querySelectorAll('[data-testimonials]').forEach((root) => {\n        let i = 0;\n        const quote = root.querySelector('[data-quote]');\n        const name = root.querySelector('[data-name]');\n        const role = root.querySelector('[data-role]');\n        function render() {\n          quote.textContent = '\\u201c' + TESTIMONIALS[i].quote + '\\u201d';\n          name.textContent = TESTIMONIALS[i].name;\n          role.textContent = TESTIMONIALS[i].role;\n        }\n        root.querySelector('[data-prev]').addEventListener('click', () => { i = (i - 1 + TESTIMONIALS.length) % TESTIMONIALS.length; render(); });\n        root.querySelector('[data-next]').addEventListener('click', () => { i = (i + 1) % TESTIMONIALS.length; render(); });\n        render();\n      });\n    })();\n  </script>\n</div>"
          },
