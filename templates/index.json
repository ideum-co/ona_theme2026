    "press_quotes_4kW9eF": {
      "type": "press-quotes",
      "blocks": {
        "quote_aCYyE8": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/urban.svg",
            "source": "",
            "quote": "“If you’ve been fortunate enough to visit ONA’s Canberra location, or any others for that matter, you’ll be aware of the meticulous details found within their cafes.”"
          }
        },
        "quote_efak7r": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/espresso.svg",
            "source": "",
            "quote": "“Since 2012, our partnership with ONA Coffee has allowed us to revolutionise the local specialty coffee scene. Built on a shared passion for excellence, ONA’s world-class beans and expertise help us deliver an exceptional experience to our customers every single day.”"
          }
        },
        "quote_NUbmXf": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/broadsheet.svg",
            "source": "",
            "quote": "“Canberra’s Ona Coffee is one of the country’s most acclaimed coffee roasters, and its Sydney flagship cafe in Marrickville is unlike anywhere else in Sydney.”"
          }
        },
        "quote_ginninderry": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/ginny.jpg",
            "source": "Ginninderry Espresso",
            "quote": "“We are delighted to have partnered with ONA Coffee, a brand that not only enhances our coffee offerings but also symbolises a commitment to excellence in the art of brewing. The support we receive from ONA is invaluable, elevating our focus on delivering exceptional coffee experiences in this area of Canberra.”"
          }
        },
        "quote_faducci": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/faducci_logo.jpg",
            "source": "Cafe Faducci",
            "quote": "“Choosing ONA Coffee for Cafe Faducci over the past five years has been one of the best decisions we’ve made. Their commitment to sourcing the finest beans and their unwavering dedication to quality is evident in every cup we serve. Our customers continually rave about the rich, complex flavours of ONA Coffee, making it a cornerstone of our cafe’s success.”"
          }
        },
        "quote_precinct37": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/precinct_37_logo.jpg",
            "source": "Precinct 37",
            "quote": "“Undeniably coffee is one of the main elements in our business. The quality of the coffee beans and service we’ve received from ONA are always excellent and consistent, which is in line with our business values. Now we’re known around the area for quality coffee. We could not have done it without them.”"
          }
        },
        "quote_freestate": {
          "type": "quote",
          "settings": {
            "logo_svg": "",
            "logo": "shopify://shop_images/freestate.jpg",
            "source": "Freestate",
            "quote": "“We are a community-based cafe obsessed with ONA and its sustainability programs. Their support is out of this world, and we have such a great friendship with Scott too.”"
          }
        }
      },
      "block_order": [
        "quote_aCYyE8",
        "quote_efak7r",
