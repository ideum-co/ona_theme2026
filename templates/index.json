    "raspberry_candy": {
      "type": "section",
      "blocks": {
        "media": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<!-- Rotating 3D viewer, replaces the static Candy.png flat photo. Rotation is driven by page scroll progress through this section (not autoplay), using Google's model-viewer web component (MIT, cdn-hosted). Model: 'raspberry-candy-bag-3d.glb', the smallest of the 3 compressed test exports Formswell provided (742KB). Manual drag-to-rotate stays enabled via camera-controls; zoom/pan disabled so it doesn't hijack page-scroll or trackpad gestures.\n     Width is a fixed px (not %): this block is a flex item with no explicit flex-basis, so a percentage-width child can't resolve against it and collapses to 0 -- confirmed live via Playwright (model-viewer registered + correct src, but 0px rendered width). Fixed width + max-width:100% avoids the circular reference while still capping to the container on narrow screens. -->\n<div id=\"raspberry-3d-{{ section.id }}\" style=\"width:380px; max-width:100%; margin:0 auto;\">\n  <model-viewer\n    src=\"{{ 'raspberry-candy-bag-3d.glb' | file_url }}\"\n    alt=\"ONA Raspberry Candy coffee bag, 3D\"\n    camera-controls\n    disable-zoom\n    disable-pan\n    interaction-prompt=\"none\"\n    shadow-intensity=\"1\"\n    exposure=\"1\"\n    camera-orbit=\"35deg 62deg 105%\"\n    style=\"width:380px; max-width:100%; height:460px; background:transparent;\"\n  ></model-viewer>\n</div>\n<script type=\"module\" src=\"https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js\"></script>\n<script>\n  (() => {\n    const root = document.getElementById('raspberry-3d-{{ section.id }}');\n    if (!root || root.dataset.rotateInit) return;\n    root.dataset.rotateInit = '1';\n    const viewer = root.querySelector('model-viewer');\n    const REST_THETA = 35;\n    const PHI = 62;\n    let ticking = false;\n    function updateRotation() {\n      ticking = false;\n      const rect = root.getBoundingClientRect();\n      const vh = window.innerHeight || document.documentElement.clientHeight;\n      const total = rect.height + vh;\n      const traveled = vh - rect.top;\n      let progress = total > 0 ? traveled / total : 0;\n      progress = Math.min(1, Math.max(0, progress));\n      const theta = (REST_THETA + progress * 360) % 360;\n      viewer.cameraOrbit = theta.toFixed(1) + 'deg ' + PHI + 'deg 105%';\n    }\n    function onScroll() {\n      if (!ticking) {\n        ticking = true;\n        window.requestAnimationFrame(updateRotation);\n      }\n    }\n    window.addEventListener('scroll', onScroll, { passive: true });\n    updateRotation();\n  })();\n</script>"
          },
          "blocks": {}
        },
