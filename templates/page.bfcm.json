{
  "sections": {
    "main": {
      "type": "bfcm-landing",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "background_color": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "square",
                "image_fit": "contain",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 40,
                "padding-block-end": 40,
                "padding-inline-start": 40,
                "padding-inline-end": 40
              },
              "blocks": {}
            },
            "ona_promo_tags": {
              "type": "ona-product-tags",
              "settings": {
                "tag_alignment": "left",
                "tag_font_size": 14,
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {}
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "2rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "text_color": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "roast_line": {
              "type": "product-metafield-text",
              "name": "t:names.product_metafield_text",
              "settings": {
                "namespace": "accentuate",
                "key": "roast",
                "label": "",
                "type_preset": "custom",
                "width": "100%",
                "alignment": "center",
                "font": "var(--font-body--family)",
                "font_size": "1.25rem",
                "line_height": "normal",
                "letter_spacing": "loose",
                "case": "uppercase",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "tastes_line": {
              "type": "product-metafield-text",
              "name": "t:names.product_metafield_text",
              "settings": {
                "namespace": "accentuate",
                "key": "tastes_like",
                "label": "",
                "type_preset": "paragraph",
                "width": "100%",
                "alignment": "center",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "card_price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "center",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "text_color": "",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "variant_picker": {
              "type": "variant-picker",
              "name": "t:names.variant_picker",
              "settings": {
                "variant_style": "custom_dropdown",
                "show_swatches": false,
                "option_label_text_color": "",
