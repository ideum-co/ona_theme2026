                  "blocks": {
                    "quantity": {
                      "type": "quantity",
                      "static": true,
                      "settings": {
                        "input_style": "default",
                        "input_background_color": "{{ settings.color_palette.background }}",
                        "input_text_color": "{{ settings.color_palette.foreground }}",
                        "input_border_color": "{{ settings.color_palette.foreground }}",
                        "border_width": 1,
                        "border_radius": 0
                      },
                      "blocks": {}
                    },
                    "add-to-cart": {
                      "type": "add-to-cart",
                      "static": true,
                      "settings": {
                        "style_class": "button",
                        "custom_button_background": "{{ settings.color_palette.color1 }}",
                        "custom_button_text": "{{ settings.color_palette.background }}",
                        "custom_button_border": "{{ settings.color_palette.background }}"
                      },
                      "blocks": {}
                    },
                    "accelerated-checkout": {
                      "type": "accelerated-checkout",
                      "static": true,
                      "settings": {},
                      "blocks": {}
                    }
                  },
                  "block_order": []
                },
                "subscribe": {
                  "type": "subscribe-button",
                  "name": "t:names.subscribe_button",
                  "settings": {
                    "label": "Subscribe",
                    "style_class": "button"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "buy_buttons",
                "subscribe"
              ]
            }
          },
          "block_order": [
            "product_card_gallery",
            "ona_promo_tags",
            "product_title",
            "roast_line",
            "tastes_line",
            "card_price",
            "variant_picker",
            "buy_group"
          ]
