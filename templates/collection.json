    "below_fold": {
      "type": "section",
      "blocks": {
        "body": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% liquid\n  assign desc_parts = closest.collection.description | split: '<!-- split -->'\n  assign below_fold_html = desc_parts[1]\n%}\n{% if below_fold_html != blank %}\n  <div class=\"collection-below-fold\">\n    {{ below_fold_html }}\n  </div>\n  <style>\n    .collection-below-fold { width: 100%; }\n    .collection-below-fold h2 { margin: 1.5em 0 0.5em; font-size: 1.5rem; }\n    .collection-below-fold h2:first-child { margin-top: 0; }\n    .collection-below-fold p { margin: 0 0 1em; line-height: 1.6; }\n    .collection-below-fold a { text-decoration: underline; }\n    .collection-below-fold__read-more { margin-top: 8px; }\n  </style>\n  <script>\n    (function () {\n      document.querySelectorAll('.collection-below-fold .readmore-text').forEach(function (block) {\n        if (block.dataset.readmoreInit) return;\n        block.dataset.readmoreInit = '1';\n        var button = document.createElement('button');\n        button.type = 'button';\n        button.className = 'button-secondary collection-below-fold__read-more';\n        button.textContent = 'Read more';\n        button.setAttribute('aria-expanded', 'false');\n        block.parentNode.insertBefore(button, block);\n        button.addEventListener('click', function () {\n          var expanded = block.style.display !== 'none';\n          block.style.display = expanded ? 'none' : '';\n          button.textContent = expanded ? 'Read more' : 'Read less';\n          button.setAttribute('aria-expanded', String(!expanded));\n        });\n      });\n    })();\n  </script>\n{% endif %}"
          },
          "blocks": {}
        }
