                "custom_liquid": "{% liquid\n  assign tastes_like = closest.product.metafields.accentuate.tastes_like.value\n  assign roast = closest.product.metafields.accentuate.roast.value\n  assign components = closest.product.metafields.accentuate.components.value\n%}\n{% if tastes_like != blank or roast != blank or components != blank %}\n  <div class=\"product-properties\">\n    {% if tastes_like != blank %}\n      <div class=\"product-properties__row\">\n        <span class=\"product-properties__label\">Tastes Like</span>\n        <span class=\"product-properties__value\">{{ tastes_like }}</span>\n      </div>\n    {% endif %}\n    {% if roast != blank %}\n      <div class=\"product-properties__row\">\n        <span class=\"product-properties__label\">Roast</span>\n        <span class=\"product-properties__value\">{{ roast }}</span>\n      </div>\n    {% endif %}\n    {% if components != blank %}\n      <div class=\"product-properties__row\">\n        <span class=\"product-properties__label\">Components</span>\n        <span class=\"product-properties__value\">{{ components }}</span>\n      </div>\n    {% endif %}\n  </div>\n  <style>\n    .product-properties {\n      width: 100%;\n      border-top: 1px solid var(--border-color);\n    }\n    .product-properties__row {\n      display: grid;\n      grid-template-columns: minmax(100px, 0.35fr) 1fr;\n      gap: var(--gap-md);\n      padding: var(--gap-sm) 0;\n      border-bottom: 1px solid var(--border-color);\n    }\n    .product-properties__label {\n      font-size: var(--font-size--xs);\n      font-weight: 600;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n      color: var(--color-foreground-secondary);\n    }\n    .product-properties__value {\n      font-size: var(--font-size--sm);\n      line-height: 1.6;\n    }\n  </style>\n{% endif %}"
