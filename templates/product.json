    "story": {
      "type": "section",
      "blocks": {
        "body": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% liquid\n  assign content_origin = closest.product.metafields.accentuate.content_origin.value\n  assign content_sourcing = closest.product.metafields.accentuate.content_sourcing.value\n  assign content_coffee_profile = closest.product.metafields.accentuate.content_coffee_profile.value\n  assign producer = closest.product.metafields.accentuate.producer.value\n  assign region = closest.product.metafields.accentuate.region.value\n  assign process = closest.product.metafields.accentuate.process.value\n  assign varietal = closest.product.metafields.accentuate.varietal.value\n  assign altitude = closest.product.metafields.accentuate.altitude.value\n  assign is_single_origin = false\n  if content_origin != blank or content_sourcing != blank\n    assign is_single_origin = true\n  endif\n  assign has_specs = false\n  if producer != blank or region != blank or process != blank or varietal != blank or altitude != blank\n    assign has_specs = true\n  endif\n%}\n{% if is_single_origin %}\n  <div class=\"product-story\">\n    {% if content_origin != blank %}\n      <div class=\"product-story__block product-story__block--origin rte\">{{ content_origin }}</div>\n    {% endif %}\n    {% if content_sourcing != blank %}\n      <div class=\"product-story__block product-story__block--sourcing rte\">{{ content_sourcing }}</div>\n    {% endif %}\n    {% if has_specs %}\n      <dl class=\"product-story__specs\">\n        {% if producer != blank %}\n          <div class=\"product-story__specs-row\"><dt>Producer</dt><dd>{{ producer }}</dd></div>\n        {% endif %}\n        {% if region != blank %}\n          <div class=\"product-story__specs-row\"><dt>Region</dt><dd>{{ region }}</dd></div>\n        {% endif %}\n        {% if varietal != blank %}\n          <div class=\"product-story__specs-row\"><dt>Varietal</dt><dd>{{ varietal }}</dd></div>\n        {% endif %}\n        {% if process != blank %}\n          <div class=\"product-story__specs-row\"><dt>Process</dt><dd>{{ process }}</dd></div>\n        {% endif %}\n        {% if altitude != blank %}\n          <div class=\"product-story__specs-row\"><dt>Altitude</dt><dd>{{ altitude }}</dd></div>\n        {% endif %}\n      </dl>\n    {% endif %}\n  </div>\n{% elsif content_coffee_profile != blank %}\n  <div class=\"product-story\">\n    <div class=\"product-story__block product-story__block--profile rte\">{{ content_coffee_profile }}</div>\n  </div>\n{% endif %}\n<style>\n  .product-story { display: grid; gap: var(--gap-2xl); max-width: 46rem; margin: 0 auto; }\n  .product-story__block { font-size: var(--font-size--md); line-height: 1.6; }\n  .product-story__block :is(p, h1, h2, h3, h4, h5, h6, span, div, strong, em, a) {\n    font-family: inherit !important;\n    color: inherit !important;\n    font-size: inherit !important;\n    background: none !important;\n    letter-spacing: normal !important;\n    text-transform: none !important;\n  }\n  .product-story__block h3,\n  .product-story__block h4 {\n    font-family: var(--font-heading--family) !important;\n    font-size: var(--font-size--2xl) !important;\n    margin: 0 0 var(--gap-sm);\n    color: var(--color-foreground);\n  }\n  .product-story__block p { margin: 0 0 1em; }\n  .product-story__block p:last-child { margin-bottom: 0; }\n  .product-story__specs { margin: 0; display: grid; border-top: 1px solid var(--border-color); }\n  .product-story__specs-row { display: grid; grid-template-columns: minmax(120px, 0.4fr) 1fr; gap: var(--gap-md); padding: var(--gap-sm) 0; border-bottom: 1px solid var(--border-color); }\n  .product-story__specs-row dt { margin: 0; font-size: var(--font-size--xs); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-foreground-secondary); }\n  .product-story__specs-row dd { margin: 0; font-size: var(--font-size--sm); line-height: 1.6; }\n</style>\n"
          }
        }
      },
      "block_order": [
        "body"
      ],
      "name": "t:names.section",
      "settings": {
        "content_direction": "column",
