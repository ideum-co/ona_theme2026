    "brew_guide": {
      "type": "section",
      "blocks": {
        "body": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% liquid\n  assign raw_handle = closest.product.metafields.accentuate.select_artlice.value\n  assign brew_intro = closest.product.metafields.accentuate.content_brew_guide.value\n  assign titles = closest.product.metafields.accentuate.title_item\n  assign values = closest.product.metafields.accentuate.content_item\n  assign has_recipe = false\n  if titles.size > 0 and values.size > 0\n    assign has_recipe = true\n  endif\n  assign has_content = false\n  if brew_intro != blank or has_recipe\n    assign has_content = true\n  endif\n%}\n{% if raw_handle != blank and has_content %}\n  {% paginate blogs.brewguides.articles by 250 %}\n    {% for a in blogs.brewguides.articles %}\n      {% if a.handle == raw_handle %}\n        <div class=\"brew-guide\">\n          <div class=\"brew-guide__intro\">\n            <p class=\"brew-guide__eyebrow\">Brew Guide</p>\n            {% if brew_intro != blank %}\n              <div class=\"brew-guide__copy rte\">{{ brew_intro }}</div>\n            {% endif %}\n            <a class=\"brew-guide__link\" href=\"{{ a.url }}\">Full brewing guide</a>\n          </div>\n          {% if has_recipe %}\n            <dl class=\"brew-guide__recipe\">\n              {% for title in titles %}\n                {% assign i = forloop.index0 %}\n                {% assign val = values[i] %}\n                {% if title != blank and val != blank %}\n                  <div class=\"brew-guide__recipe-row\">\n                    <dt class=\"brew-guide__recipe-label\">{{ title | strip }}</dt>\n                    <dd class=\"brew-guide__recipe-value\">{{ val }}</dd>\n                  </div>\n                {% endif %}\n              {% endfor %}\n            </dl>\n          {% endif %}\n        </div>\n        <style>\n          .brew-guide { display: grid; gap: var(--gap-2xl); width: 100%; }\n          @media screen and (min-width: 750px) {\n            .brew-guide { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }\n          }\n          .brew-guide__intro { display: grid; gap: var(--gap-md); }\n          .brew-guide__eyebrow { margin: 0; font-family: var(--font-heading--family); font-size: var(--font-size--3xl); color: var(--color-foreground); }\n          .brew-guide__copy { font-size: var(--font-size--md); line-height: 1.6; }\n          .brew-guide__link { justify-self: start; font-size: var(--font-size--sm); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; color: var(--color-foreground); }\n          .brew-guide__recipe { margin: 0; display: grid; border-top: 1px solid var(--border-color); }\n          .brew-guide__recipe-row { display: grid; grid-template-columns: minmax(120px, 0.4fr) 1fr; gap: var(--gap-md); padding: var(--gap-sm) 0; border-bottom: 1px solid var(--border-color); }\n          .brew-guide__recipe-label { margin: 0; font-size: var(--font-size--xs); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-foreground-secondary); }\n          .brew-guide__recipe-value { margin: 0; font-size: var(--font-size--sm); line-height: 1.6; }\n        </style>\n        {% break %}\n      {% endif %}\n    {% endfor %}\n  {% endpaginate %}\n{% endif %}\n"
          }
        }
      },
