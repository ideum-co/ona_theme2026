{%- doc -%}
  Renders the product card's variant select: the card's "Choose" button plus a modal
  listing every variant with its image, price and availability, and an add to cart
  button for the selected one.

  Unlike `quick-add-modal`, this does not fetch the product page - the whole list is
  rendered with the card, so opening it costs no network request. `quick-add.liquid`
  falls back to the full quick-add modal for products with more variants than
  `variant_select_max_variants` (see `quick-add.liquid`), so a card never has to ship
  hundreds of rows it will not use.

  @param {object} product - The product object.
  @param {string} section_id - The section ID, used by the add to cart form.
  @param {string} id_suffix - Unique suffix for the ids and the radio group name, usually the block id.
  @param {string} choose_text - Label for the button that opens the modal.
{%- enddoc -%}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign unique_id = product.id | append: '-' | append: id_suffix
  assign form_id = 'VariantSelect-ProductForm-' | append: unique_id
  assign radio_group_name = 'variant-select-' | append: unique_id
  assign add_to_cart_text = 'actions.add_to_cart' | t
  assign option_names = product.options | join: ' / '
  assign dialog_title = 'actions.select_option' | t: option: option_names
%}

<variant-select-component
  class="variant-select variant-select--quick-add"
  data-mode="cart"
  data-product-id="{{ product.id }}"
>
  <button
    type="button"
    class="button quick-add__button quick-add__button--choose add-to-cart-button"
    on:click="/showDialog"
    aria-haspopup="dialog"
  >
    <span
      aria-hidden="true"
      class="svg-wrapper add-to-cart-icon"
    >
      {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
    </span>
    {{- choose_text -}}
  </button>

  <dialog
    class="variant-select__dialog dialog-modal color-custom-popover"
    ref="dialog"
    aria-label="{{ dialog_title | escape }}"
    on:click="/handleDialogClick"
    scroll-lock
  >
    <div class="variant-select__header">
      <h2 class="variant-select__title">{{ dialog_title }}</h2>
      <button
        type="button"
        class="button button-unstyled variant-select__close"
        on:click="/closeDialog"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    {% comment %}
      The list sits outside the form on purpose: these radios pick which variant the form
      submits, they are not fields of it, and a named radio inside the form would be posted
      to /cart/add alongside the variant id.
    {% endcomment %}
    <fieldset class="variant-select__list">
      <legend class="visually-hidden">{{ dialog_title }}</legend>
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_image = variant.featured_media.preview_image
          if variant_image == blank
            assign variant_image = product.featured_media.preview_image
          endif
        -%}
        <label class="variant-select__option{% unless variant.available %} variant-select__option--unavailable{% endunless %}">
          <input
            type="radio"
            class="variant-select__input"
            name="{{ radio_group_name }}"
            value="{{ variant.id }}"
            data-variant-id="{{ variant.id }}"
            data-variant-available="{{ variant.available }}"
            data-variant-price="{{ variant.price | money }}"
            {% unless variant.available %}
              disabled
            {% endunless %}
            {% if variant.id == selected_variant.id %}
              checked
            {% endif %}
          >
          <span class="variant-select__media">
            {%- if variant_image != blank -%}
              <img
                src="{{ variant_image | image_url: width: 160 }}"
                alt="{{ variant_image.alt | escape }}"
                width="80"
                height="100"
                loading="lazy"
              >
            {%- endif -%}
          </span>
          <span class="variant-select__option-text">
            <span class="variant-select__option-title">{{ variant.title }}</span>
            <span class="variant-select__option-meta">
              {{- variant.price | money -}}
              {%- unless variant.available %} &middot; {{ 'products.product.sold_out' | t }}{% endunless -%}
            </span>
          </span>
          <span
            class="variant-select__radio"
            aria-hidden="true"
          ></span>
        </label>
      {%- endfor -%}
    </fieldset>

    <product-form-component
      data-section-id="{{ section_id }}"
      data-product-id="{{ product.id }}"
      on:submit="/handleSubmit"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ selected_variant.id }}"
          {% if selected_variant.available == false %}
            disabled
          {% endif %}
        >
        <input
          type="hidden"
          name="quantity"
          value="{% if selected_variant.quantity_rule.min %}{{ selected_variant.quantity_rule.min }}{% else %}1{% endif %}"
        >
        <div class="variant-select__footer">
          <p class="variant-select__price">{{ selected_variant.price | money }}</p>
          {% render 'add-to-cart-button',
            add_to_cart_text: add_to_cart_text,
            class: 'variant-select__submit add-to-cart-button',
            can_add_to_cart: selected_variant.available,
            show_icon: false,
            product: product
          %}
        </div>
      {%- endform -%}
    </product-form-component>
  </dialog>
</variant-select-component>

{% render 'dialog-styles' %}
{% render 'variant-select-styles' %}
