{%- doc -%}
  Renders a carousel of predictive search results cards

  @param {string} ref - The ref of the slideshow
  @param {object} slides - An array of HTML for the slides to display in the carousel
  @param {number} slide_count - The number of slides to display in the carousel
  @param {object} settings - The block or sections settings from the parent block/section.
  @param {string} [slide_width_max] - The maximum width of the slides in the carousel.

  @example
  {% render 'resource-list-carousel', slides: slides, slide_count: slide_count, settings: block.settings %}
{%- enddoc -%}

{% liquid
  assign slideshow_ref = ref | default: 'resourceListCarousel'

  if settings.section_width == 'page-width'
    assign slideshow_gutters = 'start end'
    assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
    assign adaptive_gutter_style = '--arlc-gutter: max(var(--page-margin), calc((100cqw - min(var(--page-content-width), 100cqw - (var(--page-margin) * 2))) / 2));'
  else
    assign slideshow_gutters = null
    assign gutter_style = '--gutter-slide-width: 0px;'
    assign adaptive_gutter_style = '--arlc-gutter: 0px;'
  endif

  assign show_arrows = false
  if settings.icons_style != 'none'
    assign show_arrows = true
  endif
%}

{% capture slides %}
  {% for item in slides limit: slides.size %}
    {% render 'slideshow-slide'
      index : forloop.index0,
      children : item,
      class : 'resource-list__slide'
    %}
  {% endfor %}
{% endcapture %}

{%- comment -%}
  The number of slides caps the adaptive column count: on a very wide screen the ladder below can
  ask for more columns than there are products, and the cards would shrink to leave empty track at
  the end instead of staying a comfortable size.
{%- endcomment -%}
<div class="resource-list-carousel-viewport" style="{{ gutter_style }} {{ adaptive_gutter_style }} --slide-width-max: {{ slide_width_max | default: '300px' }}; --adaptive-columns-max: {{ slide_count | default: 99 }};{% if settings.adaptive_min_card %} --adaptive-min-card: {{ settings.adaptive_min_card }}px;{% endif %}">
  {% render 'slideshow',
    ref: slideshow_ref,
    class: 'resource-list__carousel',
    slides: slides,
    show_arrows: show_arrows,
    icon_style: settings.icons_style,
    icon_shape: settings.icons_shape,
    auto_hide_controls: false,
    infinite: false,
    initial_slide: 0,
    slide_count: slide_count,
    slideshow_gutters: slideshow_gutters
  %}
</div>

{% stylesheet %}
  .resource-list__carousel {
    --slide-width: 60vw;
    width: 100%;
    position: relative;
    container-type: inline-size;
    container-name: resource-list-carousel;

    .slideshow-control[disabled] {
      display: none;
    }

    .slideshow-control--next {
      margin-inline-start: auto;
    }
  }

  @container resource-list-carousel (max-width: 749px) {
    .resource-list__carousel .resource-list__slide {
      --slide-width: clamp(150px, var(--mobile-card-size, 60cqw), var(--slide-width-max));
    }
  }

  @container resource-list-carousel (min-width: 750px) {
    .resource-list__carousel .resource-list__slide {
      --section-slide-width: calc(
        (100% - (var(--resource-list-column-gap) * (var(--column-count) - 1)) - var(--peek-next-slide-size)) /
          var(--column-count)
      );
      --fallback-slide-width: clamp(150px, var(--mobile-card-size, 60cqw), var(--slide-width-max));
      --slide-width: var(--section-slide-width, var(--fallback-slide-width));
    }
  }

  /* Adaptive mode: the number of cards follows from how wide a card is allowed to get, not from a
     ladder of breakpoints. A ladder has to assume a per-column budget, and the budget is card plus
     gap - with the gap set to 60px the cards came out at 255px and "Add to cart" broke onto three
     lines. Deriving the count from a minimum card width is self-correcting for any gap.

     The peek also goes, so the count that is configured is the count that is visible.

     If `round()` is unavailable the declaration is invalid and `--column-count` keeps the inline
     value the section already sets, which is the configured number - a safe place to land. */
  .resource-list__carousel--adaptive {
    --peek-next-slide-size: 0px;
  }

  @container resource-list-carousel (max-width: 749px) {
    .resource-list__carousel--adaptive .resource-list__slide {
      --slide-width: 100%;
    }
  }

  @container resource-list-carousel (min-width: 750px) {
    /* Defined on slideshow-slides (a descendant of the container-type element, not the
       container itself - self-referential container-query sizing on the container is
       unreliable) so both the track and the individual slide can read the same values:
       the slide inherits them naturally since slideshow-slides is its ancestor, and the
       track needs --arlc-column-count directly to size itself to exactly N columns instead
       of stretching to fill its full-bleed parent.

       Uses a local --arlc-gutter (set above, next to --gutter-slide-width) instead of
       --gutter-slide-width itself: custom properties are re-substituted at each point of
       use, not frozen where declared, and --gutter-slide-width ultimately resolves to
       --util-page-margin-offset (assets/base.css), whose formula divides a bare `%` - fine
       where it's consumed on the element that declares it (e.g. the arrows padding below),
       but wrong here, where the value is inherited down to the much narrower
       .resource-list__slide and its `%` would resolve against the SLIDE's own width instead
       of the track's. cqw doesn't have that problem - it always resolves against the same
       query container regardless of which descendant reads it - so --arlc-gutter mirrors
       --util-page-margin-offset's own formula (same --page-margin/--page-content-width
       tokens, so it stays correct across the narrow/normal/wide page-width setting) with
       `%` swapped for `100cqw`. */
    .resource-list__carousel--adaptive slideshow-slides {
      --arlc-track: calc(100cqw - (2 * var(--arlc-gutter, 0px)));
      --arlc-step: calc(var(--adaptive-min-card, 300px) + var(--resource-list-column-gap));

      --arlc-column-count: clamp(
        1,
        round(down, (var(--arlc-track) + var(--resource-list-column-gap)) / var(--arlc-step), 1),
        var(--adaptive-columns-max, 99)
      );

      --arlc-slide-width: calc(
        (var(--arlc-track) - (var(--resource-list-column-gap) * (var(--arlc-column-count) - 1))) /
          var(--arlc-column-count)
      );
    }

    .resource-list__carousel--adaptive .resource-list__slide {
      --section-slide-width: var(--arlc-slide-width);
    }

    /* The track's own box still stretches to width: 100% of its full-bleed parent, wider
       than the N visible columns + their shared left gutter. The trailing gutter
       (slideshow-slides[gutters*='end'], snippets/slideshow-styles.liquid) reserves real
       padding-inline-end, but that padding sits INSIDE the visible scrollport at rest (it's
       not a clipping boundary) - it only becomes meaningful once scrolled to the very end.
       Since the gap between cards (60px here) is smaller than the gutter (148px), the
       leftover space between "where the whole columns end" and "where the box actually
       ends" is wide enough for the next card to start poking through.

       Tried shrinking the track's own width + zeroing its trailing padding first - that
       gets the math right (content ends exactly at --arlc-gutter from the right edge, by
       construction: count * slide-width + (count - 1) * gap == --arlc-track always), but
       narrowing the actual scrollable element broke native scrollLeft/scrollTo() on load
       (CSS scroll-snap re-settling against the new box produced a nonzero initial scroll
       position, and disabling scroll-snap-type to work around that broke the carousel's
       own next/previous JS scrollTo() calls outright - scrollLeft stopped responding to
       any programmatic scroll).

       Fix instead with clip-path on .resource-list-carousel-viewport (the div this snippet
       renders around the slideshow, full-width and same box as .resource-list__carousel--
       adaptive itself) rather than the scrollable track: purely a paint-time clip, doesn't
       touch slideshow-slides' width/scrollWidth/scrollLeft/snap at all, so none of the above
       breaks. Clips off the trailing --arlc-gutter (minus a hover-effect buffer, capped at
       the actual column gap - see below) from the right edge - exactly the dead space past
       the last visible column, on any viewport/column-count.

       Two things this needs to get right or it re-introduces a smaller peek / a new crop:

       - The right-edge buffer can't be a flat 15px: sections/product-list.liquid supports
         gaps down to 0px (default 8px), and a buffer wider than the actual gap eats into
         where the next card legitimately starts, exposing a sliver of it again. Capping the
         buffer at min(15px, gap) keeps it inside the gap's own dead space.
       - clip-path always clips to the element's own border-box, regardless of the 0 0
         vertical insets below - it doesn't know slideshow-slides (lines 193-203) pairs
         negative margin-block with padding-block specifically so hover scale/lift/shadow can
         paint outside its own layout height. Expanding the clip vertically by that same 16px
         (rather than 0) restores the room those effects need, without affecting the
         horizontal clip this rule exists for.

       Targets .resource-list-carousel-viewport, not .resource-list__carousel--adaptive:
       --adaptive is applied by the section that renders this snippet, one level further OUT
       than anything this file controls, so it's an ANCESTOR of everything below, including
       this div - custom properties only inherit downward, so --arlc-gutter (declared in this
       div's own inline style) isn't visible on that outer ancestor to read back. */
    .resource-list__carousel--adaptive .resource-list-carousel-viewport {
      clip-path: inset(
        -16px max(0px, calc(var(--arlc-gutter, 0px) - min(15px, var(--resource-list-column-gap)))) -16px 0
      );
    }
  }

  .resource-list__carousel slideshow-slides {
    gap: var(--resource-list-column-gap);

    /* Add padding to prevent hover animations from being clipped in slideshow
     15px accommodates:
     - Scale effect (9px on each side from 1.03 scale)
     - Lift effect (4px upward movement)
     - Shadow (15px spread with -5px offset)
     Using 16px for better alignment with our spacing scale */
    margin-block: -16px;
    padding-block: 16px;
  }

  .resource-list__carousel slideshow-arrows {
    padding-inline: var(--util-page-margin-offset);
  }

  .resource-list__carousel .resource-list__slide {
    width: var(--slide-width);
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 0;
  }

  /*
   * Resource list carousels have peeking slides on both sides.
   * We try to kick load them beforehand (they are lazy loaded otherwise).
   */
  .resource-list__carousel
    :is(
      slideshow-slide:has(+ slideshow-slide[aria-hidden='false']),
      slideshow-slide[aria-hidden='false'] + slideshow-slide
    ) {
    content-visibility: auto;

    slideshow-component[actioned] & {
      content-visibility: visible;
    }
  }
{% endstylesheet %}
