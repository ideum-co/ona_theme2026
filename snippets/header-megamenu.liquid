{%- doc -%}
  Desktop mega menu: the whole top level stays visible on the left while the active item's child
  links and featured products fill the rest of the panel.

  Rendered inside the same `<details>` as the mobile drawer, so opening, closing, the hamburger to
  close icon swap and the scroll lock are the drawer's and are not reimplemented here. CSS shows
  this panel from 750px up and the drawer below it, which is why the mobile menu is untouched.

  Featured products come from the first collection child of each top level link - the convention
  the drawer already uses - and their image comes from a metafield, falling back to the product's
  own image.

  @param {object} linklist - The menu to render.
  @param {object} block - The header menu block, for its settings.

  @example
  {% render 'header-megamenu', linklist: block_settings.menu, block: block %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign max_featured = block_settings.megamenu_featured_count | default: 3
  assign image_namespace = block_settings.megamenu_image_namespace | default: 'custom'
  assign image_key = block_settings.megamenu_image_key | default: 'menu_image'
  assign badge_namespace = block_settings.megamenu_badge_namespace | default: 'custom'
  assign badge_key = block_settings.megamenu_badge_key | default: 'menu_badge'
-%}

{%- comment -%}
  While the menu is open the header takes the panel's own colours, whatever the page had set: on
  the home page it is transparent over the hero, and it still has to turn into the panel's colour
  so header and panel read as one surface. That also fixes the logo and the icons, which were
  drawn in the page's dark foreground on top of a dark panel.

  The brightness fallback below is the one `contrast-override` uses when no text colour is set.
{%- endcomment -%}
{%- liquid
  assign megamenu_foreground = block_settings.text_color
  if megamenu_foreground != blank
    assign megamenu_foreground_rgb = megamenu_foreground.rgb
  elsif block_settings.background_color != blank and block_settings.background_color.alpha != 0
    assign background_brightness = block_settings.background_color | color_brightness
    if background_brightness > 128
      assign megamenu_foreground = 'var(--palette-darkest)'
      assign megamenu_foreground_rgb = 'var(--palette-darkest-rgb)'
    else
      assign megamenu_foreground = 'var(--palette-lightest)'
      assign megamenu_foreground_rgb = 'var(--palette-lightest-rgb)'
    endif
  endif
-%}

{%- if megamenu_foreground != blank -%}
  {% style %}
    @media screen and (min-width: 750px) {
      /* The row carries the page's own `color-custom-*` class, so this needs the id and the `:has()`
         to outrank it. Set on the row rather than on each item, so everything inside inherits. */
      #header-component:has(.menu-open) .header__row {
        {%- if block_settings.background_color != blank %}
          background-color: {{ block_settings.background_color }};
          --color-background: {{ block_settings.background_color }};
          --color-background-rgb: {{ block_settings.background_color.rgb }};
        {%- endif %}

        --color: {{ megamenu_foreground }};
        --color-rgb: {{ megamenu_foreground_rgb }};
        --color-foreground: {{ megamenu_foreground }};
        --color-foreground-rgb: {{ megamenu_foreground_rgb }};
        --color-border: {{ megamenu_foreground }};
        --color-border-rgb: {{ megamenu_foreground_rgb }};

        color: {{ megamenu_foreground }};
      }

      /* An image logo cannot be recoloured, so the theme's transparent-header logo takes over.
         Guarded on that container existing: without an inverse logo uploaded the swap would hide
         the logo instead of lightening it. */
      #header-component:has(.menu-open)
        .header-logo:has(.header-logo__transparent-header-image-container) {
        --header-logo-display: none;
        --header-logo-inverse-display: block;
      }
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Same colour class the drawer uses, so the block's Background and Text settings reach this panel
  too - without it the mega menu ignored them and fell back to the page colours.
{%- endcomment -%}
<header-megamenu
  class="header-megamenu{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  ref="megaMenu"
>
  <div class="header-megamenu__panel">
    <ul
      class="header-megamenu__primary list-unstyled"
      ref="primary"
    >
      {%- for link in linklist.links -%}
        <li class="header-megamenu__primary-item">
          <a
            class="header-megamenu__primary-link"
            href="{{ link.url }}"
            data-index="{{ forloop.index0 }}"
            ref="primaryLinks[]"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <div class="header-megamenu__panels">
      {%- for link in linklist.links -%}
        {%- liquid
          assign collection_link = link.links | where: 'type', 'collection_link' | first
          assign featured_collection = collection_link.object
        -%}
        <div
          class="header-megamenu__content"
          data-index="{{ forloop.index0 }}"
          ref="contents[]"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- if link.links.size > 0 and featured_collection == blank -%}
            <ul class="header-megamenu__secondary list-unstyled">
              {%- for child in link.links -%}
                <li>
                  <a
                    class="header-megamenu__secondary-link"
                    href="{{ child.url }}"
                  >
                    {{- child.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if featured_collection.products_count > 0 -%}
            <ul class="header-megamenu__featured list-unstyled">
              {%- for product in featured_collection.products limit: max_featured -%}
                {%- liquid
                  assign image = product.metafields[image_namespace][image_key].value
                  if image == blank
                    assign image = product.featured_media.preview_image
                  endif

                  assign badge = product.metafields[badge_namespace][badge_key].value
                  if badge == blank and product.compare_at_price > product.price
                    assign badge = 'content.product_badge_sale' | t
                  endif
                -%}
                <li class="header-megamenu__featured-item">
                  <a
                    class="header-megamenu__card"
                    href="{{ product.url }}"
                  >
                    <span class="header-megamenu__card-media">
                      {%- if image != blank -%}
                        {{
                          image
                          | image_url: width: 800
                          | image_tag: widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 22vw, 60vw', loading: 'lazy', class: 'header-megamenu__card-image'
                        }}
                      {%- endif -%}
                      {%- if badge != blank -%}
                        <span class="header-megamenu__card-badge">{{ badge }}</span>
                      {%- endif -%}
                    </span>
                    <span class="header-megamenu__card-footer">
                      <span class="header-megamenu__card-title">{{ product.title }}</span>
                      {%- if product.type != blank -%}
                        <span class="header-megamenu__card-type">{{ product.type }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</header-megamenu>

{% stylesheet %}
  /* Below the drawer's breakpoint the mobile drawer is what renders. */
  .header-megamenu {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header-megamenu {
      position: fixed;
      /* `.header` is `contain: layout`, which makes it this fixed panel's containing block, so
         100% is the header's own height: the panel lands exactly on the header's bottom edge
         whatever sits above it - announcement bar, transparent header, sticky or not. A measured
         variable cannot get this right, because it counts the whole header group. */
      inset-block-start: 100%;
      inset-inline: 0;
      z-index: var(--layer-menu-drawer);
      display: block;
      visibility: hidden;
      translate: 0 -100%;
      background-color: var(--color-background);
      color: var(--color-foreground);
      border-block-end: var(--style-border-drawer);
      /* The group height is the distance from the top of the viewport down to the header's bottom,
         which is what is left for the panel once the whole header group is stuck to the top. */
      max-block-size: calc(100dvh - var(--header-group-height, 60px));
      overflow: hidden;
    }

    .menu-open > .header-megamenu {
      visibility: visible;
      translate: 0 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .header-megamenu {
        transition: translate var(--drawer-animation-speed, 0.3s) ease-in-out, visibility
          var(--drawer-animation-speed, 0.3s);
      }
    }

    /* The drawer stays in the DOM for mobile; from here up the mega menu replaces it. */
    .menu-open > .menu-drawer {
      display: none;
    }

    /* The panel slides down from behind the header, so the header's own content still has to sit
       above it during the transition. Lifted item by item rather than by column: `header-row` puts
       the toggle in the right column next to the cart, and the columns are `display: contents` in
       drawer mode. `header-drawer` is skipped because it holds the panel. */
    #header-component:has(.menu-open) .header__column > *:not(header-drawer) {
      position: relative;
      z-index: calc(var(--layer-menu-drawer) + 1);
    }

    /* The toggle lives in the excluded column, lifted on its own so it stays clickable. */
    .menu-drawer-container.menu-open > summary {
      position: relative;
      z-index: calc(var(--layer-menu-drawer) + 1);
    }

    /* The theme hides the close icon from 750px up and keeps the hamburger, because on desktop the
       drawer was never the menu. Now it is, so the swap has to happen here too. Scoped to this
       container, so the mobile behaviour is untouched. */
    .menu-drawer-container.menu-open .header__icon--menu .header-drawer-icon--close {
      display: flex;
    }

    .menu-drawer-container.menu-open .header__icon--menu .header-drawer-icon--open {
      display: none;
    }

    .header-megamenu__panel {
      display: grid;
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr);
      gap: var(--gap-3xl, 3rem);

      padding-block: var(--padding-2xl) var(--padding-5xl);
      padding-inline: var(--util-page-margin, var(--padding-2xl));

      max-block-size: calc(100dvh - var(--header-group-height, 60px));
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .header-megamenu__primary {
      display: grid;
      align-content: start;
      gap: var(--gap-sm);
      margin: 0;
      padding: 0;
    }

    .header-megamenu__primary-link {
      display: block;
      font-size: var(--font-size--2xl);
      text-decoration: none;
      color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
      transition: color var(--animation-speed) var(--animation-easing);
    }

    .header-megamenu__primary-link:is(:hover, :focus-visible),
    .header-megamenu__primary-link[aria-current='true'] {
      color: var(--color-foreground);
    }

    .header-megamenu__content[hidden] {
      display: none;
    }

    .header-megamenu__content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: var(--gap-2xl);
      align-items: start;
    }

    .header-megamenu__secondary {
      display: grid;
      align-content: start;
      gap: var(--gap-sm);
      margin: 0;
      padding: 0;
    }

    .header-megamenu__secondary-link {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
      text-decoration: none;
    }

    .header-megamenu__secondary-link:is(:hover, :focus-visible) {
      color: var(--color-foreground);
    }

    .header-megamenu__featured {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: repeat(var(--header-megamenu-columns, 3), minmax(0, 1fr));
      gap: var(--gap-xl);
      margin: 0;
      padding: 0;
    }

    .header-megamenu__card {
      display: grid;
      gap: var(--gap-sm);
      text-decoration: none;
      color: inherit;
    }

    .header-megamenu__card-media {
      position: relative;
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
    }

    .header-megamenu__card-image {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      display: block;
    }

    .header-megamenu__card-badge {
      position: absolute;
      inset-block-start: var(--padding-sm);
      inset-inline-start: var(--padding-sm);
      padding: var(--padding-2xs) var(--padding-sm);
      background: var(--color-foreground);
      color: var(--color-background);
      font-size: var(--font-size--3xs);
      letter-spacing: var(--letter-spacing-sm);
      text-transform: uppercase;
    }

    .header-megamenu__card-footer {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--gap-sm);
    }

    .header-megamenu__card-type {
      font-size: var(--font-size--xs);
      letter-spacing: var(--letter-spacing-sm);
      text-transform: uppercase;
      opacity: var(--opacity-muted-text);
    }
  }
{% endstylesheet %}
