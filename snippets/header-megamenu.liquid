{%- doc -%}
  Desktop mega menu: the whole top level stays visible on the left while the active item's child
  links and featured products fill the rest of the panel.

  Rendered inside the same `<details>` as the mobile drawer, so opening, closing, the hamburger to
  close icon swap and the scroll lock are the drawer's and are not reimplemented here. CSS shows
  this panel from 750px up and the drawer below it, which is why the mobile menu is untouched.

  Featured products come from the first collection child of each top level link - the convention
  the drawer already uses - and their image comes from a metafield, falling back to the product's
  own image. Card image ratio reads the block's own Image ratio setting (featured_products_
  aspect_ratio), the same one the drawer's own featured products already honor.

  @param {object} linklist - The menu to render.
  @param {object} block - The header menu block, for its settings.
  @param {string} [social] - Pre-rendered social icons HTML, captured by the caller (see
    header-drawer.liquid's own doc comment for why this isn't rendered here directly).

  @example
  {% render 'header-megamenu', linklist: block_settings.menu, block: block, social: social %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign max_featured = block_settings.megamenu_featured_count | default: 3
  assign image_namespace = block_settings.megamenu_image_namespace | default: 'custom'
  assign image_key = block_settings.megamenu_image_key | default: 'menu_image'
  assign badge_namespace = block_settings.megamenu_badge_namespace | default: 'custom'
  assign badge_key = block_settings.megamenu_badge_key | default: 'menu_badge'
  assign card_aspect_ratio = block_settings.featured_products_aspect_ratio | default: '4 / 5'
-%}

{%- comment -%}
  While the menu is open the header gets its own colour state, on top of whatever the page had:
  the theme already swaps the header's colours for sticky and for hover, and this is the same idea
  for the open mega menu. On the home page the header is transparent over the hero, and it still
  has to take a colour so header and panel read as one surface.

  The two Header settings override it; unset, it follows the panel, which is the common case. The
  brightness fallback is the one `contrast-override` uses when no text colour is given, and it also
  decides which logo to show, since an image logo cannot be recoloured.
{%- endcomment -%}
{%- liquid
  assign header_background = block_settings.megamenu_header_background_color
  if header_background == blank
    assign header_background = block_settings.background_color
  endif

  assign header_foreground = block_settings.megamenu_header_text_color
  if header_foreground == blank
    assign header_foreground = block_settings.text_color
  endif

  assign header_logo_is_light = false

  if header_foreground != blank
    assign header_foreground_rgb = header_foreground.rgb
    assign foreground_brightness = header_foreground | color_brightness
    if foreground_brightness > 128
      assign header_logo_is_light = true
    endif
  elsif header_background != blank and header_background.alpha != 0
    assign background_brightness = header_background | color_brightness
    if background_brightness > 128
      assign header_foreground = 'var(--palette-darkest)'
      assign header_foreground_rgb = 'var(--palette-darkest-rgb)'
    else
      assign header_foreground = 'var(--palette-lightest)'
      assign header_foreground_rgb = 'var(--palette-lightest-rgb)'
      assign header_logo_is_light = true
    endif
  endif
-%}

{%- if header_foreground != blank -%}
  {% style %}
    @media screen and (min-width: 750px) {
      {%- if header_background != blank %}
        /* `.header__row` is `background-color: transparent !important` - the header is painted by
           its underlays, and their colours come from an inline style on `#header-component`, so
           this is the only way in. `--closed-underlay-height` is 0 while the header is transparent
           and not sticky, which is why the home page showed the hero straight through. */
        #header-component:has(.menu-open) {
          --closed-underlay-height: 100%;
        }

        /* Set on the underlays and not only on the header: with the menu open the focus is inside
           the header, so the theme's `[data-transparent-background]:focus-within` rule redeclares
           these same variables on the underlay itself. A declaration on the element that consumes
           a custom property beats one inherited from an ancestor, `!important` included, so the
           override has to land on the same element. */
        #header-component:has(.menu-open) :is(.header__underlay-closed, .header__underlay-open) {
          /* stylelint-disable declaration-no-important */
          --color-background-top-row: {{ header_background }} !important;
          --color-background-bottom-row: {{ header_background }} !important;
          --color-submenu: {{ header_background }} !important;
          /* stylelint-enable declaration-no-important */
        }
      {%- endif %}

      /* The row carries the page's own `color-custom-*` class, so this needs the id and the `:has()`
         to outrank it. Set on the row rather than on each item, so everything inside inherits. */
      #header-component:has(.menu-open) .header__row {
        {%- if header_background != blank %}
          --color-background: {{ header_background }};
          --color-background-rgb: {{ header_background.rgb }};
        {%- endif %}

        --color: {{ header_foreground }};
        --color-rgb: {{ header_foreground_rgb }};
        --color-foreground: {{ header_foreground }};
        --color-foreground-rgb: {{ header_foreground_rgb }};
        --color-border: {{ header_foreground }};
        --color-border-rgb: {{ header_foreground_rgb }};

        color: {{ header_foreground }};
      }

      {%- if header_logo_is_light %}
        /* An image logo cannot be recoloured, so the theme's transparent-header logo takes over.
           Guarded on that container existing: without an inverse logo uploaded the swap would hide
           the logo instead of lightening it. */
        #header-component:has(.menu-open)
          .header-logo:has(.header-logo__transparent-header-image-container) {
          --header-logo-display: none;
          --header-logo-inverse-display: block;
        }
      {%- endif %}
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Same colour class the drawer uses, so the block's Background and Text settings reach this panel
  too - without it the mega menu ignored them and fell back to the page colours.
{%- endcomment -%}
<header-megamenu
  class="header-megamenu{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="--header-megamenu-card-aspect-ratio: {{ card_aspect_ratio }};"
  ref="megaMenu"
>
  <div class="header-megamenu__panel">
    {%- comment -%}
      Wraps the primary link list and the social icons together as one column: `.header-
      megamenu__panel` is a 2-column grid (primary column, panels column), and without this
      wrapper the social block below would become a 3rd auto-placed grid item, landing in the
      panels column on row 1 instead of stacking under the links.
    {%- endcomment -%}
    <div class="header-megamenu__primary-column">
      <ul
        class="header-megamenu__primary list-unstyled"
        ref="primary"
      >
        {%- for link in linklist.links -%}
          <li class="header-megamenu__primary-item">
            <a
              class="header-megamenu__primary-link"
              href="{{ link.url }}"
              data-index="{{ forloop.index0 }}"
              ref="primaryLinks[]"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%}
        `social` is pre-rendered HTML, captured via `content_for 'block', type: 'social-links'`
        at the top of _header-menu.liquid and threaded down through header-drawer.liquid: that
        tag only resolves in the file the block itself renders, not from a snippet further down
        the render chain, which is what this file is relative to the block. Configured with its
        own settings in header-group.json rather than reusing this menu block's settings.
        Renders nothing visible (an empty, zero-height wrapper) when every URL on that child
        block is blank.
      {%- endcomment -%}
      <div class="header-megamenu__social">
        {{- social -}}
      </div>
    </div>

    <div class="header-megamenu__panels">
      {%- for link in linklist.links -%}
        {%- liquid
          assign collection_link = link.links | where: 'type', 'collection_link' | first
          assign featured_collection = collection_link.object
        -%}
        <div
          class="header-megamenu__content"
          data-index="{{ forloop.index0 }}"
          ref="contents[]"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- if link.links.size > 0 and featured_collection == blank -%}
            <ul class="header-megamenu__secondary list-unstyled">
              {%- for child in link.links -%}
                <li>
                  <a
                    class="header-megamenu__secondary-link"
                    href="{{ child.url }}"
                  >
                    {{- child.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if featured_collection.products_count > 0 -%}
            <ul class="header-megamenu__featured list-unstyled">
              {%- for product in featured_collection.products limit: max_featured -%}
                {%- liquid
                  assign image = product.metafields[image_namespace][image_key].value
                  if image == blank
                    assign image = product.featured_media.preview_image
                  endif

                  assign badge = product.metafields[badge_namespace][badge_key].value
                  if badge == blank and product.compare_at_price > product.price
                    assign badge = 'content.product_badge_sale' | t
                  endif
                -%}
                <li class="header-megamenu__featured-item">
                  <a
                    class="header-megamenu__card"
                    href="{{ product.url }}"
                  >
                    <span class="header-megamenu__card-media">
                      {%- if image != blank -%}
                        {{
                          image
                          | image_url: width: 800
                          | image_tag: widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 22vw, 60vw', loading: 'lazy', class: 'header-megamenu__card-image'
                        }}
                      {%- endif -%}
                      {%- if badge != blank -%}
                        <span class="header-megamenu__card-badge">{{ badge }}</span>
                      {%- endif -%}
                    </span>
                    <span class="header-megamenu__card-footer">
                      <span class="header-megamenu__card-title">{{ product.title }}</span>
                      {%- if product.type != blank -%}
                        <span class="header-megamenu__card-type">{{ product.type }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</header-megamenu>

{% stylesheet %}
  /* Below the drawer's breakpoint the mobile drawer is what renders. */
  .header-megamenu {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header-megamenu {
      /* `.header` is `display: block` with `contain: layout`, so it is this fixed panel's
         containing block: offset 0 puts the panel on the header's own top edge, at its full width,
         and the margin then drops it by exactly one header so it hangs off the row instead of
         covering it. The header keeps its own row, painted in the panel's colours below. */
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      margin-block-start: var(--header-height, 60px);
      z-index: var(--layer-menu-drawer);
      display: block;
      visibility: hidden;
      translate: 0 -100%;
      background-color: var(--color-background);
      color: var(--color-foreground);
      border-block-end: var(--style-border-drawer);
      /* Everything above the panel is the header itself, since the announcement bars are hidden
         while the menu is open. */
      max-block-size: calc(100dvh - var(--header-height, 60px));
      overflow: hidden;
    }

    .menu-open > .header-megamenu {
      visibility: visible;
      translate: 0 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .header-megamenu {
        transition: translate var(--drawer-animation-speed, 0.3s) ease-in-out, visibility
          var(--drawer-animation-speed, 0.3s);
      }
    }

    /* The drawer stays in the DOM for mobile; from here up the mega menu replaces it. It is hidden
       rather than `display: none`, because `header-drawer.js` closes by waiting on that element's
       animations before removing `open`. With no box there are no animations, the wait resolved in
       a microtask, and `open` was removed before the summary's own default action ran - which then
       toggled it straight back on. That left the details open with the scroll locked and the menu
       unable to reopen. Kept in flow, its transform still transitions and the wait outlasts the
       default action. */
    .menu-open > .menu-drawer {
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
    }

    /* The drawer's backdrop only fades: at opacity 0 it still covers the viewport and swallows the
       next click, so closing the mega menu took a second click to register. */
    .menu-drawer__backdrop {
      pointer-events: none;
    }

    .menu-open > .menu-drawer__backdrop {
      pointer-events: auto;

      /* The backdrop is `position: fixed` inside `.header`, which is `contain: layout` and so its
         containing block: this drops it to the header's bottom edge, the same way the panel is
         dropped. It covered the whole viewport at `--layer-overlay: 16`, and although the header
         paints above it at 19, it still sat on top for hit testing - the logo and the icons were
         visible but not clickable. Below the header it still closes the menu on a click outside. */
      inset-block-start: var(--header-height, 60px);
      block-size: calc(100dvh - var(--header-height, 60px));
    }

    /* The design has the panel starting at the top of the page, so anything else in the header
       group - announcement bars - steps aside while the menu is open. Matched by what the section
       holds rather than by its id, which is generated per store and changes if it is recreated. */
    #header-group:has(.menu-open) > *:not(:has(#header-component)) {
      display: none;
    }

    /* The panel no longer covers the header, but it still slides up behind it when closing, so the
       header's content stays lifted. Lifted item by item rather than by column: `header-row` puts
       the toggle in the right column next to the cart, and the columns are `display: contents` in
       drawer mode. `header-drawer` is skipped because it holds the panel. */
    #header-component:has(.menu-open) .header__column > *:not(header-drawer) {
      position: relative;
      z-index: calc(var(--layer-menu-drawer) + 1);
    }

    /* The toggle lives in the excluded column, lifted on its own so it stays clickable. */
    .menu-drawer-container.menu-open > summary {
      position: relative;
      z-index: calc(var(--layer-menu-drawer) + 1);
    }

    /* The theme hides the close icon from 750px up and keeps the hamburger, because on desktop the
       drawer was never the menu. Now it is, so the swap has to happen here too. Scoped to this
       container, so the mobile behaviour is untouched. */
    .menu-drawer-container.menu-open .header__icon--menu .header-drawer-icon--close {
      display: flex;
    }

    .menu-drawer-container.menu-open .header__icon--menu .header-drawer-icon--open {
      display: none;
    }

    .header-megamenu__panel {
      display: grid;
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr);
      gap: var(--gap-3xl, 3rem);

      padding-block: var(--padding-2xl) var(--padding-5xl);
      padding-inline: var(--util-page-margin, var(--padding-2xl));
      padding-left: 10%;

      max-block-size: calc(100dvh - var(--header-height, 60px));
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .header-megamenu__primary-column {
      display: flex;
      flex-direction: column;
      align-content: start;
      gap: var(--gap-2xl);
      justify-content: space-between;
    }

    .header-megamenu__primary {
      display: grid;
      gap: var(--gap-sm);
      margin: 0;
      padding: 0;
    }

    /* No URLs set still renders social-links' own wrapper div - collapse it out of the column's
       gap so an unconfigured menu looks identical to before this existed. Checked by the absence
       of an icon element rather than :empty: the wrapper always has whitespace text nodes between
       its Liquid tags even with zero configured URLs, and :empty rejects any child node, text
       included, so it never matched. */
    .header-megamenu__social:not(:has(.social-icons__icon-wrapper)) {
      display: none;
    }

    /* social-links.liquid's icon_color setting only sets --color-utilities on its own wrapper -
       footer-utilities.liquid is the only place that consumes it (`.utilities a { color: var(
       --color-utilities, ...) }`), so it did nothing here without a matching consumer. Falls back
       to inherit, not a fixed color, so an unconfigured icon_color keeps picking up whatever
       foreground color already applies to this column (unchanged from before this setting
       existed). */
    .header-megamenu__social a {
      color: var(--color-utilities, inherit);
    }

    .header-megamenu__primary-link {
      display: block;
      font-size: var(--font-size--2xl);
      text-decoration: none;
      color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
      transition: color var(--animation-speed) var(--animation-easing);
    }

    .header-megamenu__primary-link:is(:hover, :focus-visible),
    .header-megamenu__primary-link[aria-current='true'] {
      color: var(--color-foreground);
    }

    .header-megamenu__content[hidden] {
      display: none;
    }

    .header-megamenu__content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: var(--gap-2xl);
      align-items: start;
    }

    .header-megamenu__secondary {
      display: grid;
      align-content: start;
      gap: var(--gap-sm);
      margin: 0;
      padding: 0;
    }

    .header-megamenu__secondary-link {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
      text-decoration: none;
    }

    .header-megamenu__secondary-link:is(:hover, :focus-visible) {
      color: var(--color-foreground);
    }

    .header-megamenu__featured {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: repeat(var(--header-megamenu-columns, 3), minmax(0, 1fr));
      gap: var(--gap-xl);
      margin: 0;
      padding: 0;
    }

    .header-megamenu__card {
      display: grid;
      gap: var(--gap-sm);
      text-decoration: none;
      color: inherit;
    }

    /* aspect-ratio reads the block's own Image ratio setting (--header-megamenu-card-aspect-
       ratio, set above on <header-megamenu>) instead of a hardcoded 1:1 - the mobile drawer's
       featured products already honor that setting via resource-card's image_aspect_ratio, and
       forcing coffee bag photography (tall, not square) into a hardcoded square with cover
       cropped the top and bottom off with no breathing room. Falls back to 4 / 5 (the setting's
       own default) if the custom property is ever unset. */
    .header-megamenu__card-media {
      position: relative;
      display: block;
      aspect-ratio: var(--header-megamenu-card-aspect-ratio, 4 / 5);
      overflow: hidden;
    }

    .header-megamenu__card-image {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      display: block;
    }

    .header-megamenu__card-badge {
      position: absolute;
      inset-block-start: var(--padding-sm);
      inset-inline-start: var(--padding-sm);
      padding: var(--padding-2xs) var(--padding-sm);
      background: var(--color-foreground);
      color: var(--color-background);
      font-size: var(--font-size--3xs);
      letter-spacing: var(--letter-spacing-sm);
      text-transform: uppercase;
    }

    .header-megamenu__card-footer {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--gap-sm);
    }

    .header-megamenu__card-type {
      font-size: var(--font-size--xs);
      letter-spacing: var(--letter-spacing-sm);
      text-transform: uppercase;
      opacity: var(--opacity-muted-text);
    }
  }
{% endstylesheet %}
