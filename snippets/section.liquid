{%- doc -%}
  Renders a wrapper section

  @param {section} section - The section object
  @param {string} children - The children of the section
  @param {string} section_id - The ID of the section
  @param {string} background_color - The background color of the section
{%- enddoc -%}

{% liquid
  assign skip_contrast = false
  if section.settings.background_media != blank and section.settings.background_media != 'none'
    assign skip_contrast = true
  endif
%}
{% render 'contrast-override',
  background_color: background_color,
  section_id: section_id,
  skip_contrast: skip_contrast
%}

<div class="section-background color-custom-{{ section_id }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section_id }}"
  data-testid="ui-test-section"
 
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}

  style="
    --ona-mobile-min-height: {{ section.settings.mobile_min_height | default: 600 }}px;
    --ona-mobile-content-top: {{ section.settings.mobile_content_top | default: 0 }}px;
    {%- if section.settings.mobile_text_scrim and section.settings.background_media != 'none' and section.settings.background_media != blank %}
      {%- assign scrim_color = section.settings.mobile_scrim_color | default: '#470a12' %}
      --ona-mobile-scrim-start: {{ scrim_color }};
      --ona-mobile-scrim-end: {{ scrim_color | color_modify: 'alpha', 0 }};
    {%- endif %}
    {% if section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != '' %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}

    {% if section.settings.section_height != '' %}
     --section-preview-height: 600px;
     {% endif %}
  "
>
  <div class="custom-section-background">
    {% if section.settings.background_media == 'video' %}
      <div class="ona-responsive-background ona-responsive-background--desktop">
        {% render 'background-media',
          background_media: 'video',
          background_video: section.settings.video,
          background_video_position: section.settings.video_position
        %}
      </div>
      <div class="ona-responsive-background ona-responsive-background--mobile">
        {%- comment -%}
          `!= blank`, not `| default:`: the default filter does not recognise a populated video drop
          as present, so it always fell through to the desktop clip - the mobile layer played the
          desktop video even when a mobile one was set. story-video uses this same check for this.
        {%- endcomment -%}
        {% if section.settings.mobile_video != blank %}
          {% render 'background-media',
            background_media: 'video',
            background_video: section.settings.mobile_video,
            background_video_position: section.settings.mobile_video_position
          %}
        {% else %}
          {% render 'background-media',
            background_media: 'video',
            background_video: section.settings.video,
            background_video_position: section.settings.mobile_video_position
          %}
        {% endif %}
      </div>
    {% else %}
      {% render 'background-media',
        background_media: section.settings.background_media,
        background_image: section.settings.background_image,
        background_image_position: section.settings.background_image_position
      %}
    {% endif %}

    {%- comment -%}
      A mobile-only scrim behind the content: on a phone the text stacks over the media, and a light
      video leaves light type unreadable. Last in the background so it sits over the video; the
      content keeps its own stacking layer above it. Hidden on desktop, where the two sit side by
      side and no scrim is needed.
    {%- endcomment -%}
    {%- if section.settings.mobile_text_scrim and section.settings.background_media != 'none' and section.settings.background_media != blank -%}
      <div class="ona-mobile-scrim" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div
    class="border-style custom-section-content{% if section.settings.limit_content_width %} custom-section-content--limited{% endif %}"
    style="
      {% render 'border-override', settings: section.settings %}
      {% if section.settings.limit_content_width %}
        --custom-section-content-max-width: {{ section.settings.max_width }}px;
      {% endif %}
    "
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      {{ children }}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(#header-group > .header-section > #header-component[transparent]):not(
      :has(#header-group > .header-section + .shopify-section)
    )
    #MainContent
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
  }

  /* Desktop lays the media and the text side by side, so no scrim. */
  .ona-mobile-scrim {
    display: none;
  }

  .ona-responsive-background--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ona-responsive-background--desktop { display: none; }
    .ona-responsive-background--mobile { display: block; }
    .section:has(.ona-responsive-background--mobile) {
      min-height: var(--ona-mobile-min-height);
    }
    .section:has(.ona-responsive-background--mobile) .section-content-wrapper {
      padding-block-start: var(--ona-mobile-content-top);
    }

    /* Darkest at the bottom, gone by the middle, so the lower text reads over a light video and the
       top of the section stays clear. Fades to the same colour at zero alpha (not `transparent`) to
       avoid the grey wash browsers interpolate through a straight `transparent` keyword. */
    .ona-mobile-scrim {
      display: block;
      position: absolute;
      inset: 0;
      z-index: var(--layer-base);
      pointer-events: none;
      background: linear-gradient(
        to top,
        var(--ona-mobile-scrim-start, #470a12) 0%,
        var(--ona-mobile-scrim-end, rgb(71 10 18 / 0)) 55%
      );
    }
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }

  .custom-section-content--limited {
    inline-size: 100%;
    max-inline-size: var(--custom-section-content-max-width, 1280px);
    margin-inline: auto;
  }
{% endstylesheet %}
