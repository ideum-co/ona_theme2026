{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Keep variant controls aligned when either configured card metafield is empty. */
  .product-card .product-metafield-text--empty {
    display: block;
    visibility: hidden;
    min-height: 1lh;
  }

  .product-card .product-title-link,
  .product-card .product-title-link .text-block {
    min-width: 0;
    max-width: 100%;
  }

  .product-card .product-title-link .text-block > * {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }


  /* Keep purchase actions on the same baseline across a product grid. */
  :is(.product-grid__item, .resource-list__item) .product-card__content {
    height: 100%;
  }

  /* The picker block is still present for single-variant products, but it
     reserves the same vertical slot without displaying a disabled selector. */
  .product-card .product-card__variant-placeholder {
    block-size: 64px;
    inline-size: 100%;
    visibility: hidden;
    pointer-events: none;
  }

  /*
    Product list / collection cards: reserve consistent text slots instead of
    pushing the action row to the bottom of a carousel slide. The previous
    margin-block-start:auto produced a large empty gap between picker and CTA.
  */
  :is(.product-grid__item, .resource-list__item) .product-card .product-title-link .text-block {
    min-block-size: 2lh;
  }

  :is(.product-grid__item, .resource-list__item) .product-card .product-title-link .text-block > * {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    white-space: normal;
    overflow: hidden;
  }

  :is(.product-grid__item, .resource-list__item) .product-card .product-metafield-text {
    min-block-size: 1lh;
  }

  :is(.product-grid__item, .resource-list__item) .product-card .product-metafield-text[data-metafield-key='tastes_like'] {
    min-block-size: 2lh;
  }

  :is(.product-grid__item, .resource-list__item) .product-card .product-metafield-text__value {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* Match the space used by a real dropdown even if a product has only its
     default variant. The empty slot is inert and hidden from accessibility. */
  :is(.product-grid__item, .resource-list__item) .product-card .product-card__variant-placeholder {
    block-size: 64px;
  }

  /* Carousel slides can be as tall as their neighbours, but do not stretch
     the card internals to fill that entire height: no artificial CTA gap. */
  .resource-list__carousel .resource-list__item .product-card,
  .resource-list__carousel .resource-list__item .product-card__content {
    height: auto;
  }

  /* Homepage mixes tall coffee bags and short bundle imagery. Give every
     gallery the same portrait canvas so card copy starts at the same baseline.
     Contain keeps the full bundle artwork visible inside that common frame. */
  .ui-test-product-list .product-card .card-gallery {
    --gallery-aspect-ratio: 4 / 5 !important;
    width: 100%;
  }

  .ui-test-product-list .product-card .card-gallery .product-media-container {
    --product-media-fit: contain !important;
  }

  /* An absent promo tag, roast, or tasting note must not collapse its slot. */
  .ui-test-product-list .product-card .ona-pdp-tags {
    min-block-size: 1lh;
  }

  .ui-test-product-list .product-card .product-metafield-text--empty {
    min-block-size: 1lh;
  }

  .ui-test-product-list .product-card .product-metafield-text--empty[data-metafield-key='tastes_like'] {
    min-block-size: 2lh;
  }

  /* Consistent action-row height with either one or two visible buttons. */
  .product-card .group-block-content:has(> .buy-buttons-block) {
    min-block-size: 48px;
    align-items: stretch;
  }

  .product-card .group-block-content:has(> .buy-buttons-block) > .buy-buttons-block {
    min-width: 0;
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
