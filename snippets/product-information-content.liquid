{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {product} product - Product object
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} [resolved_background_color] - Background color already resolved by the caller
    (e.g. a per-product metafield in product-information.liquid). Defaults to
    settings.background_color when not passed, so featured-product-information's
    unmodified call keeps its existing static-only behaviour.
  @param {string} [resolved_text_color] - Text color companion to resolved_background_color,
    same default-to-settings behaviour.
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks
  @param {boolean} [emit_breadcrumb_schema] - Explicit opt-in for the BreadcrumbList JSON-LD
    below. Deliberately NOT inferred from show_breadcrumbs: featured-product-information.liquid's
    schema defines none of the breadcrumb_* settings this file reads, so on that caller `settings`
    is the section's own (breadcrumb-less) settings object, and show_breadcrumbs's own nil-coalesce
    (see below) makes it true anyway -- rendering a visible trail with an empty root label today
    (pre-existing, not introduced here) and would emit invalid structured data (an empty "name")
    if this schema inferred its gate the same way. product-information.liquid passes true because
    its settings genuinely have breadcrumb_root_label etc.; featured-product-information.liquid
    does not pass this at all, so the schema stays off there even though the visible list still
    renders with its existing (separately tracked) empty-root-label defect. Codex, PR #272.

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product: product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  assign show_breadcrumbs = settings.show_breadcrumbs
  if show_breadcrumbs == nil
    assign show_breadcrumbs = true
  endif

  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank and settings.breadcrumb_show_collection
    for product_collection in product.collections
      unless product_collection.handle == 'all'
        assign breadcrumb_collection = product_collection
        break
      endunless
    endfor
  endif

  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product.media.size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

{% liquid
  assign effective_background_color = resolved_background_color | default: settings.background_color
  assign effective_text_color = resolved_text_color | default: settings.text_color

  # True only when the caller resolved a per-product color that differs from the
  # section's own static setting - i.e. product-information.liquid found a metafield.
  # Drives the breadcrumb colors below: a per-product background needs breadcrumb text
  # that contrasts against it too, not whatever fixed color the static background was
  # tuned for.
  assign using_resolved_product_color = false
  if resolved_background_color != blank and resolved_background_color != settings.background_color
    assign using_resolved_product_color = true
  endif

  # contrast-override itself supports a text-only path (no background), so this must
  # not require a background to fire - a text_color-only override would otherwise
  # silently do nothing, which is exactly the gap Codex's review caught here.
  assign has_resolved_color = false
  if effective_background_color != blank or effective_text_color != blank
    assign has_resolved_color = true
  endif

  if has_resolved_color
    render 'contrast-override', background_color: effective_background_color, text_color: effective_text_color, section_id: section_id
  endif
%}

<div
  class="section-background{% if has_resolved_color %} color-custom-{{ section_id }}{% endif %}"
></div>
<div
  class="product-information__viewport"
  style="
    --product-information-max-width: {{ settings.layout_max_width | default: 1360 }}px;
    --product-information-media-width: {{ settings.media_column_width | default: 60 }}%;
  "
>
{% if show_breadcrumbs %}
  <div
    class="product-information__breadcrumb-row section section--{{ content_width }} spacing-style{% if has_resolved_color %} color-custom-{{ section_id }}{% endif %} relative"
    style="
      --padding-block-start: {{ settings.breadcrumb_padding_top }}px;
      --padding-block-end: {{ settings.breadcrumb_padding_bottom }}px;
      --product-breadcrumb-gap: {{ settings.breadcrumb_gap }}px;
      --product-breadcrumb-font-size: {{ settings.breadcrumb_font_size }}px;
      --product-breadcrumb-font-size-mobile: {{ settings.breadcrumb_font_size_mobile }}px;
      {% if using_resolved_product_color %}
        --product-breadcrumb-text-color: var(--color-foreground, currentcolor);
        --product-breadcrumb-link-color: var(--color-foreground, currentcolor);
      {% else %}
        --product-breadcrumb-text-color: {{ settings.breadcrumb_text_color | default: 'currentcolor' }};
        --product-breadcrumb-link-color: {{ settings.breadcrumb_link_color | default: settings.breadcrumb_text_color | default: 'currentcolor' }};
      {% endif %}
    "
  >
    <nav
      class="product-information__breadcrumbs"
      aria-label="Breadcrumb"
    >
      <ol class="product-information__breadcrumb-list list-unstyled">
        <li>
          <a href="{{ routes.all_products_collection_url }}">
            {{- settings.breadcrumb_root_label | escape -}}
          </a>
        </li>
        {% if settings.breadcrumb_show_collection and breadcrumb_collection != blank %}
          <li class="product-information__breadcrumb-separator" aria-hidden="true">
            {{- settings.breadcrumb_separator | escape -}}
          </li>
          <li>
            <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a>
          </li>
        {% endif %}
        <li class="product-information__breadcrumb-separator" aria-hidden="true">
          {{- settings.breadcrumb_separator | escape -}}
        </li>
        <li aria-current="page">{{ product.title | escape }}</li>
      </ol>
    </nav>
  </div>

  {%- comment -%}
    BreadcrumbList mirrors the &lt;ol&gt; above item for item -- same root/collection/product
    sequence, same collection-presence condition (settings.breadcrumb_show_collection and
    breadcrumb_collection != blank), so the schema can never list a trail the visitor doesn't
    actually see. position is 1-based in display order; the "all products" root is always
    position 1, the current product is always last.

    Sitting inside the same {% if show_breadcrumbs %} guard as the visible &lt;ol&gt; (not a
    separate condition) is deliberate: show_breadcrumbs is a per-section visibility setting, and
    the schema inheriting it is correct coupling, not a gap -- unlike the collection FAQPage
    block (sections/main-collection.liquid), which reads a setting from templates/collection.json
    this file has no access to and needs tests/collection-faqs-section.test.mjs to pin instead.
    Here the setting and the schema live in the same file, so no separate guard test is needed.

    This snippet is shared by sections/product-information.liquid and
    sections/featured-product-information.liquid. Checked every templates/product*.json file
    before writing this (not just product.json and product.merch.json by name -- a product
    template split by type is coming, and a hardcoded pair would stop protecting anything the day
    a new one landed): each references product-information exactly once, and none reference
    featured-product-information at all -- so there is no page today where this snippet renders
    twice and emits two BreadcrumbList nodes. That is a fact about the current templates, not a
    property of
    this file, and would need re-checking if a template is added that uses both sections together.

    Escaping matches blocks/product-faqs.liquid and sections/main-collection.liquid, including the
    `| replace: '</', '<\/'` after `| json` -- see product-faqs.liquid's comment for why it's
    defense-in-depth rather than a required fix on this platform (Shopify's `json` filter already
    escapes `<` as `<` before replace runs, so no literal `<` ever reaches a product or
    collection title containing "</script>").
  {%- endcomment -%}
  {%- if emit_breadcrumb_schema -%}
    {%- capture breadcrumb_list_items -%}
      {%- assign breadcrumb_position = 1 -%}
      {%- assign root_url = request.origin | append: routes.all_products_collection_url | json | replace: '</', '<\/' -%}
      {%- assign root_name = settings.breadcrumb_root_label | json | replace: '</', '<\/' -%}
      {"@type":"ListItem","position":{{ breadcrumb_position }},"name":{{ root_name }},"item":{{ root_url }}}
      {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
      {%- if settings.breadcrumb_show_collection and breadcrumb_collection != blank -%}
        {%- assign collection_url = request.origin | append: breadcrumb_collection.url | json | replace: '</', '<\/' -%}
        {%- assign collection_name = breadcrumb_collection.title | json | replace: '</', '<\/' -%}
        ,{"@type":"ListItem","position":{{ breadcrumb_position }},"name":{{ collection_name }},"item":{{ collection_url }}}
        {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
      {%- endif -%}
      {%- assign product_url = request.origin | append: product.url | json | replace: '</', '<\/' -%}
      {%- assign product_name = product.title | json | replace: '</', '<\/' -%}
      ,{"@type":"ListItem","position":{{ breadcrumb_position }},"name":{{ product_name }},"item":{{ product_url }}}
    {%- endcapture -%}

    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{{ breadcrumb_list_items | strip }}]}
    </script>
  {%- endif -%}
{% endif %}
<div
  class="product-information section section--{{ content_width }} spacing-style{% if show_breadcrumbs %} disable-section-top-offset{% endif %}{% if has_resolved_color %} color-custom-{{ section_id }}{% endif %} relative"
  style="
    {% render 'spacing-style', settings: settings %}
    --gap: {{ settings.gap }}px;
  "
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <product-component
    class="{{ product_grid_class }}"
    data-product-grid-content
    {% # theme-check-disable UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
    {% # theme-check-enable UnknownFilter %}
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ product_details }}
      {% endif %}
    {% endfor %}
  </product-component>

  {{ additional_blocks }}
</div>
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  .product-information__breadcrumbs {
    min-width: 0;
    position: relative;
    z-index: var(--layer-raised);
    display: block;
    color: var(--product-breadcrumb-text-color);
    font-size: var(--product-breadcrumb-font-size);
    line-height: 1.4;
  }

  .product-information__breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--product-breadcrumb-gap);
    margin: 0;
    padding: 0;
  }

  .product-information__breadcrumbs a {
    color: var(--product-breadcrumb-link-color);
    text-decoration: none;
  }

  .product-information__breadcrumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-information__breadcrumb-separator {
    opacity: 0.7;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__breadcrumbs {
      font-size: var(--product-breadcrumb-font-size-mobile);
    }

    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__viewport {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      width: min(100%, var(--product-information-max-width));
      height: 100vh;
      height: 100svh;
      margin-inline: auto;
      overflow: hidden;
    }

    .product-information__breadcrumb-row {
      flex: 0 0 auto;
    }

    .product-information__viewport > .product-information {
      flex: 1 1 auto;
      min-height: 0;
    }

    .product-information__grid {
      grid-column: 2;
      height: 100%;
      min-height: 0;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns:
          minmax(0, var(--product-information-media-width))
          minmax(0, calc(100% - var(--product-information-media-width)));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns:
          minmax(0, calc(100% - var(--product-information-media-width)))
          minmax(0, var(--product-information-media-width));

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    .product-information__media,
    .product-information__media media-gallery,
    .product-information__media slideshow-component,
    .product-information__media slideshow-container,
    .product-information__media slideshow-slide {
      min-height: 0;
      height: 100%;
    }

    .product-information__grid:not(.product-information--media-none) > .product-details {
      align-self: stretch;
      min-height: 0;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      /* Keep independent scrolling without displaying a scrollbar. */
      scrollbar-width: none;
      -ms-overflow-style: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .product-information__media .product-media-container:not(.dialog-zoomed-gallery *) {
      height: 100%;
      max-height: 100%;
      aspect-ratio: auto;
    }

    .product-information__media
      .product-media-container:not(.dialog-zoomed-gallery *)
      :is(img, video, iframe, .deferred-media__poster-image) {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .product-information__media .product-media-container:not(.dialog-zoomed-gallery *) model-viewer {
      width: 100%;
      height: 100%;
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    --details-max-width: var(--sidebar-width);
    max-width: var(--details-max-width);
  }

  @media screen and (min-width: 1600px) {
    .product-information__grid--limit-details .product-details > .group-block {
      --details-max-width: 32rem;
    }
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }
{% endstylesheet %}
