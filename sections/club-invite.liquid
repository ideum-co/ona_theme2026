{%- liquid
  # The level is a setting so the page keeps one heading outline, but only h1 to h6 pass
  # through - anything else would put an arbitrary tag name straight from a setting.
  assign heading_tag = section.settings.heading_tag | default: 'h3'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6'
    assign heading_tag = 'h3'
  endunless
  # Ends the size chain: an explicit px value wins, then the typography preset, then the
  # size that belongs to the chosen level. It has to be published as a variable because a
  # class rule outranks the theme's `h3` selector, and an invalid var() resets to inherit
  # rather than falling through to it.
  assign heading_level_size = '--font-' | append: heading_tag | append: '--size'
  assign settings = section.settings
  assign body_preset = settings.body_type_preset | default: 'custom'
  assign has_media = false
  if settings.background_media == 'video' and settings.background_video != blank
    assign has_media = true
  elsif settings.background_media == 'image' and settings.background_image != blank
    assign has_media = true
  endif
-%}

<div
  class="club-invite spacing-style"
  style="
    --section-heading-level-size: var({{ heading_level_size }});
    --club-invite-color: {{ settings.text_color }};
    --club-invite-overlay: rgba({{ settings.overlay_color.rgb }} / {{ settings.overlay_opacity | divided_by: 100.0 }});
    --club-invite-min-height: {{ settings.section_height }};
    --club-invite-button-background: {{ settings.button_background }};
    --club-invite-button-color: {{ settings.button_text }};
    --club-invite-body-width: {{ settings.body_width | default: '100%' }};
    --club-invite-body-color: {{ settings.body_text_color | default: settings.text_color }};
    --club-invite-body-alignment: {{ settings.body_alignment | default: 'center' }};
    {%- if settings.body_max_width == 'none' %}
      --club-invite-body-max-width: 100%;
    {%- else %}
      --club-invite-body-max-width: var(--max-width--body-{{ settings.body_max_width | default: 'normal' }});
    {%- endif %}
    {%- render 'spacing-style', settings: settings %}
  "
  {{ section.shopify_attributes }}
>
  {%- if has_media -%}
    <div class="club-invite__media">
      {%- render 'background-media',
        background_media: settings.background_media,
        background_video: settings.background_video,
        background_video_position: 'cover',
        background_image: settings.background_image,
        background_image_position: 'cover',
        section: section
      -%}
    </div>
  {%- endif -%}

  <div
    class="club-invite__overlay"
    aria-hidden="true"
  ></div>

  <div class="club-invite__content">
    <div class="club-invite__lockup">
      {%- if settings.badge != blank -%}
        {{
          settings.badge
          | image_url: width: 400
          | image_tag: widths: '120, 200, 300, 400', sizes: '160px', loading: 'lazy', class: 'club-invite__badge'
        }}
      {%- endif -%}

      {%- if settings.heading != blank -%}
        <{{ heading_tag }}
      class="club-invite__heading"
      style="{%- render 'typography-style', settings: section.settings, type: 'heading' -%}"
    >{{ settings.heading }}</{{ heading_tag }}>
      {%- endif -%}
    </div>

    {%- if settings.body != blank -%}
      <div
        class="club-invite__body text-block rte {{ body_preset }}{% if body_preset == 'custom' %} custom-typography custom-font-size{% endif %}"
        style="{%- render 'club-invite-typography-style', settings: settings, prefix: 'body', type: 'body' -%}"
      >{{ settings.body }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="club-invite__features">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <li
              class="club-invite__feature"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if settings.button_label != blank -%}
      <a
        class="button club-invite__button"
        {% if settings.button_link != blank %}
          href="{{ settings.button_link }}"
        {% endif %}
      >
        {{- settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .club-invite {
    position: relative;
    display: grid;
    align-items: center;
    justify-items: center;
    min-block-size: var(--club-invite-min-height, 80svh);
    padding-inline: var(--page-margin, 1rem);
    color: var(--club-invite-color, var(--color-background));
    overflow: hidden;
    isolation: isolate;
  }

  .club-invite__media,
  .club-invite__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .club-invite__media :is(img, video) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .club-invite__overlay {
    background: var(--club-invite-overlay);
  }

  .club-invite__content {
    display: grid;
    justify-items: center;
    gap: var(--gap-xl);
    text-align: center;
    max-inline-size: 46rem;
  }

  /* The badge sits beside the heading and tucks under it, as in the design. */
  .club-invite__lockup {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .club-invite__badge {
    inline-size: clamp(5rem, 10vw, 8rem);
    block-size: auto;
    margin-inline-end: -1.5rem;
    flex: none;
  }

  .club-invite__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--club-invite-heading-size, var(--font-size, var(--section-heading-level-size)));
    font-weight: var(--font-heading--weight);
  }

  .club-invite__body {
    display: grid;
    gap: var(--gap-sm);
    inline-size: var(--club-invite-body-width, 100%);
    max-inline-size: min(100%, var(--club-invite-body-max-width, var(--max-width--body-normal)));
    color: var(--club-invite-body-color, currentcolor);
    text-align: var(--club-invite-body-alignment, center);
  }

  .club-invite__body :is(p, ul, ol) {
    margin: 0;
    color: inherit;
    text-align: inherit;
  }

  .club-invite__features {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--gap-lg);
    margin: 0;
    padding: var(--padding-sm) var(--padding-2xl);
    list-style: none;
    border: 1px solid currentcolor;
    border-radius: 999px;
    font-size: var(--font-size--sm);
  }

  /* An em dash between items, drawn rather than typed so it never lands at the end of a wrap. */
  .club-invite__feature + .club-invite__feature::before {
    content: '';
    display: inline-block;
    inline-size: 1.5rem;
    block-size: 1px;
    margin-inline-end: var(--gap-lg);
    vertical-align: middle;
    background: currentcolor;
  }

  .club-invite__button.button {
    --button-background-color: var(--club-invite-button-background);
    --button-color: var(--club-invite-button-color);

    justify-content: center;
  }
{% endstylesheet %}

