      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f2e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#500a14"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#8c1238"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#f5f2e8"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border",
      "default": "#8c1238"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
