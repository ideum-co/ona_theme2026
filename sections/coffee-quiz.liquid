{%- comment -%}
  Coffee recommendation quiz: a modal opened by any link pointing at `#coffee-quiz`, so the trigger
  can be an ordinary button block anywhere on the page - the Media with text section, for instance.

  Questions and matches are blocks, so both the wording and the recommendation are edited in the
  theme editor rather than in this file.

  Each option can carry a tag. Answers add up per tag, and the match whose tag scores highest wins;
  the first match block is the fallback when nothing scores.
{%- endcomment -%}

{%- liquid
  assign settings = section.settings
  assign questions = section.blocks | where: 'type', 'question'
  assign matches = section.blocks | where: 'type', 'match'
-%}

{%- capture quiz_data -%}
{
  "labels": {
    "step": {{ settings.step_label | json }},
    "next": {{ settings.next_label | json }},
    "last": {{ settings.last_label | json }},
    "addToCart": {{ settings.add_to_cart_label | json }},
    "subscribe": {{ settings.subscribe_label | json }}
  },
  "revealMs": {{ settings.reveal_duration | times: 1000 }},
  "questions": [
    {%- for block in questions -%}
      {
        "heading": {{ block.settings.heading | json }},
        "subtext": {{ block.settings.subtext | json }},
        "options": [
          {%- assign lines = block.settings.options | newline_to_br | split: '<br />' -%}
          {%- assign option_index = 0 -%}
          {%- for line in lines -%}
            {%- assign trimmed = line | strip -%}
            {%- if trimmed != blank -%}
              {%- if option_index > 0 -%},{%- endif -%}
              {%- assign parts = trimmed | split: '|' -%}
              {%- assign option_tag = parts[1] | strip -%}
              {
                "label": {{ parts[0] | strip | json }},
                "tag": {{ option_tag | json }}
              }
              {%- assign option_index = option_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "matches": [
    {%- for block in matches -%}
      {%- liquid
        assign match_product = block.settings.product
        assign match_variant = match_product.selected_or_first_available_variant

        assign match_image = block.settings.image
        if match_image == blank
          assign match_image = match_product.featured_media.preview_image
        endif

        assign match_title = block.settings.title
        if match_title == blank
          assign match_title = match_product.title
        endif

        assign match_image_url = ''
        if match_image != blank
          assign match_image_url = match_image | image_url: width: 800
        endif
      -%}
      {
        "tag": {{ block.settings.tag | json }},
        "title": {{ match_title | json }},
        "url": {{ match_product.url | json }},
        "variantId": {{ match_variant.id | default: 0 | json }},
        "available": {{ match_variant.available | default: false | json }},
        "image": {{ match_image_url | json }},
        "description": {{ block.settings.description | json }},
        "reasons": [
          {%- assign reason_lines = block.settings.reasons | newline_to_br | split: '<br />' -%}
          {%- assign reason_index = 0 -%}
          {%- for line in reason_lines -%}
            {%- assign trimmed = line | strip -%}
            {%- if trimmed != blank -%}
              {%- if reason_index > 0 -%},{%- endif -%}
              {{ trimmed | json }}
              {%- assign reason_index = reason_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
{%- endcapture -%}

<script
  src="{{ 'coffee-quiz.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<coffee-quiz
  class="coffee-quiz"
  id="coffee-quiz"
  hidden
  style="
    --coffee-quiz-background: {{ settings.background_color }};
    --coffee-quiz-color: {{ settings.text_color }};
    --coffee-quiz-accent-background: {{ settings.accent_background }};
    --coffee-quiz-accent-color: {{ settings.accent_color }};
  "
  {{ section.shopify_attributes }}
>
  <script type="application/json" ref="data">{{ quiz_data }}</script>

  <div class="coffee-quiz__overlay" on:click="/close"></div>

  <div
    class="coffee-quiz__modal"
    role="dialog"
    aria-modal="true"
    aria-label="{{ settings.title | escape }}"
    ref="modal"
  >
    <div class="coffee-quiz__header">
      <p class="coffee-quiz__title">{{ settings.title }}</p>
      <button
        type="button"
        class="coffee-quiz__close"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
        on:click="/close"
        ref="closeButton"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M1 1L19 19M19 1L1 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="coffee-quiz__body" ref="body"></div>

    <div class="coffee-quiz__footer" ref="footer">
      <button
        type="button"
        class="coffee-quiz__next"
        on:click="/next"
        ref="nextButton"
        disabled
      >
        <span ref="nextLabel">{{ settings.next_label }}</span>
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
          <path d="M11 1L17 7L11 13M17 7H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {%- comment -%}
        The bag is both the corner mark on a question and the unit the loader repeats, so it is
        rendered once here and cloned by the component rather than living twice in the markup.
      {%- endcomment -%}
      <span class="coffee-quiz__bag" ref="bag" aria-hidden="true">
        {%- if settings.bag_svg != blank -%}
          {%- render 'svg-without-styles', svg: settings.bag_svg -%}
        {%- else -%}
          <svg width="72" height="88" viewBox="0 0 72 88" fill="none">
            <path d="M10 30 L14 84 H58 L62 30 Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M10 30 L4 20 H68 L62 30" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
            <path d="M20 20 C20 8, 52 8, 52 20" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M30 44 L30 60 M36 42 L36 62 M42 44 L42 60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        {%- endif -%}
      </span>
    </div>
  </div>

  {%- comment -%}
    The templates below are the shapes the component clones for each step, so the copy stays in
    Liquid - translatable and editable - and the component only fills in the data.
  {%- endcomment -%}
  <template ref="questionTemplate">
    <div class="coffee-quiz__step">
      <p class="coffee-quiz__eyebrow" data-step-label></p>
      <h2 class="coffee-quiz__question" data-heading></h2>
      <p class="coffee-quiz__subtext" data-subtext></p>
      <div class="coffee-quiz__options" data-options></div>
    </div>
  </template>

  <template ref="revealTemplate">
    <div class="coffee-quiz__reveal">
      <p class="coffee-quiz__reveal-heading">{{ settings.reveal_heading }}</p>
      <div class="coffee-quiz__reveal-bags" data-bags></div>
    </div>
  </template>

  <template ref="resultTemplate">
    <div class="coffee-quiz__result">
      <h2 class="coffee-quiz__question coffee-quiz__result-heading">{{ settings.result_heading }}</h2>
      <img class="coffee-quiz__result-image" data-image alt="" width="800" height="800" loading="lazy">
      <p class="coffee-quiz__result-description" data-description></p>
      {%- if settings.reasons_label != blank -%}
        <p class="coffee-quiz__reasons-label">{{ settings.reasons_label }}</p>
      {%- endif -%}
      <ul class="coffee-quiz__reasons list-unstyled" data-reasons></ul>

      <div class="coffee-quiz__actions">
        <form method="post" action="{{ routes.cart_add_url }}" data-add-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" data-variant-id>
          <button type="submit" class="coffee-quiz__action" data-add-button></button>
        </form>
        <a class="coffee-quiz__action" data-subscribe></a>
      </div>

      {%- if settings.explore_label != blank -%}
        <p class="coffee-quiz__explore">
          {%- if settings.explore_prompt != blank -%}
            <span>{{ settings.explore_prompt }}</span>
          {%- endif -%}
          <a
            class="coffee-quiz__action"
            {% if settings.explore_link != blank %}
              href="{{ settings.explore_link }}"
            {% endif %}
          >
            {{- settings.explore_label -}}
          </a>
        </p>
      {%- endif -%}
    </div>
  </template>
</coffee-quiz>

{% stylesheet %}
  .coffee-quiz {
    position: fixed;
    inset: 0;
    z-index: var(--layer-modal, 1000);
    display: grid;
    place-items: center;
    padding: var(--padding-2xl, 1.5rem);
  }

  .coffee-quiz[hidden] {
    display: none;
  }

  .coffee-quiz__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--opacity-50, 0.5));
  }

  .coffee-quiz__modal {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--gap-2xl, 1.5rem);
    inline-size: min(100%, 68rem);
    max-block-size: min(100%, 56rem);
    padding: var(--padding-5xl, 3rem);
    border: 1px solid var(--coffee-quiz-color);
    background: var(--coffee-quiz-background);
    color: var(--coffee-quiz-color);
    overflow-y: auto;
  }

  .coffee-quiz__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--gap-xl, 1.25rem);
  }

  .coffee-quiz__title {
    margin: 0;
  }

  .coffee-quiz__close {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: currentcolor;
    cursor: pointer;
  }

  .coffee-quiz__eyebrow {
    margin: 0 0 var(--gap-xs, 0.5rem);
  }

  .coffee-quiz__question {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--3xl, 2rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.15;
  }

  .coffee-quiz__subtext:empty {
    display: none;
  }

  /* The options wrap into as many columns as fit, so a question with three answers and one with
     seven both read as a tidy block without a per-question setting. */
  .coffee-quiz__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--gap-lg, 1rem);
    margin-block-start: var(--gap-4xl, 3rem);
  }

  .coffee-quiz__option {
    padding: var(--padding-xl, 1.25rem);
    border: 1px solid var(--coffee-quiz-color);
    border-radius: 0;
    background: transparent;
    color: currentcolor;
    font-size: inherit;
    cursor: pointer;
  }

  .coffee-quiz__option[aria-pressed='true'] {
    background: var(--coffee-quiz-color);
    color: var(--coffee-quiz-background);
  }

  .coffee-quiz__footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--gap-xl, 1.25rem);
  }

  .coffee-quiz__next {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-lg, 1rem);
    padding-block: 10px;
    padding-inline: var(--padding-4xl, 2rem);
    border: 0;
    border-radius: 0;
    background: var(--coffee-quiz-accent-background);
    color: var(--coffee-quiz-accent-color);
    font-size: inherit;
    cursor: pointer;
  }

  .coffee-quiz__next[disabled] {
    opacity: var(--opacity-50, 0.5);
    cursor: not-allowed;
  }

  .coffee-quiz__bag svg {
    display: block;
    block-size: 5.5rem;
    inline-size: auto;
  }

  .coffee-quiz__reveal {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--gap-6xl, 4rem);
    block-size: 100%;
    text-align: center;
  }

  .coffee-quiz__reveal-heading {
    max-inline-size: 20ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--3xl, 2rem);
    line-height: 1.2;
  }

  .coffee-quiz__reveal-bags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-2xl, 1.5rem);
  }

  /* Each bag lifts and fades in turn, so the row reads as filling up rather than blinking. The
     delay is set per bag by the component. */
  @media (prefers-reduced-motion: no-preference) {
    .coffee-quiz__reveal-bags .coffee-quiz__bag {
      animation: coffee-quiz-bag 1.4s var(--ease-out-cubic, ease-in-out) infinite;
      animation-delay: var(--coffee-quiz-bag-delay, 0s);
    }
  }

  @keyframes coffee-quiz-bag {
    0%,
    100% {
      opacity: var(--opacity-35, 0.35);
      translate: 0 0;
    }

    40% {
      opacity: 1;
      translate: 0 -0.75rem;
    }
  }

  .coffee-quiz__result {
    display: grid;
    justify-items: center;
    gap: var(--gap-xl, 1.25rem);
    text-align: center;
  }

  /* The markup carries intrinsic dimensions so the box is reserved before the image arrives; the
     aspect ratio is whatever the product shot actually is. */
  .coffee-quiz__result-image {
    inline-size: min(100%, 20rem);
    block-size: auto;
    object-fit: contain;
  }

  .coffee-quiz__result-description {
    max-inline-size: 50ch;
    margin: 0;
  }

  .coffee-quiz__reasons-label,
  .coffee-quiz__reasons {
    margin: 0;
  }

  .coffee-quiz__reasons {
    display: grid;
    gap: var(--gap-2xs, 0.3rem);
    padding: 0;
  }

  .coffee-quiz__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-lg, 1rem);
    margin-block-start: var(--gap-xl, 1.25rem);
  }

  .coffee-quiz__action {
    display: inline-block;
    padding-block: 10px;
    padding-inline: var(--padding-4xl, 2rem);
    border: 1px solid var(--coffee-quiz-color);
    border-radius: 0;
    background: transparent;
    color: currentcolor;
    font-size: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .coffee-quiz__action:hover {
    background: var(--coffee-quiz-color);
    color: var(--coffee-quiz-background);
  }

  .coffee-quiz__explore {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--gap-lg, 1rem);
    margin-block-start: var(--gap-2xl, 1.5rem);
  }

  @media screen and (max-width: 749px) {
    .coffee-quiz__modal {
      padding: var(--padding-2xl, 1.5rem);
    }

    .coffee-quiz__footer > .coffee-quiz__bag {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.coffee_quiz",
  "blocks": [
    {
      "type": "question",
      "name": "t:names.coffee_quiz_question",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "How <em>do you</em> brew your coffee?"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "t:settings.text"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "t:settings.options",
          "info": "t:info.coffee_quiz_options",
          "default": "Espresso | rich\nPour Over\/ Filter | bright\nFrench Press | rich\nAeroPress | bright\nStovetop \/ Moka Pot | rich\nAutomatic Machine | balanced\nI'm not sure"
        }
      ]
    },
    {
      "type": "match",
      "name": "t:names.coffee_quiz_match",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "t:settings.tag",
          "info": "t:info.coffee_quiz_tag"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:settings.product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.text"
        },
        {
          "type": "textarea",
          "id": "reasons",
          "label": "t:settings.reasons",
          "info": "t:info.coffee_quiz_reasons"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Find your coffee quiz"
    },
    {
      "type": "text",
      "id": "step_label",
      "label": "t:settings.step_label",
      "info": "t:info.coffee_quiz_step_label",
      "default": "Question [current] of [total]"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "t:settings.next_label",
      "default": "Next Question"
    },
    {
      "type": "text",
      "id": "last_label",
      "label": "t:settings.last_next_label",
      "default": "See my match"
    },
    {
      "type": "header",
      "content": "t:content.loading"
    },
    {
      "type": "inline_richtext",
      "id": "reveal_heading",
      "label": "t:settings.heading",
      "default": "Your <em>coffee match<\/em> is taking shape..."
    },
    {
      "type": "range",
      "id": "reveal_duration",
      "label": "t:settings.duration",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "textarea",
      "id": "bag_svg",
      "label": "t:settings.icon_svg",
      "info": "t:info.coffee_quiz_bag_svg"
    },
    {
      "type": "header",
      "content": "t:content.result"
    },
    {
      "type": "inline_richtext",
      "id": "result_heading",
      "label": "t:settings.heading",
      "default": "We think <em>you'll love<\/em>..."
    },
    {
      "type": "text",
      "id": "reasons_label",
      "label": "t:settings.reasons",
      "default": "Why we picked it:"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "t:settings.add_to_cart_label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "t:settings.subscribe_label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "explore_prompt",
      "label": "t:settings.text",
      "default": "Want to see more?"
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "t:settings.label",
      "default": "Explore all our coffees"
    },
    {
      "type": "url",
      "id": "explore_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#6B1235"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#F5F4EA"
    },
    {
      "type": "color",
      "id": "accent_background",
      "label": "t:settings.button_background_color",
      "default": "#F5F4EA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.button_text_color",
      "default": "#6B1235"
    }
  ]
}
{% endschema %}
