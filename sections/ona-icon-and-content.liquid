<section class="col-4-icons wowo fadeIn" data-wow-duration="0.75s" data-wow-delay="300ms" style="--icon-content-title-gap: {{ section.settings.title_gap | default: 0 }}px;">
    <div class="container">
        <div class="title wow fadeInDown" data-wow-duration="1s" data-wow-delay="600ms">
            <h2>{{ section.settings.title }}</h2>
        </div>
        <div class="content">
          {% assign duration = 100 %}
          {% for block in section.blocks %}

            {% assign duration = duration | plus: 100 %}
            <div class="block  wowo fadeInUp" data-wow-duration="1s" data-wow-delay="{{ duration }}ms">
                <a href="{{ block.settings.url }}" class="box icon-box-anchor">
                  {% if block.settings.icon != blank %}
                  <div class="icon-c">
                     <img src="{{ block.settings.icon | img_url: '400x' }}" alt="{{ block.settings.icon.alt | escape }}" class="wowo animate__heartBeat" data-wow-duration="1.5s" loading="lazy" decoding="async">
                  </div>
                  {% endif %}
                  <div class="text wowo fadeInDown" data-wow-duration="1s" data-wow-delay="{{ duration }}ms">
                      <p>{{ block.settings.title }}</p>
                  </div>
                </a>
            </div>
          {% endfor %}
        </div>
    </div>
</section>

{% stylesheet %}
  /* These items are anchor links that jump to sections further down but read as
     plain text. Lay them out as a nav of equal-height outlined buttons so they
     clearly invite a click and sit in a tidy grid. Scoped to this section (same
     #MainContent prefix as the legacy layout it sits on). */
  #MainContent .col-4-icons { padding-block: var(--legacy-page-gap, 64px); }

  #MainContent .col-4-icons .content {
    align-items: stretch;
    gap: clamp(14px, 1.5vw, 24px);
    /* Space between the title and the blocks, set per section in the editor. */
    margin-block-start: var(--icon-content-title-gap, 0px);
  }

  #MainContent .col-4-icons .content .block { display: flex; }

  #MainContent .col-4-icons .icon-box-anchor {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: clamp(18px, 2vw, 28px) 18px;
    border: 1px solid rgb(var(--color-foreground-rgb, 71 10 18) / 0.35);
    color: var(--color-foreground, #470a12);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color .15s ease, color .15s ease, border-color .15s ease;
  }

  #MainContent .col-4-icons .icon-box-anchor .text p { margin: 0; line-height: 1.4; }

  #MainContent .col-4-icons .icon-box-anchor:hover,
  #MainContent .col-4-icons .icon-box-anchor:focus-visible {
    background-color: var(--color-primary-button-background, #470a12);
    color: var(--color-primary-button-text, #f4f3e9);
    border-color: transparent;
  }

  #MainContent .col-4-icons .icon-box-anchor:focus-visible {
    outline: 2px solid var(--color-primary-button-background, #470a12);
    outline-offset: 3px;
  }

  #MainContent .col-4-icons .icon-c { block-size: auto; }
  #MainContent .col-4-icons .icon-c img { max-height: 48px; }
{% endstylesheet %}

{% schema %}
{
  "name": {
    "en": "Icons and content"
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": {
		"en": "Title"
      }
    },
    {
      "type": "range",
      "id": "title_gap",
      "label": "Gap below title",
      "info": "Space between the title and the blocks.",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": {
        "en": "Block"
      },
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": {
            "en": "Icon"
          }
        },
        {
          "type": "text",
          "id": "title",
          "label": {
            "en": "Title"
          }
        },
        {
          "type": "url",
          "id": "url",
          "label": {
            "en": "Url"
          }
        }
      ]
    }
  ],
  "presets": [
    {
      "name": {
        "en": "Icons and content"
      },
      "category": {
        "en": "Text"
      }
    }
  ]
}
{% endschema %}