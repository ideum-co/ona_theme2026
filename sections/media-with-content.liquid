{% liquid
  assign media_class_modifier = 'media-with-content--' | append: section.settings.media_width

  if section.settings.extend_media and section.settings.section_width == 'page-width'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--media-extend'
  endif

  if section.settings.media_position == 'right'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--media-right'
  endif

  if section.settings.mobile_content_first
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--mobile-content-first'
  endif

  if section.settings.mobile_text_center
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--mobile-text-center'
  endif

  if section.settings.content_distribution == 'space-between'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--distribute'
  endif

  if section.settings.media_ignores_padding
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--media-bleed'
  endif

  if section.settings.content_padding_custom
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--content-padding'
  endif

  if section.settings.media_width_ratio > 0 and section.settings.extend_media == false
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--custom-split'
  endif
%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} disable-section-top-offset media-with-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style {{ media_class_modifier }}{% if section.settings.limit_content_width %} media-with-content--limited{% endif %}"
  data-testid="media-with-content"
  style="
    {%- render 'spacing-style', settings: section.settings %}
    {% render 'border-override', settings: section.settings %}
    --media-height: {{ section.settings.media_height }};
    {%- if section.settings.media_width_ratio > 0 %}
      {%- assign content_ratio = 100 | minus: section.settings.media_width_ratio -%}
      {%- comment -%}
        Its own variable rather than overriding the grid columns directly: the columns are also the
        mobile layout, a three-track grid with margins, and an inline style cannot be confined to a
        media query. This one is only read inside the desktop rule below.
      {%- endcomment -%}
      {%- if section.settings.media_position == 'right' %}
        --media-with-content-split: {{ content_ratio }}fr {{ section.settings.media_width_ratio }}fr;
      {%- else %}
        --media-with-content-split: {{ section.settings.media_width_ratio }}fr {{ content_ratio }}fr;
      {%- endif %}
    {%- endif %}
    --media-with-content-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    {%- if section.settings.content_padding_custom %}
      --media-with-content-content-padding-inline: {{ section.settings.content_padding_inline }}px;
      --media-with-content-content-padding-block-start: {{ section.settings.content_padding_block_start }}px;
      --media-with-content-content-padding-block-end: {{ section.settings.content_padding_block_end }}px;
    {%- endif %}
    {% if section.settings.limit_content_width %}
      --media-with-content-max-width: {{ section.settings.max_width }}px;
    {% endif %}
    {%- case section.settings.media_height %}
      {% when '50svh' %}
        --media-height-mobile: 30svh;
      {% when '60svh' %}
        --media-height-mobile: 50svh;
      {% when '80svh' %}
        --media-height-mobile: 70svh;
      {% when '100svh' %}
        --media-height-mobile: 100svh;
      {% else %}
        --media-height-mobile: auto;
    {% endcase -%}

    {% if section.settings.media_height != 'auto' %}
     --section-preview-height: 600px;
     {% endif %}
  "
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  {% content_for 'block', type: '_media-without-appearance', id: 'media' %}

  {% content_for 'block', type: '_content-without-appearance', id: 'content' %}
</div>

{% stylesheet %}
  .section--page-width {
    &.media-with-content {
      grid-template-areas: 'margin-left media margin-right' 'margin-left content margin-right';

      @media screen and (min-width: 750px) {
        /* Wide proportion is media 3.5 parts, content 2.5 parts. Which equals 7|5. So divide the central column by 7+5 and multiply accordingly */
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc((var(--full-page-grid-central-column-width) / 12) * 7)
          calc((var(--full-page-grid-central-column-width) / 12) * 5) var(--full-page-grid-margin);

        grid-template-areas: 'margin-left media content margin-right';
      }
    }

    &.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc((var(--full-page-grid-central-column-width) / 12) * 5)
          calc((var(--full-page-grid-central-column-width) / 12) * 7) var(--full-page-grid-margin);

        grid-template-areas: 'margin-left content media margin-right';
      }
    }

    &.media-with-content--medium {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          repeat(2, calc(var(--full-page-grid-central-column-width) / 2)) var(--full-page-grid-margin);
      }
    }

    &.media-with-content--narrow.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc((var(--full-page-grid-central-column-width) / 3) * 2)
          calc(var(--full-page-grid-central-column-width) / 3) var(--full-page-grid-margin);
      }
    }

    &.media-with-content--narrow {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc(var(--full-page-grid-central-column-width) / 3)
          calc((var(--full-page-grid-central-column-width) / 3) * 2) var(--full-page-grid-margin);
      }
    }
  }

  .section--full-width {
    &.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 2.5fr 3.5fr;

        grid-template-areas: 'content media';
      }
    }

    &.media-with-content--medium {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 1fr 1fr;
      }
    }

    &.media-with-content--narrow {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 2fr 4fr;
      }
    }

    &.media-with-content--narrow.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 4fr 2fr;
      }
    }
  }

  /* Keep the CSS specificity lower assuming that liquid won't assign this class with a full width section */
  .media-with-content.media-with-content--media-extend {
    grid-template-columns: var(--media-with-content-grid-columns);
    grid-template-areas: 'media media media' 'margin-left content margin-right';

    @media screen and (min-width: 750px) {
      grid-template-areas: 'media media content margin-right';
    }
  }

  .media-with-content--media-extend.media-with-content--media-right {
    @media screen and (min-width: 750px) {
      grid-template-areas: 'margin-left content media media';
    }
  }

  .media-with-content--media-right {
    @media screen and (min-width: 750px) {
      grid-template-areas: 'margin-left content media media';
    }
  }

  /* Pushes the first block to the top and the last to the bottom of the content column. The panel
     is a flex column, so the distribution goes there; the column itself already fills the row. */
  .media-with-content--distribute .media-with-content__content,
  .media-with-content--distribute .media-with-content__content > .group-block-content {
    block-size: 100%;
  }

  /* Three classes so it outranks the width presets, which are two - `.section--full-width` plus
     `.media-with-content--medium` and friends. Desktop only: below 750px the grid is a three-track
     template with margins and a two-value split would break its areas. */
  @media screen and (min-width: 750px) {
    .section.media-with-content.media-with-content--custom-split {
      grid-template-columns: var(--media-with-content-split);
    }
  }

  /* The section's padding is on the grid, so it insets the media as well as the content and the
     image ends up cropped by it. This pulls the media area back out by exactly that padding, which
     `spacing-style` has already published as custom properties, so the image runs to the section's
     edges while the content keeps its breathing room. */
  .media-with-content--media-bleed .media-block {
    margin-block: calc(-1 * var(--padding-block-start, 0px)) calc(-1 * var(--padding-block-end, 0px));
  }

  /* Only the first block separates. `space-between` spread every block - heading, text and button
     all pulled apart - and the design wants the heading at the top with the rest together below. */
  .media-with-content--distribute .media-with-content__content > .group-block-content > :first-child {
    margin-block-end: auto;
  }

  /* The inner padding of the content column was fixed at the page margin, twice over on mobile.
     With the modifier it becomes three settings. Four classes so it outranks the `page-width` rule
     below, which zeroes `padding-inline` for a page-width section. */
  .section.media-with-content.media-with-content--content-padding
    .media-with-content__content
    > .group-block-content {
    /* Longhands, and one class more than the `page-width` rule below: that rule zeroes
       `padding-inline` and then sets `padding-inline-start` again from 750px up. A shorthand tying
       on specificity would lose that side to its longhand. */
    padding-inline-start: var(--media-with-content-content-padding-inline);
    padding-inline-end: var(--media-with-content-content-padding-inline);
    padding-block-start: var(--media-with-content-content-padding-block-start);
    padding-block-end: var(--media-with-content-content-padding-block-end);
  }

  /* Side padding and centring for the phone only. The padding goes on the content column and not
     on `.group-block-content`, whose inline padding the theme already zeroes for a page-width
     section - that is why the text sat flush against the edge - so there is no rule to outrank. */
  @media screen and (max-width: 749px) {
    .media-with-content__content {
      padding-inline: var(--media-with-content-mobile-padding-inline, 0);
    }

    .media-with-content--mobile-text-center .media-with-content__content {
      text-align: center;
    }

    /* The panel aligns its items from `--horizontal-alignment`, which arrives as an inline style,
       so `align-items` is overridden directly rather than the variable behind it. */
    .media-with-content--mobile-text-center .media-with-content__content .layout-panel-flex {
      align-items: center;
    }

    .media-with-content--mobile-text-center .media-with-content__content .text-block {
      align-items: center;
    }

    /* A text block with its own alignment set emits `--text-align` inline, and nothing declared on
       that element can outrank an inline style. The variable is only read one level down, in
       `.text-block > * { text-align: var(--text-align, …) }`, so that child is where the property
       can actually be overridden - which is why the heading and the button centred and the
       paragraph did not. */
    .media-with-content--mobile-text-center .media-with-content__content .text-block > * {
      text-align: center;
    }
  }

  /* Puts the content above the media on a phone. Scoped to its own query so none of the desktop
     `grid-template-areas` rules above are affected - they all live from 750px up. */
  @media screen and (max-width: 749px) {
    .media-with-content.media-with-content--mobile-content-first {
      grid-template-areas: 'content content content' 'media media media';
    }
  }

  /* Caps the media and text on very wide screens. The section background deliberately stays
     edge to edge: capping it too left the page colour showing down both sides of the section. */
  .media-with-content--limited {
    max-inline-size: var(--media-with-content-max-width, 1280px);
    margin-inline: auto;
  }

  .media-with-content {
    --media-with-content-grid-columns: var(--full-page-grid-with-margins);

    grid-template-columns: var(--media-with-content-grid-columns);
    grid-template-areas: 'media media media' 'content content content';

    @media screen and (min-width: 750px) {
      --media-with-content-grid-columns: 3.5fr 2.5fr;

      /* Default desktop layout is wide media, on the left, in full page section */
      grid-template-areas: 'media content';
    }

    .media-block {
      grid-area: media;
    }

    .media-with-content__content {
      grid-area: content;
    }

    /* Inner blocks spacing */
    .media-with-content__content > .group-block-content {
      padding-inline: var(--page-margin);
      padding-block: calc(2 * var(--page-margin));

      @media screen and (min-width: 750px) {
        padding-block: var(--page-margin);
      }
    }

    &.section--page-width .media-with-content__content > .group-block-content {
      padding-inline: 0;

      @media screen and (min-width: 750px) {
        padding-inline-start: var(--page-margin);
      }
    }

    &.section--page-width.media-with-content--media-right .media-with-content__content > .group-block-content {
      padding-inline-end: var(--page-margin);
      padding-inline-start: 0;
    }
  }

  .media-with-content[data-shopify-visual-preview] {
    --hero-min-height: 500px;

    min-height: 500px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.media_with_text",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "mobile_padding_inline",
      "label": "t:settings.mobile_padding_inline",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "mobile_text_center",
      "label": "t:settings.mobile_text_center",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "content_padding_custom",
      "label": "t:settings.content_padding_custom",
      "info": "t:info.content_padding_custom",
      "default": false
    },
    {
      "type": "range",
      "id": "content_padding_inline",
      "label": "t:settings.horizontal_padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.content_padding_custom }}"
    },
    {
      "type": "range",
      "id": "content_padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.content_padding_custom }}"
    },
    {
      "type": "range",
      "id": "content_padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.content_padding_custom }}"
    },
    {
      "type": "checkbox",
      "id": "media_ignores_padding",
      "label": "t:settings.media_ignores_padding",
      "info": "t:info.media_ignores_padding",
      "default": false
    },
    {
      "type": "select",
      "id": "content_distribution",
      "label": "t:settings.content_distribution",
      "info": "t:info.content_distribution",
      "options": [
        {
          "value": "together",
          "label": "t:options.together"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "together"
    },
    {
      "type": "checkbox",
      "id": "mobile_content_first",
      "label": "t:settings.mobile_content_first",
      "info": "t:info.mobile_content_first",
      "default": false
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "media_width_ratio",
      "label": "t:settings.media_width_ratio",
      "info": "t:info.media_width_ratio",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ section.settings.extend_media == false }}"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:settings.media_width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "wide",
          "label": "t:options.wide"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "t:settings.media_height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "50svh",
          "label": "t:options.small"
        },
        {
          "value": "60svh",
          "label": "t:options.medium"
        },
        {
          "value": "80svh",
          "label": "t:options.large"
        },
        {
          "value": "100svh",
          "label": "t:options.full_screen"
        }
      ],
      "default": "80svh"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "limit_content_width",
      "label": "t:settings.limit_content_width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:settings.max_width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1280,
      "visible_if": "{{ section.settings.limit_content_width }}"
    },
    {
      "type": "checkbox",
      "id": "extend_media",
      "label": "t:settings.extend_media_to_screen_edge",
      "default": true,
      "visible_if": "{{ section.settings.section_width == 'page-width' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.editorial",
      "category": "t:categories.storytelling",
      "settings": {
        "media_width": "medium",
        "media_height": "60svh"
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "space-between"
          },
          "blocks": {
            "caption": {
              "type": "text",
              "name": "t:names.caption",
              "settings": {
                "text": "t:html_defaults.bestseller",
                "type_preset": "h6"
              }
            },
            "group": {
              "type": "group",
              "settings": {
                "height": "fit"
              },
              "blocks": {
                "heading": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "t:html_defaults.signature_products",
                    "type_preset": "h3"
                  }
                },
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "t:html_defaults.made_with_care_extended",
                    "max_width": "narrow",
                    "type_preset": "rte"
                  }
                }
              },
              "block_order": [
                "heading",
                "text"
              ]
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "t:text_defaults.shop_now_button_label",
                "link": "shopify://collections/all",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": [
            "caption",
            "group",
            "button"
          ]
        }
      }
    },
    {
      "name": "t:names.editorial_jumbo_text",
      "category": "t:categories.storytelling",
      "settings": {
        "media_position": "right",
        "media_width": "medium",
        "media_height": "60svh"
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "flex-end"
          },
          "blocks": {
            "caption": {
              "type": "jumbo-text",
              "name": "t:names.jumbo_text",
              "settings": {
                "text": "t:text_defaults.up_the_ante",
                "font": "heading",
                "alignment": "right",
                "line_height": "0.8",
                "letter_spacing": "-0.03em",
                "case": "uppercase"
              }
            }
          },
          "block_order": [
            "caption"
          ]
        }
      }
    }
  ]
}
{% endschema %}
