{%- comment -%}
  PDP origin section: a farm image, the coffee's origin specs read as a label/value list, and an
  outline map of the origin country. Every piece is driven by the product's own metafields, so the
  whole section is dynamic and self-hiding.

  Visibility is driven by the LIST (producer / region / altitude / varietal / process): if the
  product carries none of them, the section renders nothing at all -- no wrapper, no spacing. If it
  carries at least one, the section shows, and each row/piece appears only when its metafield has a
  value. The image (custom.origin_image) and the country map (custom.country) are extras: they show
  when present but never keep an otherwise-empty section alive.

  Metafields (all namespace `custom`):
    - origin_image  file_reference          -> farm / origin photo
    - producer      single_line_text_field
    - region        single_line_text_field
    - altitude      single_line_text_field
    - varietal      single_line_text_field
    - process       single_line_text_field
    - country       single_line_text_field  -> drives snippets/country-map.liquid

  CSS lives in {% stylesheet %} (aggregated), never an inline <style>.
{%- endcomment -%}

{%- liquid
  assign p = product

  assign producer = p.metafields.custom.producer.value | strip
  assign region = p.metafields.custom.region.value | strip
  assign altitude = p.metafields.custom.altitude.value | strip
  assign varietal = p.metafields.custom.varietal.value | strip
  assign process = p.metafields.custom.process.value | strip

  assign has_specs = false
  if producer != blank or region != blank or altitude != blank or varietal != blank or process != blank
    assign has_specs = true
  endif

  assign origin_image = p.metafields.custom.origin_image.value
  assign country = p.metafields.custom.country.value | strip
-%}

{%- capture country_map -%}{%- if country != blank and section.settings.show_map != false -%}{%- render 'country-map', country: country -%}{%- endif -%}{%- endcapture -%}

{%- if has_specs -%}
  {%- if section.settings.background_color != blank -%}
    {%- render 'contrast-override', background_color: section.settings.background_color, section_id: section.id -%}
  {%- endif -%}
  <section
    class="origin-detail section origin-detail--media-{{ section.settings.media_position | default: 'left' }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--origin-map-color: {{ section.settings.map_color }}; --origin-map-size: {{ section.settings.map_size | default: 180 }}px; padding-block-start: {{ section.settings.padding_block_start | default: 0 }}px; padding-block-end: {{ section.settings.padding_block_end | default: 0 }}px;"
    {{ section.shopify_attributes }}
  >
    <div class="origin-detail__inner">
      {%- if origin_image != blank -%}
        <div class="origin-detail__media">
          {{
            origin_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 749px) 100vw, 50vw',
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'origin-detail__img',
              alt: origin_image.alt | default: p.title
          }}
        </div>
      {%- endif -%}

      <div class="origin-detail__panel">
        {%- if section.settings.heading != blank -%}
          <h2 class="origin-detail__heading {{ section.settings.heading_preset | default: 'h4' }}">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}

        <dl class="origin-detail__specs">
          {%- if producer != blank -%}
            <div class="origin-detail__row">
              <dt class="origin-detail__label">Producer</dt>
              <dd class="origin-detail__value">{{ producer | escape }}</dd>
            </div>
          {%- endif -%}
          {%- if region != blank -%}
            <div class="origin-detail__row">
              <dt class="origin-detail__label">Region</dt>
              <dd class="origin-detail__value">{{ region | escape }}</dd>
            </div>
          {%- endif -%}
          {%- if altitude != blank -%}
            <div class="origin-detail__row">
              <dt class="origin-detail__label">Altitude</dt>
              <dd class="origin-detail__value">{{ altitude | escape }}</dd>
            </div>
          {%- endif -%}
          {%- if varietal != blank -%}
            <div class="origin-detail__row">
              <dt class="origin-detail__label">Varietal</dt>
              <dd class="origin-detail__value">{{ varietal | escape }}</dd>
            </div>
          {%- endif -%}
          {%- if process != blank -%}
            <div class="origin-detail__row">
              <dt class="origin-detail__label">Process</dt>
              <dd class="origin-detail__value">{{ process | escape }}</dd>
            </div>
          {%- endif -%}
        </dl>

        {%- if country_map != blank -%}
          <div class="origin-detail__map" aria-label="Map of {{ country | escape }}">
            {{ country_map }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .origin-detail {
    padding-block: 0;
  }

  .origin-detail__inner {
    display: grid;
    gap: 0;
  }

  @media screen and (min-width: 750px) {
    .origin-detail__inner {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    /* Image on the right: swap the two columns. DOM order stays media-then-panel, so on
       mobile (single column) the image still comes first regardless of this setting. */
    .origin-detail--media-right .origin-detail__media {
      grid-column: 2;
      grid-row: 1;
    }

    .origin-detail--media-right .origin-detail__panel {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .origin-detail__media {
    position: relative;
    min-height: 320px;
  }

  .origin-detail__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .origin-detail__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl, 32px);
    padding: clamp(32px, 6vw, 88px);
    /* The panel paints from the section's colour scheme; see color-* on the wrapper. */
  }

  .origin-detail__heading {
    margin: 0;
  }

  .origin-detail__specs {
    margin: 0;
    display: grid;
    gap: clamp(20px, 2.4vw, 34px);
    /* Leave room so the map never sits under the last rows on wide panels. */
    max-width: 30ch;
  }

  .origin-detail__row {
    display: grid;
    gap: 6px;
  }

  .origin-detail__label {
    margin: 0;
    font-family: var(--font-subheading--family, inherit);
    font-size: var(--font-h6--size, 0.75rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--origin-map-color, currentColor);
  }

  .origin-detail__value {
    margin: 0;
    font-size: var(--font-h4--size, 1.4rem);
    line-height: 1.2;
  }

  .origin-detail__map {
    color: var(--origin-map-color, currentColor);
    pointer-events: none;
  }

  .country-map__svg {
    display: block;
    width: clamp(120px, 16vw, var(--origin-map-size, 200px));
    height: auto;
  }

  /* On wide screens the map anchors to the bottom-right of the panel, as in the reference. */
  @media screen and (min-width: 750px) {
    .origin-detail__panel {
      justify-content: center;
    }

    .origin-detail__map {
      position: absolute;
      inset-block-end: clamp(32px, 6vw, 88px);
      inset-inline-end: clamp(32px, 6vw, 88px);
      margin: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .origin-detail__map {
      align-self: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product origin",
  "tag": "section",
  "class": "shopify-section--product-origin",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional, shown above the list. Leave empty to hide."
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "t:settings.preset",
      "options": [
        { "value": "h2", "label": "t:options.h2" },
        { "value": "h3", "label": "t:options.h3" },
        { "value": "h4", "label": "t:options.h4" },
        { "value": "h5", "label": "t:options.h5" },
        { "value": "h6", "label": "t:options.h6" }
      ],
      "default": "h4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "info": "On desktop. The image always stacks on top on mobile.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Country map"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show country map",
      "info": "Shown only when the product's Country metafield is set and has a map on file.",
      "default": true
    },
    {
      "type": "range",
      "id": "map_size",
      "label": "Map size",
      "min": 100,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#f4f3e9"
    },
    {
      "type": "color",
      "id": "map_color",
      "label": "Labels & map colour",
      "info": "Used for the small labels and the country map outline.",
      "default": "#751132"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product origin"
    }
  ]
}
{% endschema %}
