{%- liquid
  # The level is a setting so the page keeps one heading outline, but only h1 to h6 pass
  # through - anything else would put an arbitrary tag name straight from a setting.
  assign heading_tag = section.settings.heading_tag | default: 'h3'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6'
    assign heading_tag = 'h3'
  endunless
  # Ends the size chain: an explicit px value wins, then the typography preset, then the
  # size that belongs to the chosen level. It has to be published as a variable because a
  # class rule outranks the theme's `h3` selector, and an invalid var() resets to inherit
  # rather than falling through to it.
  assign heading_level_size = '--font-' | append: heading_tag | append: '--size'
  assign settings = section.settings
  assign product = settings.product

  assign image = settings.image
  if image == blank
    assign image = product.featured_media.preview_image
  endif

  ##
  # The 3D model comes from the product's own media when there is one - that path is native, so it
  # carries a poster and an iOS AR source for free. A file uploaded to Content > Files is the
  # fallback, for a model that is not attached to a product.
  assign model_media = product.media | where: 'media_type', 'model' | first
  # `model_viewer_tag` handles the iOS AR source itself, so only the glb is needed here - and only
  # to tell whether the product actually carries a model.
  assign model_glb = model_media.sources | where: 'format', 'glb' | first

  assign model_src = model_glb.url
  if model_src == blank
    assign model_src = settings.model_url
  endif

  assign show_model = false
  if settings.media_type == 'model' and model_src != blank
    assign show_model = true
  endif

  assign body = settings.body
  if body == blank
    assign body = product.description
  endif

  assign primary_link = settings.primary_link
  if primary_link == blank
    assign primary_link = product.url
  endif

  # The wordmark is display-scale, so it gets a fluid ramp against a 1440px reference instead of a
  # fixed size that would overflow a phone. The smaller texts keep the size as typed.
  assign wordmark_min = settings.wordmark_size | times: 0.5 | round
  assign wordmark_vw = settings.wordmark_size | times: 100.0 | divided_by: 1440
-%}

<div
  class="product-intro spacing-style"
  style="
    --section-heading-level-size: var({{ heading_level_size }});
    --product-intro-background: {{ settings.background_color }};
    --product-intro-color: {{ settings.text_color }};
    --product-intro-wordmark-color: {{ settings.wordmark_color }};
    --product-intro-wordmark-size: clamp({{ wordmark_min }}px, {{ wordmark_vw }}vw, {{ settings.wordmark_size }}px);
    --product-intro-eyebrow-size: {{ settings.eyebrow_size }}px;
    --product-intro-heading-size: {{ settings.heading_size }}px;
    --product-intro-body-size: {{ settings.body_size }}px;
    {% if settings.wordmark_style == 'gradient' %}
      --product-intro-wordmark-gradient: {{ settings.wordmark_gradient }};
    {% endif %}
    {% if settings.wordmark_shadow_color != blank and settings.wordmark_shadow_color.alpha > 0 %}
      --product-intro-wordmark-shadow: 0 {{ settings.wordmark_shadow_offset }}px {{ settings.wordmark_shadow_blur }}px rgba({{ settings.wordmark_shadow_color.rgba }});
    {% endif %}
    --product-intro-button-background: {{ settings.button_background }};
    --product-intro-button-color: {{ settings.button_text }};
    --product-intro-model-height: {{ settings.model_height }}px;
    --product-intro-model-width: {{ settings.model_width }}px;
    --product-intro-max-width: {{ settings.max_width | default: 1280 }}px;
    --product-intro-media-height: var(--product-intro-media-height-{{ settings.media_height | default: 'medium' }});
    {% if settings.background_image != blank %}
      --product-intro-background-image: url({{ settings.background_image | image_url: width: 2400 }});
    {% endif %}
    {%- render 'spacing-style', settings: settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="product-intro__inner product-intro__inner--{{ settings.section_width | default: 'page-width' }} product-intro__inner--media-{{ settings.media_width | default: 'medium' }}{% if settings.limit_content_width %} product-intro__inner--limited{% endif %}">
  <div class="product-intro__wordmark">
    {%- if settings.eyebrow != blank -%}
      <p class="product-intro__eyebrow">{{ settings.eyebrow }}</p>
    {%- endif -%}

    {%- comment -%}
      SVG first: Shopify's image picker cannot select an SVG, and inline markup can also pick up
      the section colour through currentColor.
    {%- endcomment -%}
    {%- if settings.wordmark_svg != blank -%}
      <div class="product-intro__wordmark-svg">{%- render 'svg-without-styles', svg: settings.wordmark_svg -%}</div>
    {%- elsif settings.wordmark_image != blank -%}
      {{
        settings.wordmark_image
        | image_url: width: 1200
        | image_tag: widths: '300, 600, 900, 1200', sizes: '(min-width: 750px) 30vw, 80vw', loading: 'lazy', class: 'product-intro__wordmark-image'
      }}
    {%- elsif settings.wordmark_text != blank -%}
      <p class="product-intro__wordmark-text product-intro__wordmark-text--{{ settings.wordmark_style }}">
        {{- settings.wordmark_text -}}
      </p>
    {%- endif -%}
  </div>

  <div class="product-intro__media">
    {%- if show_model -%}
      <script
        src="{{ 'product-intro-model.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>

      {%- comment -%}
        The tag comes from `model_viewer_tag` and not from hand-written markup: Shopify only ships
        the `<model-viewer>` element to a page that uses this filter, so writing the element by hand
        left it undefined and the section rendered an empty box with nothing in the console. The
        section's own settings are applied to it as attributes on the client.

        A model that is not attached to a product has no filter to go through, so that path asks for
        the element directly and falls back to the image when it cannot get it.
      {%- endcomment -%}
      <product-intro-model
        class="product-intro__model"
        data-shadow="{{ settings.model_shadow }}"
        data-exposure="{{ settings.model_exposure }}"
        {% if settings.model_auto_rotate %}
          data-auto-rotate="{{ settings.model_rotation_speed }}"
        {% endif %}
        {% if settings.model_allow_rotation %}
          data-allow-rotation
        {% endif %}
        {% unless model_glb %}
          data-src="{{ model_src | escape }}"
          data-alt="{{ product.title | escape }}"
          {% comment %}
            Only this path needs the bundled viewer, and only if the page does not already have one.
            A model held on the product goes through `model_viewer_tag`, which makes Shopify ship
            the element itself, so it never pays for this.
          {% endcomment %}
          data-viewer-src="{{ 'model-viewer.min.js' | asset_url }}"
          {% if image != blank %}
            data-poster="{{ image | image_url: width: 1400 }}"
          {% endif %}
        {% endunless %}
      >
        {%- if model_glb -%}
          {{ model_media | model_viewer_tag: image_size: '1400x', reveal: 'auto', toggleable: false }}
        {%- endif -%}
      </product-intro-model>
    {%- elsif image != blank -%}
      {{
        image
        | image_url: width: 1400
        | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 34vw, 80vw', loading: 'lazy', class: 'product-intro__image'
      }}
    {%- endif -%}
  </div>

  <div class="product-intro__details">
    {%- if settings.heading != blank -%}
      <{{ heading_tag }}
      class="product-intro__heading"
      style="{%- render 'typography-style', settings: section.settings, type: 'heading' -%}"
    >{{ settings.heading }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if body != blank -%}
      <div class="product-intro__body rte">{{ body }}</div>
    {%- endif -%}

    {%- if settings.primary_label != blank or settings.secondary_label != blank -%}
      <div class="product-intro__buttons">
        {%- if settings.primary_label != blank -%}
          <a
            class="button product-intro__button"
            {% if primary_link != blank %}
              href="{{ primary_link }}"
            {% endif %}
          >
            {{- settings.primary_label -}}
          </a>
        {%- endif -%}

        {%- if settings.secondary_label != blank -%}
          <a
            class="button product-intro__button"
            {% if settings.secondary_link != blank %}
              href="{{ settings.secondary_link }}"
            {% endif %}
          >
            {{- settings.secondary_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  </div>
</div>

{% stylesheet %}
  .product-intro {
    --product-intro-media-height-auto: auto;
    --product-intro-media-height-small: 40svh;
    --product-intro-media-height-medium: 60svh;
    --product-intro-media-height-large: 80svh;
    --product-intro-media-height-full-screen: 100svh;

    background-color: var(--product-intro-background);
    background-image: var(--product-intro-background-image, none);
    background-size: cover;
    background-position: center;
    color: var(--product-intro-color);
  }

  .product-intro__inner {
    display: grid;
    gap: var(--gap-2xl);
    align-items: center;
    inline-size: 100%;
    margin-inline: auto;

    /* `minmax(0, 1fr)` and not the implicit `auto`: an auto column is sized by its content, so the
       model's 520px set the column width, the section grew past the viewport and everything sat
       off to one side. With a definite column the model's `max-inline-size: 100%` resolves against
       the screen and it centres. */
    grid-template-columns: minmax(0, 1fr);

  }

  .product-intro__inner--page-width {
    padding-inline: var(--page-margin, 1rem);
  }

  .product-intro__inner--limited {
    max-inline-size: var(--product-intro-max-width, 1280px);
  }

  @media screen and (min-width: 750px) {
    .product-intro__inner--media-narrow {
      grid-template-columns: 1fr minmax(0, 0.75fr) 1fr;
    }

    .product-intro__inner--media-medium {
      grid-template-columns: 1fr minmax(0, 1.1fr) 1fr;
    }

    .product-intro__inner--media-wide {
      grid-template-columns: 1fr minmax(0, 1.5fr) 1fr;
    }
  }

  /* On mobile the pack shot leads, as it carries the product. */
  .product-intro__media {
    display: grid;
    place-items: center;
    inline-size: 100%;
    min-inline-size: 0;
    order: -1;
    block-size: var(--product-intro-media-height, 60svh);
    min-block-size: 0;

    @media screen and (min-width: 750px) {
      order: 0;
    }
  }

  /* The model box is sized rather than shrink-wrapped: `<model-viewer>` has no intrinsic size, so
     without one it collapses. The width has to be a definite length and not `min(100%, …)`: in a
     cell that sizes itself to its content, the percentage resolves against a width that depends on
     this element, which lands on zero. `max-inline-size` is what brings it down on narrow screens. */
  .product-intro__model {
    display: block;
    inline-size: min(100%, var(--product-intro-model-width, 520px));
    block-size: var(--product-intro-model-height, 520px);
    max-block-size: 100%;
    margin-inline: auto;
  }

  .product-intro__model :is(model-viewer, .product-intro__model-viewer) {
    inline-size: 100%;
    block-size: 100%;
    background-color: transparent;

    /* The camera control needs the gesture; without this the page cannot be scrolled from on top
       of the model on touch. `touch-action` on the element pairs with `pan-y` in the markup. */
    --poster-color: transparent;
  }

  .product-intro__image {
    inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    display: block;
    object-fit: contain;
  }

  .product-intro__wordmark {
    display: grid;
    gap: var(--gap-sm);
    justify-items: start;
  }

  :is(.product-intro__wordmark, .product-intro__details) {
    min-inline-size: 0;
  }

  .product-intro__eyebrow {
    margin: 0;
    font-size: var(--product-intro-eyebrow-size, var(--font-size--sm));
  }

  .product-intro__wordmark-image {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }

  .product-intro__wordmark-svg svg {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }

  .product-intro__wordmark-text {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--product-intro-wordmark-size, var(--font-h1--size));
    line-height: 1.05;
    color: var(--product-intro-wordmark-color, currentcolor);
    text-shadow: var(--product-intro-wordmark-shadow, none);
  }

  /* Gradient lettering: the gradient is painted behind the text and clipped to the glyphs, so the
     fill has to go transparent. `-webkit-` prefixes included - Safari still needs them. */
  .product-intro__wordmark-text--gradient {
    /* The fallback is a flat currentcolor gradient, not `none`: with the fill forced transparent,
       a missing gradient would make the lettering vanish outright. */
    background-image: var(--product-intro-wordmark-gradient, linear-gradient(currentcolor, currentcolor));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .product-intro__details {
    display: grid;
    gap: var(--gap-lg);
    justify-items: start;
    max-inline-size: 28rem;
  }

  .product-intro__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--product-intro-heading-size, var(--font-size, var(--section-heading-level-size)));
    font-weight: var(--font-heading--weight);
  }

  .product-intro__body {
    display: grid;
    gap: var(--gap-sm);
    font-size: var(--product-intro-body-size, var(--font-size--sm));
  }

  .product-intro__body :is(p, ul, ol) {
    margin: 0;
  }

  .product-intro__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
  }

  /* The pair shares one row and only wraps when the column is genuinely too narrow. A fixed
     min-width made them stack at the design's own column widths. */
  .product-intro__button.button {
    --button-background-color: var(--product-intro-button-background);
    --button-color: var(--product-intro-button-color);

    flex: 1 1 auto;
    min-inline-size: 0;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_intro",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:settings.media_width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "wide",
          "label": "t:options.wide"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "t:settings.media_height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "limit_content_width",
      "label": "t:settings.limit_content_width",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:settings.max_width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1280,
      "visible_if": "{{ section.settings.limit_content_width }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "info": "t:info.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "model",
          "label": "t:options.three_d_model"
        }
      ],
      "default": "image"
    },
    {
      "type": "text",
      "id": "model_url",
      "label": "t:settings.model_url",
      "info": "t:info.model_url",
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "range",
      "id": "model_width",
      "label": "t:settings.width",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520,
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "range",
      "id": "model_height",
      "label": "t:settings.height",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520,
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "checkbox",
      "id": "model_auto_rotate",
      "label": "t:settings.auto_rotate",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "range",
      "id": "model_rotation_speed",
      "label": "t:settings.speed",
      "min": 5,
      "max": 90,
      "step": 5,
      "unit": "°",
      "default": 30,
      "visible_if": "{{ section.settings.media_type == 'model' and section.settings.model_auto_rotate }}"
    },
    {
      "type": "checkbox",
      "id": "model_allow_rotation",
      "label": "t:settings.allow_rotation",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "range",
      "id": "model_shadow",
      "label": "t:settings.shadow",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "range",
      "id": "model_exposure",
      "label": "t:settings.exposure",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "visible_if": "{{ section.settings.media_type == 'model' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "Introducing"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "t:settings.size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:content.wordmark"
    },
    {
      "type": "textarea",
      "id": "wordmark_svg",
      "label": "t:settings.svg_code",
      "info": "t:info.svg_code"
    },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "t:settings.image",
      "info": "t:info.product_intro_wordmark"
    },
    {
      "type": "inline_richtext",
      "id": "wordmark_text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "wordmark_size",
      "label": "t:settings.size",
      "min": 24,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "select",
      "id": "wordmark_style",
      "label": "t:settings.color",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "wordmark_color",
      "label": "t:settings.color",
      "default": "#d9a441",
      "visible_if": "{{ section.settings.wordmark_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "wordmark_gradient",
      "label": "t:options.gradient",
      "default": "linear-gradient(120deg, #d9a441 20%, #f3dda0 50%, #b8862b 80%)",
      "visible_if": "{{ section.settings.wordmark_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "wordmark_shadow_color",
      "label": "t:settings.shadow_color",
      "alpha": true,
      "default": "#00000000"
    },
    {
      "type": "range",
      "id": "wordmark_shadow_offset",
      "label": "t:settings.vertical_offset",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "wordmark_shadow_blur",
      "label": "t:settings.blur",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "The <em>sweet</em> spot."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:settings.size",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "rte",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
