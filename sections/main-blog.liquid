<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign is_brew_guide_blog = false
  if blog.handle == 'brewguides'
    assign is_brew_guide_blog = true
  endif

  assign selected_coffee_type = ''
  assign selected_brew_method = ''
  if is_brew_guide_blog
    for tag in current_tags
      assign tag_handle = tag | handleize
      if tag_handle contains 'coffee-type-'
        assign selected_coffee_type = tag_handle
      elsif tag_handle contains 'brew-method-'
        assign selected_brew_method = tag_handle
      endif
    endfor
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      {% if is_brew_guide_blog %}blog-posts--brewguides{% endif %}
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if is_brew_guide_blog %}
      <nav class="brew-guide-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/pages/learn">Learn</a>
      </nav>
    {% endif %}
    {% content_for 'blocks' %}

    {%- comment -%}
      Without {% paginate %}, Liquid hands back only the first 50 articles and
      ignores ?page= entirely. Measured on the deployed theme on 2026-10-20:
      /blogs/brewguides has 747 articles, served 50, and page=2, 5, 15 and 16
      each returned the identical 50 -- 697 guides reachable only by direct URL
      or the sitemap, with no way to browse to them. /blogs/news is under the
      cap today and would have broken silently at its 51st article.

      main-blog is the only listing section in Horizon that shipped without
      pagination; main-collection, search-results, product-list and
      featured-blog-posts all have it. This follows main-collection's pattern
      and renders the theme's own pagination-controls.
    {%- endcomment -%}
    {% paginate blog.articles by section.settings.articles_per_page %}
    {% if is_brew_guide_blog %}
      <nav class="brew-guide-filters" aria-label="Filter brew guides">
        <div class="brew-guide-filters__group">
          <span class="brew-guide-filters__label">Coffee type</span>
          {% assign type_all_url = blog.url %}
          {% if selected_brew_method != blank %}
            {% assign type_all_url = blog.url | append: '/tagged/' | append: selected_brew_method %}
          {% endif %}
          <a href="{{ type_all_url }}" class="brew-guide-filters__option{% if selected_coffee_type == blank %} is-active{% endif %}"{% if selected_coffee_type == blank %} aria-current="page"{% endif %}>All</a>
          {% assign type_options = 'coffee-type-espresso:Espresso|coffee-type-filter:Filter|coffee-type-milk:Milk' | split: '|' %}
          {% for option in type_options %}
            {% assign option_parts = option | split: ':' %}
            {% assign option_handle = option_parts[0] %}
            {% assign option_label = option_parts[1] %}
            {% assign option_url = blog.url | append: '/tagged/' | append: option_handle %}
            {% if selected_brew_method != blank %}
              {% assign option_url = option_url | append: '+' | append: selected_brew_method %}
            {% endif %}
            <a href="{{ option_url }}" class="brew-guide-filters__option{% if selected_coffee_type == option_handle %} is-active{% endif %}"{% if selected_coffee_type == option_handle %} aria-current="page"{% endif %}>{{ option_label }}</a>
          {% endfor %}
        </div>
        <div class="brew-guide-filters__group">
          <span class="brew-guide-filters__label">Brew method</span>
          {% assign method_all_url = blog.url %}
          {% if selected_coffee_type != blank %}
            {% assign method_all_url = blog.url | append: '/tagged/' | append: selected_coffee_type %}
          {% endif %}
          <a href="{{ method_all_url }}" class="brew-guide-filters__option{% if selected_brew_method == blank %} is-active{% endif %}"{% if selected_brew_method == blank %} aria-current="page"{% endif %}>All</a>
          {% assign method_options = 'brew-method-espresso:Espresso|brew-method-moka-pot:Moka Pot|brew-method-aeropress:Aeropress|brew-method-pour-over:Pour Over' | split: '|' %}
          {% for option in method_options %}
            {% assign option_parts = option | split: ':' %}
            {% assign option_handle = option_parts[0] %}
            {% assign option_label = option_parts[1] %}
            {% assign option_url = blog.url | append: '/tagged/' | append: option_handle %}
            {% if selected_coffee_type != blank %}
              {% assign option_url = blog.url | append: '/tagged/' | append: selected_coffee_type | append: '+' | append: option_handle %}
            {% endif %}
            <a href="{{ option_url }}" class="brew-guide-filters__option{% if selected_brew_method == option_handle %} is-active{% endif %}"{% if selected_brew_method == option_handle %} aria-current="page"{% endif %}>{{ option_label }}</a>
          {% endfor %}
        </div>
        <span class="brew-guide-filters__count">{{ paginate.items }} guides</span>
      </nav>
    {% endif %}
    <div
      ref="grid"
      class="blog-posts-container blog-posts-container--{{ section.settings.card_layout | default: 'featured' }}"
    >
      {% liquid
        assign items_on_page = blog.articles.size
      %}
      {% for article in blog.articles %}
        {% liquid
          # Defaults for compact layout
          assign col_span = 2
          assign scale = 0.6
          assign is_horizontal = false

          # A catalogue, not a journal: every card the same size, like a
          # collection grid. `brewguides` carries 747 articles, and the
          # featured sizing below turns that into a mosaic.
          assign uniform = false
          if section.settings.card_layout == 'uniform'
            assign uniform = true
            assign col_span = 2
            assign scale = 1
          endif

          unless uniform
          case items_on_page
            when 1
              # Single post: full width hero
              assign col_span = 6
              assign scale = 1
              assign is_horizontal = true
            when 2
              # Two posts: both standard side by side
              assign col_span = 3
              assign scale = 0.8
            when 3
              # Three posts: hero + 2 standard
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            when 4
              # Four posts: all standard in 2x2 grid
              assign col_span = 3
              assign scale = 0.8
            when 5
              # Five posts: hero + 4 standard
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            else
              # 6+ posts: hero, 2 standard, rest compact
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              elsif forloop.index <= 3
                assign col_span = 3
                assign scale = 0.8
              else
                assign col_span = 2
                assign scale = 0.6
              endif
          endcase
          endunless
        %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: {{ scale }};
          }

          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 0.5;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item{% if is_horizontal %} blog-post-item--horizontal{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>

    {% render 'pagination-controls', paginate: paginate %}
    {% endpaginate %}
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * Blog post item grid positioning and scaling.
   * Layout is calculated in Liquid based on total article count.
   * Mobile overrides are applied per-item in inline styles for proper specificity.
   */
  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  /*
   * The cropping itself is Victor's, in blocks/_blog-post-image.liquid (#214):
   * an `image_fit` setting whose `contain` option stops a portrait bag being
   * decapitated by `object-fit: cover` in a fixed-height frame. This template
   * turns it on rather than restating the rule here -- one owner for that
   * decision, and it stays editable in the theme editor.
   *
   * The hero variant is a journal device; a catalogue row is never horizontal.
   */
  .blog-posts-container--uniform .blog-post-item--horizontal {
    display: block;
  }

  .blog-posts--brewguides {
    --page-content-width: var(--normal-page-width);
    --columns-gap: 28px;
    --rows-gap: 54px;
  }

  .brew-guide-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block-start: 54px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brew-guide-breadcrumb a {
    color: currentColor;
    text-decoration: none;
  }

  .brew-guide-breadcrumb a:hover {
    text-decoration: underline;
  }

  .brew-guide-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin-block: 0 44px;
    padding-block: 12px;
    border-block: 1px solid currentColor;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .brew-guide-filters__group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .brew-guide-filters__label {
    margin-inline-end: 2px;
    white-space: nowrap;
  }

  .brew-guide-filters__option {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding-inline: 12px;
    border: 1px solid currentColor;
    color: currentColor;
    text-decoration: none;
    white-space: nowrap;
  }

  .brew-guide-filters__option:hover,
  .brew-guide-filters__option.is-active {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .brew-guide-filters__count {
    margin-inline-start: auto;
    white-space: nowrap;
  }

  .blog-posts--brewguides .blog-posts-container {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .blog-posts--brewguides .blog-post-item {
    grid-column: span 1;
  }

  .blog-posts--brewguides .blog-post-card__image {
    height: 214px;
  }

  @media screen and (max-width: 749px) {
    .blog-posts--brewguides {
      --columns-gap: 14px;
      --rows-gap: 32px;
    }

    .brew-guide-breadcrumb {
      padding-block-start: 28px;
    }

    .brew-guide-filters {
      gap: 12px;
      margin-block-end: 28px;
    }

    .brew-guide-filters__group {
      width: 100%;
    }

    .brew-guide-filters__count {
      margin-inline-start: 0;
    }

    .blog-posts--brewguides .blog-posts-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .blog-posts--brewguides .blog-post-card__image {
      height: 170px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24,
      "info": "Liquid caps an unpaginated blog at 50 articles and ignores the page parameter, so this must stay set."
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Card layout",
      "info": "Uniform shows every article at the same size with the whole image visible, like a collection grid.",
      "options": [
        { "value": "featured", "label": "Featured (hero + mixed sizes)" },
        { "value": "uniform", "label": "Uniform grid" }
      ],
      "default": "featured"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
