<script src="{{ 'ona-faqs.js' | asset_url }}" type="module"></script>
<section class="add-faqs-section " id="{{ section.settings.id }}">
    <div class="container">
        <div class="title">
            <h2>{{ section.settings.title2 }}</h2>
        </div>
        <div class="add-faqs">
        {% for block in section.blocks %}
          <div class="block is-active">
              <div class="faqs-title {% if forloop.index == 1 %}is-active{% endif %}">
{%- comment -%} A button, so the row can be focused and pressed. {%- endcomment -%}
<button type="button" class="faqs-toggle" aria-expanded="{% if forloop.index == 1 %}true{% else %}false{% endif %}">{{ block.settings.title }}</button>
</div>
              <div class="faqs-text {% if forloop.index == 1 %}is-active{% endif %}">
                  {{ block.settings.content }}
              </div>
          </div>
        {% endfor %}
        </div>
        <div class="end-text">
            {{ section.settings.tips }}
        </div>
    </div>
</section>
{% stylesheet %}
  /*
   * The collapse lives with the section, not in legacy-page-layout.css.
   *
   * That stylesheet is loaded only for a fixed list of page suffixes in
   * layout/theme.liquid, but this section has a preset, so it can be added to
   * any JSON template. Where the sheet is absent the script would still toggle
   * `is-active` while nothing hid or revealed the answer -- every answer open
   * and clicks apparently doing nothing. Codex, #218.
   */
  .add-faqs .faqs-text { display: none; }
  .add-faqs .faqs-text.is-active { display: block; }

  /* `button` takes the UA font unless told otherwise. */
  .add-faqs .faqs-toggle {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .add-faqs .faqs-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* Closing "Need help?" call-out. It sat small and flush-left against the
     footer; centre it with room to breathe and make the contact address read
     as a clear link. */
  #MainContent .add-faqs-section .end-text {
    margin-block-start: clamp(40px, 6vw, 80px);
    padding-block: clamp(40px, 6vw, 72px);
    text-align: center;
  }

  /* On a page with no FAQ rows (e.g. /pages/wholesale), this section is just the
     "Need help?" heading and the contact line, so centre the whole thing as one
     call-out. Pages that do have questions keep their left-aligned title. */
  #MainContent .add-faqs-section:not(:has(.faqs-toggle)) .title { text-align: center; }
  #MainContent .add-faqs-section:not(:has(.faqs-toggle)) .end-text {
    margin-block-start: clamp(16px, 2vw, 28px);
    padding-block-start: 0;
  }

  #MainContent .add-faqs-section .end-text > :first-child { margin-block-start: 0; }
  #MainContent .add-faqs-section .end-text > :last-child { margin-block-end: 0; }

  #MainContent .add-faqs-section .end-text :is(h2, h3, h4) {
    font-family: var(--font-heading--family, serif);
    font-size: var(--font-h2--size, 3rem);
    line-height: 1.12;
    margin: 0 0 12px;
  }

  #MainContent .add-faqs-section .end-text p {
    max-inline-size: 48ch;
    margin-inline: auto;
    font-size: var(--font-paragraph--size, 1rem);
    line-height: 1.6;
  }

  #MainContent .add-faqs-section .end-text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    font-weight: 600;
  }
  #MainContent .add-faqs-section .end-text a:hover { text-decoration-thickness: 2px; }
{% endstylesheet %}

{% schema %}
{
  "name": {
    "en": "FAQ list"
  },
  "settings": [
    {
      "type": "text",
      "id": "id",
      "label": {
        "en": "ID"
      }
    },
    {
      "type": "text",
      "id": "title2",
      "label": {
		"en": "Title"
      }
    },
    {
      "type": "richtext",
      "id": "tips",
      "label": {
		"en": "Tips"
      }
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": {
        "en": "Block"
      },
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": {
            "en": "Title"
          }
        },
        {
          "type": "richtext",
          "id": "content",
          "label": {
            "en": "Content"
          }
        }
      ]
    }
  ],
  "presets": [
    {
      "name": {
        "en": "FAQ list"
      },
      "category": {
        "en": "Text"
      }
    }
  ]
}
{% endschema %}
