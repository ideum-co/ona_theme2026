{%- comment -%}
  ONA BFCM landing page.

  Rewritten after Macarena/Sarah's feedback (13 Nov 2026):

  * No "early access" or "exclusive" anywhere — the sale opens to everyone on
    Sat 21 Nov, so the copy and the countdown target say so.
  * Hero is a full-width typographic banner, cream on burgundy. The old blobs
    (burgundy + pink circles, legacy branding), the extra ONA logo and the
    espresso photo are gone. `lettering_image` is an optional slot for Sarah's
    "Sale" script art — drop it in and it replaces the typeset title, no deploy.
  * The countdown is the homepage flip-card look (cream cards, dark frame, the
    split line), centred, on the same burgundy as the homepage banner, with the
    Sign up / Shop buttons centred under it.
  * It is one block, in the order Macarena drew: banner → dates → status →
    countdown → one-line pitch → email + Sign up. The old separate "Stay in the
    loop" section is folded in here, and the footer's duplicate is hidden on
    this template (see the stylesheet).
  * Phase switch: before the 21st the clock counts to the start and says
    "Starts in" with Sign up as the primary button. Once the sale opens the
    clock counts to the end and says "Ends in", and "Shop sale" becomes primary.
    `assets/bfcm-countdown.js` writes the phase onto [data-bfcm-root]; the CSS
    does the rest. It stays a COPY of the homepage date engine, never a shared
    mutation — WFG and the homepage banner keep their own.
  * Below: a grid of what's on sale (editable collection), a compact category
    row, and a short FAQ. The old day-by-day schedule is gone — it read as
    placeholder and gave no reason to come back.

  Title, dates and the countdown are all editable fields, so the page can be
  made generic after the campaign without a rebuild.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sale_collection = s.products_collection
  if sale_collection == blank
    assign sale_collection = collections['all']
  endif
  assign shop_url = sale_collection.url | default: '/collections/all'
-%}

<script src="{{ 'bfcm-countdown.js' | asset_url }}" type="module"></script>

<div
  class="bfcm-landing spacing-style"
  data-bfcm-root
  data-phase="before"
  style="
    --bfcm-wine: {{ s.band_color | default: '#441925' }};
    --bfcm-cream: #f4f3e9;
    --bfcm-card-bg: #f2f0eb;
    --bfcm-card-ink: {{ s.band_color | default: '#441925' }};
    --bfcm-frame: #000000;
  "
  {{ section.shopify_attributes }}
>
  <section class="bfcm-landing__hero" aria-labelledby="bfcm-landing-title-{{ section.id }}">
    <div class="bfcm-landing__hero-inner">
      {%- if s.lettering_image != blank -%}
        {{
          s.lettering_image
          | image_url: width: 1120
          | image_tag:
            widths: '420, 560, 840, 1120',
            sizes: '(min-width: 750px) 560px, 80vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'bfcm-landing__lettering',
            alt: s.title
        }}
        <h1 id="bfcm-landing-title-{{ section.id }}" class="visually-hidden">
          {{ s.title | escape }} {{ s.title_emphasis | escape }}
        </h1>
      {%- else -%}
        <h1 id="bfcm-landing-title-{{ section.id }}" class="bfcm-landing__title">
          {{ s.title | escape }}
          {%- if s.title_emphasis != blank %} <em>{{ s.title_emphasis | escape }}</em>{% endif -%}
        </h1>
      {%- endif -%}

      {%- if s.date_line != blank -%}
        <p class="bfcm-landing__dates">{{ s.date_line | escape }}</p>
      {%- endif -%}

      <bfcm-countdown
        class="bfcm-landing__countdown"
        data-start-at="{{ s.countdown_start_at | escape }}"
        data-end-at="{{ s.countdown_end_at | escape }}"
        data-label-before="{{ s.label_before | escape }}"
        data-label-live="{{ s.label_live | escape }}"
        data-label-ended="{{ s.label_ended | escape }}"
        data-text-ended="{{ s.text_ended | escape }}"
      >
        <span class="bfcm-landing__status" data-countdown-status>{{ s.label_before | escape }}</span>
        <div
          class="bfcm-landing__clock"
          role="timer"
          aria-live="off"
          aria-label="{{ s.clock_label | escape }}"
          data-countdown-clock
          hidden
        >
          <span class="bfcm-landing__unit">
            <span class="bfcm-landing__cards"><span class="bfcm-landing__card"><span data-countdown-days>00</span></span></span>
            <span class="bfcm-landing__unit-label">{{ s.label_days | escape }}</span>
          </span>
          <span class="bfcm-landing__separator" aria-hidden="true">:</span>
          <span class="bfcm-landing__unit">
            <span class="bfcm-landing__cards"><span class="bfcm-landing__card"><span data-countdown-hours>00</span></span></span>
            <span class="bfcm-landing__unit-label">{{ s.label_hours | escape }}</span>
          </span>
          <span class="bfcm-landing__separator" aria-hidden="true">:</span>
          <span class="bfcm-landing__unit">
            <span class="bfcm-landing__cards"><span class="bfcm-landing__card"><span data-countdown-minutes>00</span></span></span>
            <span class="bfcm-landing__unit-label">{{ s.label_minutes | escape }}</span>
          </span>
          <span class="bfcm-landing__separator" aria-hidden="true">:</span>
          <span class="bfcm-landing__unit">
            <span class="bfcm-landing__cards"><span class="bfcm-landing__card"><span data-countdown-seconds>00</span></span></span>
            <span class="bfcm-landing__unit-label">{{ s.label_seconds | escape }}</span>
          </span>
        </div>
        <p class="bfcm-landing__fallback" data-countdown-fallback>{{ s.date_line | escape }}</p>
      </bfcm-countdown>

      {%- if s.signup_pitch != blank -%}
        <p class="bfcm-landing__pitch">{{ s.signup_pitch | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'bfcm-landing__form' -%}
        {%- comment -%} Hard-coded, not a setting: it must stay identical to the homepage banner's signup_tag so both surfaces build ONE list. {%- endcomment -%}
        <input type="hidden" name="contact[tags]" value="BFCM 2026">
        <label class="visually-hidden" for="bfcm-landing-email-{{ section.id }}">{{ 'blocks.email_signup.label' | t }}</label>
        <div class="bfcm-landing__form-row">
          <input
            id="bfcm-landing-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
            autocomplete="email"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="bfcm-landing-error-{{ section.id }}"{% endif %}
          >
          <button type="submit">{{ 'actions.sign_up' | t }}</button>
        </div>
        {%- if form.errors -%}
          <div id="bfcm-landing-error-{{ section.id }}" class="bfcm-landing__form-message" role="alert">{{ form.errors | default_errors }}</div>
        {%- elsif form.posted_successfully? -%}
          <p class="bfcm-landing__form-message" role="status">{{ 'blocks.email_signup.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}

      <div class="bfcm-landing__actions">
        <a class="bfcm-landing__button bfcm-landing__button--shop" href="{{ shop_url }}">
          <span class="bfcm-landing__shop-before">{{ s.shop_label | escape }}</span>
          <span class="bfcm-landing__shop-live">{{ s.shop_label_live | escape }}</span>
        </a>
      </div>
    </div>
  </section>

  {%- assign sale_products = sale_collection.products -%}
  {%- if sale_products.size > 0 -%}
    <section class="bfcm-landing__products" aria-labelledby="bfcm-landing-products-{{ section.id }}">
      {%- if s.products_heading != blank -%}
        <h2 id="bfcm-landing-products-{{ section.id }}" class="bfcm-landing__section-title">{{ s.products_heading | escape }}</h2>
      {%- endif -%}
      <ul class="bfcm-landing__grid" role="list">
        {%- for product in sale_products limit: s.products_count -%}
          <li class="bfcm-landing__grid-item">
            {%- comment -%}
              The site-wide product card (image + info + actions). Rendered the
              same way the homepage spotlight and the collection pages do it: a
              static `_product-card` that self-populates its full child tree
              (gallery, title, price, buy-buttons / quick add) from the product.
            {%- endcomment -%}
            {%- content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'collection'
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {%- assign has_links = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'collection_link' and block.settings.label != blank and block.settings.link != blank -%}
      {%- assign has_links = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if has_links -%}
    <nav class="bfcm-landing__collections" aria-label="Shop by collection">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_link' and block.settings.label != blank and block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- assign has_faq = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'faq' and block.settings.question != blank -%}
      {%- assign has_faq = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if has_faq -%}
    <section class="bfcm-landing__faq" aria-labelledby="bfcm-landing-faq-{{ section.id }}">
      {%- if s.faq_heading != blank -%}
        <h2 id="bfcm-landing-faq-{{ section.id }}" class="bfcm-landing__section-title">{{ s.faq_heading | escape }}</h2>
      {%- endif -%}
      <dl class="bfcm-landing__faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' and block.settings.question != blank -%}
            <div class="bfcm-landing__faq-item" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.question | escape }}</dt>
              <dd>{{ block.settings.answer }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .bfcm-landing {
    --bfcm-page-inset: max(var(--page-margin, 16px), calc((100vw - var(--page-content-width, 90rem)) / 2));
    color: var(--bfcm-card-ink, #441925);
    background: var(--bfcm-cream, #f4f3e9);
    font-family: var(--font-brand-text, 'Karla', sans-serif);
  }
  .bfcm-landing * { box-sizing: border-box; }

  /* Hide the footer's duplicate "Stay in the loop" form on this template only.
     The landing page already carries the single canonical sign-up above. */
  body:has(.bfcm-landing) .email-signup-block { display: none !important; }

  /* ---- Hero band: full-width, cream on burgundy, centred ---- */
  .bfcm-landing__hero { background: var(--bfcm-wine, #441925); color: var(--bfcm-cream, #f4f3e9); }
  .bfcm-landing__hero-inner {
    max-width: 60rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(20px, 3vw, 34px);
    padding-block: clamp(56px, 7vw, 120px);
    padding-inline: var(--page-margin, 16px);
  }
  .bfcm-landing__lettering { display: block; width: min(560px, 82%); height: auto; }
  .bfcm-landing__title {
    font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif);
    font-size: clamp(52px, 8vw, 118px);
    line-height: 0.92;
    font-weight: 400;
    letter-spacing: 0;
    margin: 0;
    text-wrap: balance;
  }
  .bfcm-landing__title em { font-style: italic; }
  .bfcm-landing__dates {
    font-family: var(--font-brand-text, 'Karla', sans-serif);
    font-size: clamp(18px, 2.4vw, 30px);
    letter-spacing: 0.04em;
    margin: 0;
    color: var(--bfcm-cream, #f4f3e9);
  }

  /* ---- Countdown (homepage flip-card look) ---- */
  .bfcm-landing__countdown { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-block-start: 6px; }
  .bfcm-landing__status { font-size: clamp(12px, 1vw, 15px); letter-spacing: 0.14em; text-transform: uppercase; }
  .bfcm-landing__clock {
    --d: clamp(24px, 6vw, 60px);
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(6px, 1.4vw, 14px);
    max-width: 100%;
  }
  .bfcm-landing__clock[hidden], .bfcm-landing__fallback[hidden] { display: none; }
  .bfcm-landing__unit { display: inline-flex; flex-direction: column; align-items: center; gap: 10px; }
  .bfcm-landing__cards {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--bfcm-frame, #000);
    border-radius: 12px;
    padding: 11px 12px;
  }
  .bfcm-landing__card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--d, 60px) * 142 / 83);
    height: calc(var(--d, 60px) * 92 / 83);
    background: var(--bfcm-card-bg, #f2f0eb);
    font-family: var(--font-brand-text, 'Karla', sans-serif);
    font-size: var(--d, 60px);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--bfcm-card-ink, #441925);
  }
  .bfcm-landing__card::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 100%;
    height: 4px;
    background: var(--bfcm-card-ink, #441925);
    pointer-events: none;
    z-index: 1;
  }
  .bfcm-landing__separator {
    display: flex;
    align-items: center;
    height: calc(var(--d, 60px) * 92 / 83 + 22px);
    font-size: calc(var(--d, 60px) * 0.5);
    font-weight: 700;
    line-height: 1;
    color: var(--bfcm-cream, #f4f3e9);
  }
  .bfcm-landing__unit-label { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .bfcm-landing__fallback {
    margin: 0;
    font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif);
    font-size: clamp(22px, 2vw, 34px);
    line-height: 1.1;
  }

  /* ---- Pitch + sign-up + buttons (centred) ---- */
  .bfcm-landing__pitch {
    margin: 4px 0 0;
    font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif);
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.15;
    max-width: 30ch;
  }
  .bfcm-landing__form { display: grid; gap: 9px; width: min(460px, 100%); }
  .bfcm-landing__form-row { display: flex; gap: 10px; }
  .bfcm-landing__form input {
    min-width: 0; flex: 1; min-height: 50px; border: 0; border-radius: 0;
    padding: 10px 14px; background: var(--bfcm-cream, #f4f3e9); color: var(--bfcm-card-ink, #441925); font: inherit;
  }
  .bfcm-landing__form button {
    min-height: 50px; border: 2px solid var(--bfcm-cream, #f4f3e9); border-radius: 0;
    padding: 10px 22px; background: var(--bfcm-cream, #f4f3e9); color: var(--bfcm-wine, #441925);
    font: inherit; font-weight: 700; cursor: pointer;
  }
  .bfcm-landing__form-message { font-size: 13px; margin: 0; color: var(--bfcm-cream, #f4f3e9); }
  .bfcm-landing__actions { display: flex; justify-content: center; }
  .bfcm-landing__button {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 10px 26px; text-decoration: none;
    font-size: 16px; font-weight: 700; line-height: 1.2; text-align: center;
  }
  /* Before the sale the shop link is the secondary (outlined) action; Sign up leads. */
  .bfcm-landing__button--shop { box-shadow: inset 0 0 0 2px var(--bfcm-cream, #f4f3e9); color: var(--bfcm-cream, #f4f3e9); background: transparent; }
  .bfcm-landing__shop-live { display: none; }

  /* Once the sale is live, "Shop sale" becomes primary and Sign up steps back. */
  .bfcm-landing[data-phase='live'] .bfcm-landing__button--shop { box-shadow: none; background: var(--bfcm-cream, #f4f3e9); color: var(--bfcm-wine, #441925); }
  .bfcm-landing[data-phase='live'] .bfcm-landing__shop-before { display: none; }
  .bfcm-landing[data-phase='live'] .bfcm-landing__shop-live { display: inline; }
  .bfcm-landing[data-phase='live'] .bfcm-landing__form button { background: transparent; color: var(--bfcm-cream, #f4f3e9); }

  .bfcm-landing__button:hover, .bfcm-landing__form button:hover { opacity: 0.85; }
  .bfcm-landing__button:focus-visible,
  .bfcm-landing a:focus-visible,
  .bfcm-landing button:focus-visible,
  .bfcm-landing input:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }

  /* ---- Featured sale products ---- */
  .bfcm-landing__section-title {
    margin: 0 0 clamp(24px, 3vw, 40px);
    font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif);
    font-size: clamp(28px, 2.6vw, 46px);
    font-weight: 400;
    line-height: 1.05;
    text-align: center;
  }
  .bfcm-landing__products { padding: clamp(48px, 5vw, 92px) var(--bfcm-page-inset); }
  .bfcm-landing__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 30px); list-style: none; margin: 0; padding: 0; }
  .bfcm-landing__grid-item { min-width: 0; display: flex; }
  .bfcm-landing__grid-item > product-card { width: 100%; }

  /* ---- Compact category row ---- */
  .bfcm-landing__collections {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
    padding: 0 var(--bfcm-page-inset) clamp(48px, 5vw, 84px);
  }
  .bfcm-landing__collections a {
    display: inline-flex; align-items: center; min-height: 38px; padding: 8px 16px;
    box-shadow: inset 0 0 0 1px var(--bfcm-card-ink, #441925); color: var(--bfcm-card-ink, #441925);
    font-size: 14px; text-decoration: none;
  }
  .bfcm-landing__collections a:hover { background: var(--bfcm-wine, #441925); color: var(--bfcm-cream, #f4f3e9); box-shadow: none; }

  /* ---- FAQ ---- */
  .bfcm-landing__faq { padding: clamp(50px, 5vw, 92px) var(--bfcm-page-inset); border-top: 1px solid var(--bfcm-card-ink, #441925); }
  .bfcm-landing__faq-list { display: grid; gap: 0; margin: 0; }
  .bfcm-landing__faq-item { display: grid; gap: 8px; padding-block: clamp(20px, 2vw, 28px); }
  .bfcm-landing__faq-item + .bfcm-landing__faq-item { border-top: 1px solid rgba(68, 25, 37, 0.18); }
  .bfcm-landing__faq-item dt { font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif); font-size: clamp(19px, 1.6vw, 26px); }
  .bfcm-landing__faq-item dd { margin: 0; font-size: 16px; line-height: 1.55; max-width: 62ch; }

  @media (max-width: 989px) {
    .bfcm-landing__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    .bfcm-landing__clock { --d: clamp(22px, 7vw, 46px); gap: 5px; }
    .bfcm-landing__cards { padding: 7px 8px; }
    .bfcm-landing__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 440px) {
    .bfcm-landing__form-row { flex-direction: column; }
    .bfcm-landing__grid { grid-template-columns: 1fr 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ONA BFCM landing",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "color", "id": "band_color", "label": "Band background", "default": "#441925", "info": "Match the homepage countdown background." },
    { "type": "image_picker", "id": "lettering_image", "label": "Sale lettering image", "info": "Optional. Campaign 'Sale' script art (SVG or 2x PNG on transparent). Replaces the typeset title when set." },
    { "type": "text", "id": "title", "label": "Title", "default": "Black Friday" },
    { "type": "text", "id": "title_emphasis", "label": "Italic title word", "default": "Sale" },
    { "type": "text", "id": "date_line", "label": "Dates", "default": "21–27 November 2026" },
    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "countdown_start_at", "label": "Sale starts (ISO 8601)", "default": "2026-11-21T00:00:00+11:00", "info": "Needs a full date, time AND offset for Sydney (+11:00 in November). Before this, the clock counts down to it." },
    { "type": "text", "id": "countdown_end_at", "label": "Sale ends (ISO 8601)", "default": "2026-11-28T00:00:00+11:00", "info": "Once the sale is live the clock counts down to this instead." },
    { "type": "text", "id": "label_before", "label": "Status before it starts", "default": "Starts in" },
    { "type": "text", "id": "label_live", "label": "Status while it is on", "default": "Ends in" },
    { "type": "text", "id": "label_ended", "label": "Status after it ends", "default": "That's a wrap" },
    { "type": "text", "id": "text_ended", "label": "Line after it ends", "default": "Shop the latest ONA coffees." },
    { "type": "text", "id": "clock_label", "label": "Screen-reader label for the clock", "default": "Time remaining in the Black Friday sale" },
    { "type": "text", "id": "label_days", "label": "Unit label: days", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Unit label: hours", "default": "Hours" },
    { "type": "text", "id": "label_minutes", "label": "Unit label: minutes", "default": "Mins" },
    { "type": "text", "id": "label_seconds", "label": "Unit label: seconds", "default": "Secs" },
    { "type": "header", "content": "Sign up" },
    { "type": "text", "id": "signup_pitch", "label": "Pitch line", "default": "Seven days of savings. Sign up for sale updates." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "shop_label", "label": "Shop button (before sale)", "default": "Shop coffees" },
    { "type": "text", "id": "shop_label_live", "label": "Shop button (during sale)", "default": "Shop sale" },
    { "type": "collection", "id": "products_collection", "label": "Sale collection", "info": "Products shown in the grid and the target of the Shop button. Defaults to all coffee until set." },
    { "type": "header", "content": "Featured products" },
    { "type": "text", "id": "products_heading", "label": "Heading", "default": "On sale now" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 4, "max": 8, "step": 1, "default": 8 },
