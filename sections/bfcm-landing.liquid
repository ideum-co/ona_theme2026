<div class="bfcm-landing" {{ section.shopify_attributes }}>
  <section class="bfcm-landing__hero" aria-labelledby="bfcm-landing-title-{{ section.id }}">
    <div class="bfcm-landing__hero-copy">
      <div class="bfcm-landing__hero-content">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 160 | image_tag: width: 64, class: 'bfcm-landing__mark', alt: 'ONA Coffee' }}
        {%- else -%}
          <span class="bfcm-landing__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h1 id="bfcm-landing-title-{{ section.id }}" class="bfcm-landing__title">
          {{ section.settings.title | escape }}<br>
          <em>{{ section.settings.title_emphasis | escape }}</em>
        </h1>
        <p class="bfcm-landing__date">{{ section.settings.date_line | escape }}</p>
      </div>
    </div>
    <div class="bfcm-landing__hero-media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'bfcm-landing__hero-image'
        }}
      {%- else -%}
        <img
          class="bfcm-landing__hero-image"
          src="https://cdn.shopify.com/s/files/1/0464/4824/6934/files/Espresso_web.png?width=1800"
          alt="ONA espresso coffee"
          width="1800"
          height="1200"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  </section>

  <div class="bfcm-landing__intro">
    <div>
      <span class="bfcm-landing__eyebrow">{{ section.settings.intro_eyebrow | escape }}</span>
      <p>{{ section.settings.intro_text | escape }}</p>
    </div>
    <div class="bfcm-landing__actions">
      <a class="bfcm-landing__button bfcm-landing__button--light" href="#bfcm-landing-signup-{{ section.id }}">{{ section.settings.signup_label | escape }}</a>
      <a class="bfcm-landing__button bfcm-landing__button--outline" href="/collections/all">{{ section.settings.shop_label | escape }}</a>
    </div>
  </div>

  <section id="bfcm-landing-signup-{{ section.id }}" class="bfcm-landing__signup" aria-labelledby="bfcm-landing-signup-title-{{ section.id }}">
    <div>
      <span class="bfcm-landing__eyebrow">{{ section.settings.signup_eyebrow | escape }}</span>
      <h2 id="bfcm-landing-signup-title-{{ section.id }}">{{ section.settings.signup_heading | escape }}</h2>
    </div>
    {%- form 'customer', class: 'bfcm-landing__form' -%}
      <input type="hidden" name="contact[tags]" value="BFCM 2026">
      <label for="bfcm-landing-email-{{ section.id }}">{{ 'blocks.email_signup.label' | t }}</label>
      <div class="bfcm-landing__form-row">
        <input
          id="bfcm-landing-email-{{ section.id }}"
          type="email"
          name="contact[email]"
          placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
          autocomplete="email"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="bfcm-landing-error-{{ section.id }}"{% endif %}
        >
        <button type="submit">{{ 'actions.sign_up' | t }}</button>
      </div>
      {%- if form.errors -%}
        <div id="bfcm-landing-error-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>
      {%- elsif form.posted_successfully? -%}
        <p role="status">{{ 'blocks.email_signup.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </section>

  {%- if section.blocks.size > 0 -%}
    <nav class="bfcm-landing__collections" aria-label="Shop by collection">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank and block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <section class="bfcm-landing__schedule" aria-labelledby="bfcm-landing-schedule-title-{{ section.id }}">
    <div class="bfcm-landing__schedule-head">
      <span class="bfcm-landing__eyebrow">{{ section.settings.schedule_eyebrow | escape }}</span>
      <h2 id="bfcm-landing-schedule-title-{{ section.id }}">{{ section.settings.schedule_heading | escape }}</h2>
    </div>
    <ol>
      <li><time datetime="2026-11-27">Fri 27 Nov</time><span>Black Friday</span></li>
      <li><time datetime="2026-11-28">Sat 28 Nov</time><span>Weekend</span></li>
      <li><time datetime="2026-11-29">Sun 29 Nov</time><span>Weekend</span></li>
      <li><time datetime="2026-11-30">Mon 30 Nov</time><span>Cyber Monday</span></li>
    </ol>
    <a class="bfcm-landing__button bfcm-landing__button--wine" href="/collections/all">{{ section.settings.shop_label | escape }}</a>
  </section>
</div>

{% stylesheet %}
  .bfcm-landing {
    --bfcm-cream: #f4f3e9;
    --bfcm-ink: #470a12;
    --bfcm-wine: #751132;
    --bfcm-rose: #d67ba6;
    color: var(--bfcm-ink);
    background: var(--bfcm-cream);
    font-family: var(--font-brand-text, 'Karla', sans-serif);
  }
  .bfcm-landing * { box-sizing: border-box; }
  .bfcm-landing__hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: min(46vw, 860px); }
  .bfcm-landing__hero-copy { position: relative; display: flex; align-items: center; overflow: hidden; padding: clamp(48px, 5.2vw, 100px) clamp(20px, 4.6vw, 88px); }
  .bfcm-landing__hero-copy::before, .bfcm-landing__hero-copy::after { content: ''; position: absolute; border-radius: 50%; pointer-events: none; }
  .bfcm-landing__hero-copy::before { width: min(42vw, 520px); aspect-ratio: 1; background: var(--bfcm-wine); left: -18%; bottom: -50%; }
  .bfcm-landing__hero-copy::after { width: min(34vw, 420px); aspect-ratio: 1; background: var(--bfcm-rose); left: 28%; bottom: -54%; opacity: .9; }
  .bfcm-landing__hero-content { position: relative; z-index: 1; padding-bottom: clamp(90px, 10vw, 190px); }
  .bfcm-landing__mark { display: block; width: 64px; height: auto; margin-bottom: 26px; }
  .bfcm-landing__eyebrow, .bfcm-landing__date { font-size: clamp(12px, .95vw, 17px); letter-spacing: .08em; text-transform: uppercase; }
  .bfcm-landing__title { font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif); font-size: clamp(48px, 4.7vw, 90px); line-height: .98; font-weight: 400; letter-spacing: 0; margin: 18px 0 22px; }
  .bfcm-landing__title em { font-weight: 400; }
  .bfcm-landing__date { margin: 0; }
  .bfcm-landing__hero-media { position: relative; min-height: 420px; }
  .bfcm-landing__hero-image { display: block; width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; }
  .bfcm-landing__intro { background: var(--bfcm-ink); color: var(--bfcm-cream); display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: clamp(36px, 3.3vw, 60px) clamp(20px, 4.6vw, 88px); }
  .bfcm-landing__intro p { margin: 10px 0 0; font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif); font-size: clamp(24px, 2vw, 38px); line-height: 1.1; }
  .bfcm-landing__actions { display: flex; flex-wrap: wrap; gap: 10px; flex-shrink: 0; }
  .bfcm-landing__button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 10px 24px; text-decoration: none; font-size: 16px; line-height: 1.2; text-align: center; }
  .bfcm-landing__button--light { background: var(--bfcm-cream); color: var(--bfcm-ink); }
  .bfcm-landing__button--outline { box-shadow: inset 0 0 0 1px var(--bfcm-cream); color: var(--bfcm-cream); }
  .bfcm-landing__button--wine { background: var(--bfcm-wine); color: var(--bfcm-cream); }
  .bfcm-landing__button:hover { opacity: .85; }
  .bfcm-landing__button:focus-visible, .bfcm-landing a:focus-visible, .bfcm-landing button:focus-visible, .bfcm-landing input:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  .bfcm-landing__signup { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 30px 70px; padding: clamp(48px, 4.2vw, 80px) clamp(20px, 4.6vw, 88px); background: var(--bfcm-wine); color: var(--bfcm-cream); }
  .bfcm-landing__signup h2, .bfcm-landing__schedule h2 { margin: 12px 0 0; font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif); font-size: clamp(30px, 2.2vw, 42px); font-weight: 400; line-height: 1.1; }
  .bfcm-landing__form { display: grid; gap: 9px; }
  .bfcm-landing__form label { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .bfcm-landing__form-row { display: flex; gap: 10px; }
  .bfcm-landing__form input { min-width: 0; flex: 1; min-height: 50px; border: 0; border-radius: 0; padding: 10px 14px; background: var(--bfcm-cream); color: var(--bfcm-ink); font: inherit; }
  .bfcm-landing__form button { min-height: 50px; border: 0; border-radius: 0; padding: 10px 22px; background: var(--bfcm-cream); color: var(--bfcm-wine); font: inherit; cursor: pointer; }
  .bfcm-landing__collections { display: flex; flex-wrap: wrap; gap: 8px; padding: clamp(40px, 3.6vw, 64px) clamp(20px, 4.6vw, 88px); border-bottom: 1px solid var(--bfcm-ink); }
  .bfcm-landing__collections a { display: inline-flex; align-items: center; min-height: 38px; padding: 8px 16px; box-shadow: inset 0 0 0 1px var(--bfcm-ink); color: var(--bfcm-ink); font-size: 14px; text-decoration: none; }
  .bfcm-landing__collections a:hover { background: var(--bfcm-wine); color: var(--bfcm-cream); box-shadow: none; }
  .bfcm-landing__schedule { padding: clamp(50px, 5vw, 90px) clamp(20px, 4.6vw, 88px); }
  .bfcm-landing__schedule ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 38px 0; padding: 0; border-top: 1px solid var(--bfcm-ink); border-bottom: 1px solid var(--bfcm-ink); }
  .bfcm-landing__schedule li { display: grid; gap: 10px; padding: 25px 16px 30px; }
  .bfcm-landing__schedule li + li { border-left: 1px solid var(--bfcm-ink); }
  .bfcm-landing__schedule time { font-size: 13px; letter-spacing: .07em; text-transform: uppercase; }
  .bfcm-landing__schedule li span { font-family: var(--font-brand-display, 'Silk Serif', Georgia, serif); font-size: clamp(23px, 2vw, 36px); }
  @media (max-width: 749px) {
    .bfcm-landing__hero, .bfcm-landing__signup { grid-template-columns: 1fr; }
    .bfcm-landing__hero-copy { min-height: 440px; }
    .bfcm-landing__hero-copy::before { width: 360px; bottom: -260px; }
    .bfcm-landing__hero-copy::after { width: 280px; bottom: -190px; }
    .bfcm-landing__hero-media { min-height: 340px; }
    .bfcm-landing__intro { align-items: flex-start; flex-direction: column; }
    .bfcm-landing__schedule ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bfcm-landing__schedule li:nth-child(3) { border-left: 0; border-top: 1px solid var(--bfcm-ink); }
    .bfcm-landing__schedule li:nth-child(4) { border-top: 1px solid var(--bfcm-ink); }
  }
  @media (max-width: 440px) {
    .bfcm-landing__form-row { flex-direction: column; }
    .bfcm-landing__schedule ol { grid-template-columns: 1fr; }
    .bfcm-landing__schedule li + li { border-left: 0; border-top: 1px solid var(--bfcm-ink); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ONA BFCM landing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "ONA Coffee" },
    { "type": "text", "id": "title", "label": "Hero title", "default": "Black Friday" },
    { "type": "text", "id": "title_emphasis", "label": "Hero italic title", "default": "Cyber Monday" },
    { "type": "text", "id": "date_line", "label": "Date line", "default": "Fri 27 Nov – Mon 30 Nov 2026" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "intro_text", "label": "Intro text", "default": "Something special is on its way. Stay in the loop and explore ONA while you wait." },
    { "type": "text", "id": "signup_label", "label": "Signup link", "default": "Sign up" },
    { "type": "text", "id": "shop_label", "label": "Shop link", "default": "Shop coffees" },
    { "type": "text", "id": "signup_eyebrow", "label": "Signup eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "signup_heading", "label": "Signup heading", "default": "Get heads ups on special releases, exclusive mini sales and announcements!" },
    { "type": "text", "id": "schedule_eyebrow", "label": "Schedule eyebrow", "default": "27–30 November 2026" },
    { "type": "text", "id": "schedule_heading", "label": "Schedule heading", "default": "Black Friday Cyber Monday" }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Collection URL" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "ONA BFCM landing" }]
}
{% endschema %}
