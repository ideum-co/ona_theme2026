{%- liquid
  # The level is a setting so the page keeps one heading outline, but only h1 to h6 pass
  # through - anything else would put an arbitrary tag name straight from a setting.
  assign heading_tag = section.settings.heading_tag | default: 'h3'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6'
    assign heading_tag = 'h3'
  endunless
  # Ends the size chain: an explicit px value wins, then the typography preset, then the
  # size that belongs to the chosen level. It has to be published as a variable because a
  # class rule outranks the theme's `h3` selector, and an invalid var() resets to inherit
  # rather than falling through to it.
  assign heading_level_size = '--font-' | append: heading_tag | append: '--size'
  assign product = section.settings.product
  assign settings = section.settings
  assign heading_preset = settings.type_preset | default: 'rte'
  assign eyebrow_preset = settings.eyebrow_type_preset | default: 'rte'
  assign title_preset = settings.title_type_preset | default: 'rte'
  assign description_preset = settings.description_type_preset | default: 'rte'
  assign spec_label_preset = settings.spec_label_type_preset | default: 'rte'
  assign spec_value_preset = settings.spec_value_type_preset | default: 'rte'

  assign variant = product.selected_or_first_available_variant
  assign form_id = 'ProductHighlight-ProductForm-' | append: section.id
  assign form_component_id = 'ProductHighlight-Form-' | append: section.id

  assign image = settings.image
  if image == blank
    assign image = variant.featured_media.preview_image
  endif
  if image == blank
    assign image = product.featured_media.preview_image
  endif

  assign description = settings.description
  if description == blank
    assign description = product.description
  endif

  assign has_variants = false
  if product.has_only_default_variant == false and product.variants_count > 1
    assign has_variants = true
  endif

  assign adds_to_cart = false
  if settings.cta_style == 'add_to_cart' and product != blank
    assign adds_to_cart = true
  endif
-%}

{%- if product == blank and request.design_mode == false -%}
  {%- comment -%} Nothing to highlight, so the section stays out of the page entirely. {%- endcomment -%}
{%- else -%}
  <div
    class="product-highlight product-highlight--media-{{ settings.media_position }}"
    style="
      --section-heading-level-size: var({{ heading_level_size }});
      --product-highlight-background: {{ settings.background_color }};
      --product-highlight-color: {{ settings.text_color }};
      {%- comment -%}
        `--variant-option-label-color` is declared on `:root` as the page foreground, so the
        control's own `currentcolor` fallback never gets a turn and the label and the value came out
        in the page's dark text on this dark section. Defaulting these to the section's text colour
        means the control is readable here without anyone touching a setting.
      {%- endcomment -%}
      --variant-option-label-color: {{ settings.select_label_color | default: settings.text_color }};
      --variant-select-field-border-color: {{ settings.select_border_color | default: settings.text_color }};
      {%- if settings.content_distribution == 'space-between' %}
        --product-highlight-heading-push: auto;
        --product-highlight-details-margin: 0;
      {%- endif %}
      {%- if settings.eyebrow_size > 0 %}
        --product-highlight-eyebrow-size: {{ settings.eyebrow_size }}px;
      {%- endif %}
      {%- if settings.title_size > 0 %}
        --product-highlight-title-size: {{ settings.title_size }}px;
      {%- endif %}
      {%- if settings.description_size > 0 %}
        --product-highlight-description-size: {{ settings.description_size }}px;
      {%- endif %}
      {%- if settings.spec_label_size > 0 %}
        --product-highlight-spec-label-size: {{ settings.spec_label_size }}px;
      {%- endif %}
      {%- if settings.spec_value_size > 0 %}
        --product-highlight-spec-value-size: {{ settings.spec_value_size }}px;
      {%- endif %}
      {%- if settings.heading_size > 0 %}
        --product-highlight-heading-size: {{ settings.heading_size }}px;
      {%- endif %}
      --product-highlight-heading-gap: {{ settings.heading_gap }}px;
      {%- comment -%}
        Only emitted when set, so the desktop value keeps coming through by fallback rather than
        being shadowed by a mobile one nobody chose.
      {%- endcomment -%}
      {%- if settings.heading_size_mobile > 0 %}
        --product-highlight-heading-size-mobile: {{ settings.heading_size_mobile }}px;
      {%- endif %}
      {%- if settings.heading_gap_mobile > 0 %}
        --product-highlight-heading-gap-mobile: {{ settings.heading_gap_mobile }}px;
      {%- endif %}
      --product-highlight-button-background: {{ settings.button_background }};
      --product-highlight-button-color: {{ settings.button_text }};
    "
    {{ section.shopify_attributes }}
  >
    <div
      class="product-highlight__content spacing-style"
      style="{%- render 'spacing-style', settings: settings %}"
    >
      {%- if settings.heading != blank -%}
        <{{ heading_tag }}
      class="product-highlight__heading {{ heading_preset }}{% if heading_preset == 'custom' %} custom-typography custom-font-size{% elsif heading_preset == 'rte' %} product-highlight__heading--default{% endif %}"
      style="{%- render 'typography-style', settings: section.settings, type: 'heading' -%}"
    >{{ settings.heading }}</{{ heading_tag }}>
      {%- endif -%}

      <div class="product-highlight__details">
        {%- if settings.eyebrow != blank -%}
          <p
            class="product-highlight__eyebrow {{ eyebrow_preset }}{% if eyebrow_preset == 'custom' %} custom-typography custom-font-size{% elsif eyebrow_preset == 'rte' %} product-highlight__eyebrow--default{% endif %}"
            style="{%- render 'product-highlight-typography-style', settings: settings, prefix: 'eyebrow', type: 'body' -%}"
          >{{ settings.eyebrow }}</p>
        {%- endif -%}

        {%- if settings.show_product_title and product.title != blank -%}
          <h3
            class="product-highlight__title {{ title_preset }}{% if title_preset == 'custom' %} custom-typography custom-font-size{% elsif title_preset == 'rte' %} product-highlight__title--default{% endif %}"
            style="{%- render 'product-highlight-typography-style', settings: settings, prefix: 'title', type: 'heading' -%}"
          >{{ product.title }}</h3>
        {%- endif -%}

        {%- if description != blank -%}
          <div
            class="product-highlight__description {{ description_preset }}{% if description_preset == 'custom' %} custom-typography custom-font-size{% elsif description_preset == 'rte' %} product-highlight__description--default{% endif %}"
            style="{%- render 'product-highlight-typography-style', settings: settings, prefix: 'description', type: 'body' -%}"
          >{{ description }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <dl class="product-highlight__specs">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank or block.settings.value != blank -%}
                <div
                  class="product-highlight__spec"
                  {{ block.shopify_attributes }}
                >
                  <dt
                    class="product-highlight__spec-label {{ spec_label_preset }}{% if spec_label_preset == 'custom' %} custom-typography custom-font-size{% elsif spec_label_preset == 'rte' %} product-highlight__spec-label--default{% endif %}"
                    style="{%- render 'product-highlight-typography-style', settings: settings, prefix: 'spec_label', type: 'body' -%}"
                  >{{ block.settings.label }}</dt>
                  <dd
                    class="product-highlight__spec-value {{ spec_value_preset }}{% if spec_value_preset == 'custom' %} custom-typography custom-font-size{% elsif spec_value_preset == 'rte' %} product-highlight__spec-value--default{% endif %}"
                    style="{%- render 'product-highlight-typography-style', settings: settings, prefix: 'spec_value', type: 'body' -%}"
                  >{{ block.settings.value }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if adds_to_cart -%}
          {%- if has_variants -%}
            {%- render 'variant-select-dropdown',
              product: product,
              unique_id: section.id,
              form_component_id: form_component_id
            -%}
          {%- endif -%}

          <product-form-component
            id="{{ form_component_id }}"
            class="product-highlight__form"
            data-section-id="{{ section.id }}"
            data-product-id="{{ product.id }}"
            on:submit="/handleSubmit"
          >
            <div
              class="visually-hidden"
              aria-live="assertive"
              role="status"
              aria-atomic="true"
              ref="liveRegion"
            ></div>
            {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                ref="variantId"
                value="{{ variant.id }}"
                {% if variant.available == false %}
                  disabled
                {% endif %}
              >
              <input
                type="hidden"
                name="quantity"
                value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
              >
              {%- render 'add-to-cart-button',
                add_to_cart_text: settings.cta_label,
                class: 'product-highlight__button add-to-cart-button',
                can_add_to_cart: variant.available,
                show_icon: false,
                product: product
              -%}
            {%- endform -%}
          </product-form-component>
        {%- elsif product != blank -%}
          <a
            class="button product-highlight__button product-highlight__button--link"
            href="{{ product.url }}"
          >
            {{- settings.cta_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="product-highlight__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            class: 'product-highlight__image'
        }}
      {%- endif -%}
    </div>
  </div>

  {%- render 'add-to-cart-button-styles' -%}
  {%- if has_variants and adds_to_cart -%}
    {%- render 'variant-select-styles' -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .product-highlight {
    display: grid;
    background: var(--product-highlight-background, var(--color-foreground));
    color: var(--product-highlight-color, var(--color-background));

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  .product-highlight--media-left .product-highlight__media {
    @media screen and (min-width: 750px) {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* The heading reads as a label in the corner, so the distance down to the content is its own
     setting rather than the section's generic gap. */
  .product-highlight__content {
    display: flex;
    flex-direction: column;


    /* Mobile first, falling back to the desktop value: the distance that reads as a corner label
       on a wide screen is a lot of empty space on a phone. */
    gap: var(--product-highlight-heading-gap-mobile, var(--product-highlight-heading-gap, var(--gap-2xl)));

    @media screen and (min-width: 750px) {
      gap: var(--product-highlight-heading-gap, var(--gap-2xl));
    }
    /* spacing-style owns all four content-column padding values. The schema defaults its inline
       values to the previous page margin, so a saved section keeps its current silhouette. */
  }

  /* An auto margin under the heading, rather than `space-between` on the column: space-between
     spreads every child, so a column with three or more items comes apart. This pushes everything
     after the heading down as one group and leaves their own spacing alone. */
  .product-highlight__content > :first-child {
    margin-block-end: var(--product-highlight-heading-push, 0);
  }

  .product-highlight__heading {
    margin: 0;
  }

  /* Legacy size sliders are honoured only while the editor's Default preset is selected. A
     Horizon preset or Custom therefore owns every typography property without a later section
     rule overriding it. */
  .product-highlight__heading--default {
    font-family: var(--font-heading--family);

    /* `--font-h2--size` is never defined in the theme - only `--font-h2--spacing` is - so this
       declaration was invalid and the heading just inherited its size. The setting pins it. */
    /* No fallback on purpose: with the size left at 0 nothing is emitted, the declaration is
       invalid and the element keeps whatever its heading level gives it. A fallback here would
       mean the level could never govern the size. */
    font-size: var(--product-highlight-heading-size-mobile, var(--product-highlight-heading-size, var(--font-size, var(--section-heading-level-size))));

    @media screen and (min-width: 750px) {
      font-size: var(--product-highlight-heading-size, var(--font-size, var(--section-heading-level-size)));
    }
    font-weight: var(--font-heading--weight);
  }

  /* The heading sits at the top and the rest floats in the leftover space, as in the design. */
  .product-highlight__details {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);

    /* `auto` centres the block in the leftover space, which cancels any distribution set above.
       It is only applied in the default mode. */
    margin-block: var(--product-highlight-details-margin, auto);
    max-inline-size: 34rem;
  }

  .product-highlight__eyebrow {
    margin: 0;
  }

  .product-highlight__eyebrow--default {
    font-size: var(--product-highlight-eyebrow-size, var(--font-size--xl));
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
  }

  .product-highlight__title {
    margin: 0;
  }

  .product-highlight__title--default {
    font-size: var(--product-highlight-title-size, var(--font-size--4xl));
    font-weight: var(--font-body--weight);
  }

  .product-highlight__description {
    display: grid;
    gap: var(--gap-md);
  }

  .product-highlight__description--default {
    font-size: var(--product-highlight-description-size, var(--font-size--xl));
  }

  .product-highlight__description :is(p, ul, ol) {
    margin: 0;
  }

  .product-highlight__specs {
    margin: 0;
    display: grid;
  }

  .product-highlight__spec {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--gap-lg);
    align-items: baseline;
    padding-block: var(--padding-sm);
    border-block-start: 1px solid rgb(var(--color-background-rgb) / var(--opacity-40));
  }

  .product-highlight__spec:last-child {
    border-block-end: 1px solid rgb(var(--color-background-rgb) / var(--opacity-40));
  }

  .product-highlight__spec-label {
    margin: 0;
  }

  .product-highlight__spec-label--default {
    font-size: var(--product-highlight-spec-label-size, var(--font-size--xl));
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
  }

  .product-highlight__spec-value {
    margin: 0;
  }

  .product-highlight__spec-value--default {
    font-size: var(--product-highlight-spec-value-size, var(--font-size--xl));
    text-align: end;
  }

  .product-highlight .variant-select {
    --variant-select-field-border-color: currentcolor;
    --variant-select-legend-font-size: var(--font-size--3xs);

    max-inline-size: 20rem;
  }

  .product-highlight__form {
    display: block;
  }

  .product-highlight__button.button {
    --button-background-color: var(--product-highlight-button-background);
    --button-color: var(--product-highlight-button-color);

    justify-content: center;
    min-inline-size: 12rem;
    inline-size: fit-content;
  }

  .product-highlight__media {
    position: relative;
    min-block-size: 20rem;
  }

  .product-highlight__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }
{% endstylesheet %}

{% schema %}
