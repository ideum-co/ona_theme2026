  "tag": "section",
  "blocks": [
    {
      "type": "spec",
      "name": "t:names.product_highlight_spec",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label",
          "default": "Tastes like"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:settings.text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "info": "t:info.heading_tag",
      "options": [
