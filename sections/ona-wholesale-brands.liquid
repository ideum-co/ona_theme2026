        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Band"
    },
    {
      "type": "color",
      "id": "band_background",
      "label": "Band background",
      "info": "Full-bleed colour behind this section. Leave blank to use the page background. Text and buttons are contrasted automatically."
    },
    {
      "type": "text",
      "id": "id",
      "label": {
        "en": "ID"
      }
    },
    {
      "type": "text",
      "id": "title",
      "label": {
		"en": "Title"
      }
    },
    {
      "type": "textarea",
      "id": "content",
      "label": {
		"en": "Content"
      }
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": {
        "en": "Block"
      },
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": {
            "en": "Title"
          }
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": {
            "en": "Image"
          }
        },
        {
            "type": "url",
            "id": "link",
            "label": "Website URL"
          }
      ]
    }
  ],
  "presets": [
    {
      "name": {
        "en": "Brands"
      },
      "category": {
        "en": "Text"
      }
    }
  ]
}
{% endschema %}