<script src="{{ 'ona-slider.js' | asset_url }}" type="module"></script>
<section class="awards">
    <div class="container">
        <div class="content">
            <div class="left-box wowo fadeInUp">
                <h2>{{ section.settings.title2 }}</h2>
                <h3>{{ section.settings.content }}</h3>
                {%- comment -%}
                  The loop walks every block, and block2 (the awards table rows)
                  outnumbers block1 twelve to five, so forloop.index cannot label
                  the photos -- it would read 1, 3, 7. award_index counts only the
                  images.
                {%- endcomment -%}
                {%- assign award_index = 0 -%}
                <ona-slider class="ona-slider">
                <div class="ona-slider__nav" role="tablist" aria-label="{{ section.settings.title2 | default: 'Awards' | escape }}" data-slider-nav></div>
                <div class="image-slider" data-slider-track>
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}
                      {% if block.type == 'block1' %}
                        {%- assign award_index = award_index | plus: 1 -%}
                        <div class="slider-list" data-slider-slide data-slide-label="{{ award_index }}">
                          <img src="{{ block.settings.image | img_url: '1188x' }}" alt="">
                        </div>
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                </div>
                </ona-slider>
                <svg class="animated-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 462.1 372.8">
                    <path class="start" d="M72,326.4C8.3,263.7-24.9,190.9,22.7,99.6c36.5-70,103.3-96.2,183.1-99.2C290.4-2.7,362.4,17.7,417.3,70
	c62.8,59.8,60.6,133.1-13.5,197.1c-40.1,34.6-60.2,61.5-135.6,90.3C179.5,383.8,124.3,377.9,72,326.4z" fill="#BDD6E6"/>
                    <path class="medium" fill-rule="evenodd" clip-rule="evenodd" d="M230.573 0.0122497C283.274 0.444455 337.523 10.8555 376.385 37.1246C413.247 62.0413 419.655 101.137 432.819 136.722C445.272 170.382 468.102 205.541 450.689 237.982C433.552 269.911 380.657 279.302 344.622 301.037C305.443 324.668 280.509 364.7 230.573 370.744C178.66 377.027 123.896 359.04 85.6623 332.379C49.6101 307.238 47.1045 267.676 32.5809 232.678C18.3724 198.439 -7.02619 165.576 1.83123 130.369C11.35 92.5345 41.1114 58.2356 82.3862 34.7135C124.43 10.7534 177.453 -0.423393 230.573 0.0122497Z" fill="#BDD6E6"/>
                    <path class="end" fill-rule="evenodd" clip-rule="evenodd" d="M230.753 0.00561746C275.88 -0.552182 304.072 40.5669 341.277 62.722C379.903 85.7239 436.349 94.0245 452.628 132.13C468.957 170.351 435.362 209.452 420.477 248.115C405.745 286.382 403.888 332.683 366.275 356.423C328.657 380.166 277.189 370.379 230.753 367.862C187.378 365.51 144.994 360.679 107.007 342.367C64.8211 322.031 17.8287 298.653 3.99454 258.551C-9.77046 218.65 14.6764 176.888 37.2366 140.121C56.6901 108.417 90.7079 88.4423 122.496 65.4263C157.106 40.3673 185.673 0.562859 230.753 0.00561746Z" fill="#BDD6E6"/>
                </svg>
            </div>
            <div class="right-box wowo fadeInUp">
                <table>
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}
                      {% if block.type == 'block2' %}
                        <tr>
                            <td>{{ block.settings.title }}</td>
                            <td>{{ block.settings.winner }}</td>
                        </tr>
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                </table>

            </div>
        </div>
    </div>
</section>


{% stylesheet %}
  /*
   * Slider styles live with the section, not in legacy-page-layout.css: that
   * sheet is loaded only for a fixed list of page suffixes, and this section
   * has a preset, so it can be placed on any JSON template. Where the sheet is
   * absent the slides would stack at full size with nothing to collapse them.
   */
  .ona-slider__nav { display: none; }

  .ona-slider.is-enhanced .ona-slider__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    margin-block-end: clamp(1rem, 3vw, 2rem);
  }

  /* Square, uppercase, wide-tracked -- the treatment these pages already use. */
  .ona-slider__tab {
    padding: 0 0 0.5rem;
    border: 0;
    border-block-end: 2px solid transparent;
    border-radius: 0;
    background: none;
    font: inherit;
    font-size: var(--font-h6--size, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.55;
    cursor: pointer;
  }

  .ona-slider__tab:hover,
  .ona-slider__tab:focus-visible { opacity: 1; }

  .ona-slider__tab.is-active {
    opacity: 1;
    border-block-end-color: currentcolor;
  }

  /*
   * Stacking only once enhanced. Before that the track flows normally and every
   * slide is readable; a slider that collapses before its script runs loses
   * content on a slow connection.
   */
  .ona-slider.is-enhanced [data-slider-track] { display: grid; }

  .ona-slider.is-enhanced [data-slider-slide] {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }

  .ona-slider.is-enhanced [data-slider-slide].is-active {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .ona-slider.is-enhanced [data-slider-slide] { transition: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": {
    "en": "Awards"
  },
  "settings": [
    {
      "type": "text",
      "id": "title2",
      "label": {
		"en": "Title"
      }
    },
    {
      "type": "textarea",
      "id": "content",
      "label": {
		"en": "Content"
      }
    }
  ],
  "blocks": [
    {
      "type": "block1",
      "name": {
        "en": "Slider"
      },
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": {
            "en": "Image"
          }
        }
      ]
    },
    {
      "type": "block2",
      "name": {
        "en": "Awards"
      },
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "id": "winner",
          "label": {
            "en": "Winner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
