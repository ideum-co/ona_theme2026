{%- liquid
  assign settings = section.settings

  # Colores por producto. El estándar de merchandising es un par de metacampos en el producto -
  # namespace y claves son ajustes, así que el estándar se fija una vez aquí y el equipo solo llena
  # los metacampos. Sin valor, manda el color de la sección, que es lo que ve un producto nuevo
  # hasta que alguien lo vista.
  assign product_resource = closest.product | default: product

  assign background_color = settings.background_color
  assign text_color = settings.text_color

  if settings.color_source == 'product'
    assign namespace = settings.color_namespace | strip
    assign background_key = settings.background_color_key | strip
    assign text_key = settings.text_color_key | strip

    if namespace != blank and background_key != blank
      assign product_background = product_resource.metafields[namespace][background_key].value
      if product_background != blank
        assign background_color = product_background
      endif
    endif

    if namespace != blank and text_key != blank
      assign product_text = product_resource.metafields[namespace][text_key].value
      if product_text != blank
        assign text_color = product_text
      endif
    endif
  endif

  # Every tab gets a button, always. An earlier version drew a button only for a labelled tab, so
  # a tab left unlabelled produced a panel with no way to reach it - and, worse, the button count
  # then no longer matched the panel count, which is the exact condition the component treats as
  # "cannot pair these" and bails on, leaving every panel stacked and visible. A blank label falls
  # back to a numbered placeholder instead, so the strip and the panels always line up and the tabs
  # always behave as tabs.
-%}

<script
  src="{{ 'product-tabs.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<product-tabs-component
  class="product-tabs spacing-style"
  style="
    --product-tabs-background: {{ background_color }};
    --product-tabs-color: {{ text_color }};
    --product-tabs-label-size: {{ settings.label_size }}px;
    {%- if settings.label_size_mobile > 0 %}
      --product-tabs-label-size-mobile: {{ settings.label_size_mobile }}px;
    {%- endif %}
    --product-tabs-label-font: var(--font-{{ settings.label_font }}--family);
    --product-tabs-label-case: {{ settings.label_case }};
    --product-tabs-distribution: {{ settings.distribution }};
    --product-tabs-rule-thickness: {{ settings.rule_thickness }}px;
    {%- if settings.rule_color != blank %}
      --product-tabs-rule-color: {{ settings.rule_color }};
    {%- endif %}
    --product-tabs-indicator-thickness: {{ settings.indicator_thickness }}px;
    {%- if settings.indicator_color != blank %}
      --product-tabs-indicator-color: {{ settings.indicator_color }};
    {%- endif %}
    {%- if settings.active_label_color != blank %}
      --product-tabs-active-color: {{ settings.active_label_color }};
    {%- endif %}
    --product-tabs-panel-gap: {{ settings.panel_gap }}px;
    {%- if settings.panel_gap_mobile > 0 %}
      --product-tabs-panel-gap-mobile: {{ settings.panel_gap_mobile }}px;
    {%- endif %}
    --product-tabs-max-width: {{ settings.max_width }}px;
    {%- render 'spacing-style', settings: settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="product-tabs__inner product-tabs__inner--{{ settings.section_width }}">
    {%- if section.blocks.size > 0 -%}
      <div
        class="product-tabs__strip"
        role="tablist"
        aria-label="{{ settings.tablist_label | default: 'Product information' | escape }}"
        ref="strip"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_label = block.settings.label | strip
            if tab_label == blank
              assign tab_label = 'Tab ' | append: forloop.index
            endif
          -%}
          <button
            type="button"
            class="product-tabs__tab"
            id="ProductTab-{{ block.id }}"
            role="tab"
            aria-controls="ProductTabPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            ref="tabs[]"
            on:click="/select/{{ forloop.index0 }}"
            on:keydown="/handleKeyDown"
          >
            {{- tab_label -}}
          </button>
        {%- endfor -%}

        <span class="product-tabs__indicator" ref="indicator" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    <div class="product-tabs__panels">
      {% content_for 'blocks' %}
    </div>
  </div>
</product-tabs-component>

{% stylesheet %}
  .product-tabs {
    display: block;
    background: var(--product-tabs-background);
    color: var(--product-tabs-color, inherit);
  }

  .product-tabs__inner {
    margin-inline: auto;
    padding-inline: var(--page-margin, 1rem);
  }

  .product-tabs__inner--page-width {
    max-inline-size: var(--product-tabs-max-width, 1360px);
  }

  /* The strip scrolls sideways rather than wrapping: three display-sized labels on a phone would
     otherwise stack into three lines and stop reading as one row of tabs. */
  .product-tabs__strip {
    position: relative;
    display: flex;
    justify-content: flex-start;
    gap: var(--gap-2xl, 2rem);
    overflow-x: auto;
    scrollbar-width: none;
    padding-block-end: var(--product-tabs-indicator-thickness, 6px);
    border-block-end: var(--product-tabs-rule-thickness, 1px) solid
      var(--product-tabs-rule-color, currentcolor);

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      justify-content: var(--product-tabs-distribution, space-between);
      overflow-x: visible;
    }
  }

  .product-tabs__tab {
    flex: 0 0 auto;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: inherit;
    font-family: var(--product-tabs-label-font, var(--font-heading--family));
    font-size: var(--product-tabs-label-size-mobile, var(--product-tabs-label-size, 2.75rem));
    font-weight: var(--font-heading--weight);
    line-height: 1.1;
    text-transform: var(--product-tabs-label-case, none);
    white-space: nowrap;

    @media screen and (min-width: 750px) {
      font-size: var(--product-tabs-label-size, 2.75rem);
    }

    &[aria-selected='true'] {
      color: var(--product-tabs-active-color, inherit);
    }
  }

  /* Sits on the rule, under the current tab. Its offset and width are written by the component:
     the label widths depend on a webfont and on the viewport, so neither is knowable here. */
  .product-tabs__indicator {
    position: absolute;
    inset-block-end: calc(var(--product-tabs-rule-thickness, 1px) * -1);
    inset-inline-start: 0;
    display: none;
    block-size: var(--product-tabs-indicator-thickness, 6px);
    inline-size: var(--product-tabs-indicator-width, 0);
    background: var(--product-tabs-indicator-color, currentcolor);
    translate: var(--product-tabs-indicator-offset, 0);
    transition: translate var(--animation-speed-slow, 0.2s) var(--animation-easing, ease-in-out),
      inline-size var(--animation-speed-slow, 0.2s) var(--animation-easing, ease-in-out);
  }

  .product-tabs__panels {
    padding-block-start: var(--product-tabs-panel-gap-mobile, var(--product-tabs-panel-gap, 3rem));

    @media screen and (min-width: 750px) {
      padding-block-start: var(--product-tabs-panel-gap, 3rem);
    }
  }

  .product-tabs__panel:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  /* Before the component connects - and on a page where it never does - every panel is on the
     page, one after another, and the strip is inert decoration. */
  .product-tabs:not([enhanced]) .product-tabs__panel + .product-tabs__panel {
    margin-block-start: var(--product-tabs-panel-gap, 3rem);
  }

  .product-tabs[enhanced] .product-tabs__indicator {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-tabs__indicator {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "blocks": [
    {
      "type": "product-tab"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "t:settings.size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "label": "t:settings.size_mobile",
      "info": "t:info.zero_uses_desktop",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "label_case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "distribution",
      "label": "t:settings.content_distribution",
      "options": [
        {
          "value": "space-between",
          "label": "t:options.space_between"
        },
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "space-between"
    },
    {
      "type": "range",
      "id": "rule_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.rule_thickness > 0 }}"
    },
    {
      "type": "range",
      "id": "indicator_thickness",
      "label": "Indicator thickness",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "color",
      "id": "indicator_color",
      "label": "Indicator color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.indicator_thickness > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:settings.max_width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1360,
      "visible_if": "{{ section.settings.section_width == 'page-width' }}"
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "panel_gap_mobile",
      "label": "t:settings.vertical_gap_mobile",
      "info": "t:info.zero_uses_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "select",
      "id": "color_source",
      "label": "Color source",
      "info": "Per product reads the metafields below, and falls back to these colors when a product has none.",
      "options": [
        {
          "value": "product",
          "label": "Per product (metafield)"
        },
        {
          "value": "section",
          "label": "These colors"
        }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "color_namespace",
      "label": "Metafield namespace",
      "default": "custom",
      "visible_if": "{{ section.settings.color_source == 'product' }}"
    },
    {
      "type": "text",
      "id": "background_color_key",
      "label": "Background metafield key",
      "default": "pdp_background_color",
      "visible_if": "{{ section.settings.color_source == 'product' }}"
    },
    {
      "type": "text",
      "id": "text_color_key",
      "label": "Text metafield key",
      "default": "pdp_text_color",
      "visible_if": "{{ section.settings.color_source == 'product' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#F5BFD4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#F5F4E9"
    },
    {
      "type": "color",
      "id": "active_label_color",
      "label": "Active tab color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "category": "t:categories.products",
      "blocks": {
        "tab_profile": {
          "type": "product-tab",
          "settings": {
            "label": "Profile"
          }
        },
        "tab_brew": {
          "type": "product-tab",
          "settings": {
            "label": "Brew Guide"
          }
        },
        "tab_reviews": {
          "type": "product-tab",
          "settings": {
            "label": "Reviews"
          }
        }
      },
      "block_order": [
        "tab_profile",
        "tab_brew",
        "tab_reviews"
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
