{%- liquid
  # The level is a setting so the page keeps one heading outline, but only h1 to h6 pass
  # through - anything else would put an arbitrary tag name straight from a setting.
  assign heading_tag = section.settings.heading_tag | default: 'h3'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6'
    assign heading_tag = 'h3'
  endunless
  assign settings = section.settings

  assign has_video = false
  if settings.source == 'uploaded' and settings.video != blank
    assign has_video = true
  elsif settings.source == 'url' and settings.video_url != blank
    assign has_video = true
  endif
-%}

<div
  class="story-video spacing-style"
  style="
    --story-video-background: {{ settings.background_color }};
    --story-video-color: {{ settings.text_color }};
    --story-video-heading-size: {{ settings.heading_size }}px;
    --story-video-max-width: {{ settings.video_max_width }}px;
    --story-video-overhang: {{ settings.video_overhang }}px;
    --story-video-button-background: {{ settings.button_background }};
    --story-video-button-color: {{ settings.button_text }};
    --story-video-play-background: {{ settings.play_background }};
    --story-video-play-color: {{ settings.play_color }};
    --story-video-play-size: {{ settings.play_size }}px;
    {%- render 'spacing-style', settings: settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="story-video__intro">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 300
        | image_tag: widths: '80, 150, 220, 300', sizes: '110px', loading: 'lazy', class: 'story-video__logo'
      }}
    {%- endif -%}

    {%- if settings.heading != blank -%}
      <{{ heading_tag }} class="story-video__heading">{{ settings.heading }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if settings.body != blank -%}
      <div class="story-video__body rte">{{ settings.body }}</div>
    {%- endif -%}

    {%- if settings.button_label != blank -%}
      <a
        class="button story-video__button"
        {% if settings.button_link != blank %}
          href="{{ settings.button_link }}"
        {% endif %}
      >
        {{- settings.button_label -}}
      </a>
    {%- endif -%}
  </div>

  {%- if has_video -%}
    {%- comment -%}
      Both sources go through the theme's own video snippet, which already handles the deferred
      <video> element, the YouTube/Vimeo iframe, the poster and the play button.
    {%- endcomment -%}
    <div class="story-video__media">
      {%- capture video_style -%}
        --size-style-width: 100%;
        --size-style-width-mobile: 100%;
        --size-style-aspect-ratio:
        {%- if settings.source == 'uploaded' -%}
          {{ settings.video.aspect_ratio | default: 'auto' }}
        {%- elsif settings.cover_image == blank -%}
          {{ settings.aspect_ratio }}
        {%- else -%}
          auto
        {%- endif -%};
      {%- endcapture -%}

      {%- if settings.source == 'uploaded' -%}
        {%- render 'video',
          video: settings.video,
          video_class: 'story-video__player size-style',
          video_style: video_style,
          video_loop: settings.video_loop,
          video_autoplay: settings.video_autoplay,
          video_preview_image: settings.cover_image | default: settings.video.preview_image
        -%}
      {%- else -%}
        {%- render 'video',
          video_from_url: true,
          video: settings.video_url.id,
          video_type: settings.video_url.type,
          video_class: 'story-video__player size-style',
          video_style: video_style,
          video_alt: settings.alt,
          video_preview_image: settings.cover_image
        -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .story-video {
    display: grid;

    /* An implicit auto column would take its width from the intro text, leaving the player
       narrower than the section and unable to reach its own max width. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--gap-2xl);
    padding-inline: var(--util-page-margin, var(--padding-2xl));
    background: var(--story-video-background);
    color: var(--story-video-color);
    text-align: center;
  }

  .story-video__intro {
    display: grid;
    justify-items: center;
    gap: var(--gap-lg);
    max-inline-size: 42rem;
  }

  .story-video__logo {
    inline-size: clamp(4rem, 7vw, 7rem);
    block-size: auto;
  }

  .story-video__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--story-video-heading-size, var(--font-h2--size));
    font-weight: var(--font-heading--weight);
  }

  .story-video__body {
    display: grid;
    gap: var(--gap-sm);
    font-size: var(--font-size--xl);
  }

  .story-video__body :is(p, ul, ol) {
    margin: 0;
  }

  .story-video__button.button {
    --button-background-color: var(--story-video-button-background);
    --button-color: var(--story-video-button-color);

    justify-content: center;
  }

  /* A negative bottom margin lets the player hang over whatever section follows, as in the
     design. It also shortens this section, so the background stops above the video's bottom
     edge, which is the effect being asked for. The stacking context keeps it above. */
  /* justify-items: center on the grid sizes items to their content, and the player inside asks
     for 100% of its parent - the two resolve to zero. Stretching the area and capping it with a
     max width is what gives the player a real box to lay out in. */
  /* A definite width plus `justify-self: center`, not `stretch` with auto margins: an auto margin
     in the alignment axis cancels stretch, which left the player at its intrinsic 300px. */
  .story-video__media {
    position: relative;
    z-index: var(--layer-flat, 1);
    justify-self: center;
    inline-size: min(100%, var(--story-video-max-width, 1280px));
    margin-block-end: calc(var(--story-video-overhang, 0px) * -1);
  }

  /* `deferred-media` is a custom element with no display of its own, so it stays inline unless a
     flex or grid parent blockifies it - which is what happens inside the theme's own video block,
     and why this only showed up here. Inline meant its width and height were ignored and the
     absolutely positioned iframe and play button resolved against a 640px box. */
  .story-video__player {
    display: block;
  }

  /* Play button per the design: a solid disc with the triangle drawn as an outline. The theme's
     icon is a filled path, so it is stroked instead of filled here. */
  .story-video .deferred-media__poster-icon {
    inline-size: var(--story-video-play-size, 6rem);
    block-size: var(--story-video-play-size, 6rem);
    background: var(--story-video-play-background);
    color: var(--story-video-play-color);
  }

  .story-video .deferred-media__poster-icon svg {
    inline-size: 40%;
    block-size: 40%;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1;
    filter: none;
    vector-effect: non-scaling-stroke;
  }

  .story-video .deferred-media__poster-icon svg path {
    fill: none;
    stroke: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.story_video",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "info": "t:info.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:settings.logo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "More than coffee. <em>Since 2008.</em>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:settings.size",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:settings.description"
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "t:settings.background",
      "default": "#f5f4ea"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "t:settings.text",
      "default": "#751132"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.video_source",
      "options": [
        {
          "value": "uploaded",
          "label": "t:options.video_uploaded"
        },
        {
          "value": "url",
          "label": "t:options.video_external_url"
        }
      ],
      "default": "uploaded"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.source == 'uploaded' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_external_url",
      "info": "t:info.video_external",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "visible_if": "{{ section.settings.source == 'url' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.video_autoplay",
      "info": "t:info.video_autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.video_loop",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:settings.cover_image",
      "visible_if": "{{ section.settings.source == 'url' and section.settings.video_autoplay == false }}"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "t:settings.video_alt_text",
      "info": "t:info.video_alt_text",
      "visible_if": "{{ section.settings.source == 'url' }}"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "visible_if": "{{ section.settings.source == 'url' and section.settings.cover_image == blank }}",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "9/16",
          "label": "t:options.portrait"
        },
        {
          "value": "1/1",
          "label": "t:options.square"
        },
        {
          "value": "16/9",
          "label": "t:options.landscape"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "range",
      "id": "video_max_width",
      "label": "t:settings.max_width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "video_overhang",
      "label": "t:settings.video_overhang",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "t:info.video_overhang"
    },
    {
      "type": "color",
      "id": "play_background",
      "label": "t:settings.background",
      "default": "#751132"
    },
    {
      "type": "color",
      "id": "play_color",
      "label": "t:settings.color",
      "default": "#f5f4ea"
    },
    {
      "type": "range",
      "id": "play_size",
      "label": "t:settings.size",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#751132"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#f5f4ea"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:names.story_video"
    }
  ]
}
{% endschema %}
