<section class="training-bookings">
  <div class="container">
    <div class="content">
      <div class="left-box wowo fadeInUp">
        <h2>{{ section.settings.title2 }}</h2>
        <img src="{{ section.settings.image | img_url: '1630x' }}" alt="{{ section.settings.image.alt | escape }}">
        <div class="lead-text">
          {{ section.settings.leadtext }}
        </div>
        {{ section.settings.content }}
      </div>
      <div class="right-box wowo fadeInUp">
        <div class="form">
          <h2>Get in touch</h2>
		  {% form 'contact', id: 'ona-experiences-' | append: section.id, class: 'ona-legacy-contact-form' %}
  {% if form.posted_successfully? %}
    <p role="status">Thank you. Your enquiry has been sent.</p>
  {% elsif form.errors %}
    <div role="alert">{{ form.errors | default_errors }}</div>
  {% endif %}
  <input type="hidden" name="contact[subject]" value="Private courses and experiences enquiry">
  <label for="ona-experiences-name-{{ section.id }}">Name</label>
  <input required type="text" id="ona-experiences-name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}">
  <label for="ona-experiences-email-{{ section.id }}">Email</label>
  <input required type="email" id="ona-experiences-email-{{ section.id }}" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}">
  <label for="ona-experiences-message-{{ section.id }}">How can we help?</label>
  <textarea required id="ona-experiences-message-{{ section.id }}" name="contact[body]" rows="5">{{ form.body | escape }}</textarea>
  <button type="submit" class="button">Send enquiry</button>
{% endform %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": {
    "en": "Content"
  },
  "settings": [
    {
      "type": "text",
      "id": "title2",
      "label": {
		"en": "Title"
      }
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": {
		"en": "Image"
      }
    },
    {
      "type": "richtext",
      "id": "leadtext",
      "label": {
		"en": "Lead text"
      }
    },
    {
      "type": "richtext",
      "id": "content",
      "label": {
		"en": "Content"
      }
    }
  ]
}
{% endschema %}