{%- liquid
  # The level is a setting so the page keeps one heading outline, but only h1 to h6 pass
  # through - anything else would put an arbitrary tag name straight from a setting.
  assign heading_tag = section.settings.heading_tag | default: 'h3'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6'
    assign heading_tag = 'h3'
  endunless
  # Ends the size chain: an explicit px value wins, then the typography preset, then the
  # size that belongs to the chosen level. It has to be published as a variable because a
  # class rule outranks the theme's `h3` selector, and an invalid var() resets to inherit
  # rather than falling through to it.
  assign heading_level_size = '--font-' | append: heading_tag | append: '--size'
  assign settings = section.settings
  # The preset travels as a class, which is how the theme's typography contract is entered:
  # `custom-typography` reads the variables `typography-style` writes, and a named preset
  # (h1 to h6, paragraph) carries its own rule in base.css. Without it the group of settings
  # publishes variables nothing consumes.
  assign heading_preset = settings.type_preset | default: 'rte'
  # `columns_mobile` is a select, so it arrives as a string and would never compare against a
  # number.
  assign columns_mobile = settings.columns_mobile | times: 1
  # Arrows are needed as soon as either view overflows. Gating them on the desktop count alone
  # left a phone showing two of five collections with no way but a swipe to reach the rest.
  assign show_arrows = false
  if section.blocks.size > settings.columns or section.blocks.size > columns_mobile
    assign show_arrows = true
  endif
  # `auto_hide_controls` only governs the `controls` slot, which this section does not render,
  # so a view that does not overflow has to hide its own arrows.
  assign arrows_mobile_only = false
  if show_arrows and section.blocks.size <= settings.columns
    assign arrows_mobile_only = true
  endif
-%}

{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign block_collection = block.settings.collection

      assign image = block.settings.image
      if image == blank
        assign image = block_collection.featured_image
      endif

      assign label = block.settings.label
      if label == blank
        assign label = block_collection.title
      endif

      assign url = block.settings.link
      if url == blank
        assign url = block_collection.url
      endif
    -%}
    {%- capture slide_content -%}
      <a
        class="collection-carousel__item"
        {% if url != blank %}
          href="{{ url }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <span class="collection-carousel__media">
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 1200
              | image_tag:
                widths: '300, 600, 900, 1200',
                sizes: '(min-width: 750px) 25vw, 70vw',
                loading: 'lazy',
                class: 'collection-carousel__image'
            }}
          {%- endif -%}
        </span>

        {%- if label != blank -%}
          <span class="collection-carousel__label">{{ label }}</span>
        {%- endif -%}
      </a>
    {%- endcapture -%}
    {%- render 'slideshow-slide',
      index: forloop.index0,
      children: slide_content,
      class: 'collection-carousel__slide'
    -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="collection-carousel spacing-style{% if settings.uppercase_labels %} collection-carousel--uppercase{% endif %}{% if arrows_mobile_only %} collection-carousel--arrows-mobile-only{% endif %}"
  style="
    --section-heading-level-size: var({{ heading_level_size }});
    --collection-carousel-background: {{ settings.background_color }};
    --collection-carousel-color: {{ settings.text_color }};
    --collection-carousel-heading-color: {{ settings.heading_color | default: settings.text_color }};
    {%- comment -%}
      Emitted only when set. Left at 0 the declaration that reads it is invalid, so the size
      falls through to the typography preset and then to the chosen heading level - which is
      what makes the level control anything more than the tag name.
    {%- endcomment -%}
    {%- if settings.heading_size > 0 %}
      --collection-carousel-heading-size: {{ settings.heading_size }}px;
    {%- endif %}
    {%- if settings.heading_size_mobile > 0 %}
      --collection-carousel-heading-size-mobile: {{ settings.heading_size_mobile }}px;
    {%- endif %}
    --collection-carousel-label-size: {{ settings.label_size }}px;
    --collection-carousel-columns: {{ settings.columns }};
    --collection-carousel-columns-mobile: {{ settings.columns_mobile }};
    --collection-carousel-ratio: {{ settings.image_ratio }};
    {%- render 'spacing-style', settings: settings %}
  "
  {{ section.shopify_attributes }}
>
  {%- if settings.heading != blank -%}
    <{{ heading_tag }}
      class="collection-carousel__heading {{ heading_preset }}{% if heading_preset == 'custom' %} custom-typography custom-font-size{% elsif heading_preset == 'rte' %} collection-carousel__heading--default{% endif %}"
      style="{%- render 'typography-style', settings: section.settings, type: 'heading' -%}"
    >{{ settings.heading }}</{{ heading_tag }}>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    {%- render 'slideshow',
      ref: 'collectionCarousel',
      class: 'collection-carousel__carousel',
      slides: slides,
      slide_count: section.blocks.size,
      show_arrows: show_arrows,
      icon_style: settings.icons_style,
      icon_shape: 'none',
      arrows_position: 'center',
      auto_hide_controls: true,
      infinite: false,
      initial_slide: 0
    -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .collection-carousel {
    --slide-width: calc(100% / var(--collection-carousel-columns, 5));

    padding-inline: var(--page-margin, 1rem);
    background: var(--collection-carousel-background);
    color: var(--collection-carousel-color);
  }

  .collection-carousel__heading {
    margin: 0 0 var(--gap-6xl, 4rem);
    color: var(--collection-carousel-heading-color);
    text-align: center;
  }

  /* Only the Default preset is dressed here. A named preset or Custom owns every typography
     property through its own class, and a rule of ours would silently outrank it. */
  .collection-carousel__heading--default {
    font-family: var(--font-heading--family);

    /* No fallback after the level: with the size left at 0 nothing is emitted, the declaration
       is invalid and the heading keeps the size its level gives it. */
    font-size: var(
      --collection-carousel-heading-size-mobile,
      var(--collection-carousel-heading-size, var(--font-size, var(--section-heading-level-size)))
    );
    font-weight: var(--font-heading--weight);
    line-height: 1.1;

    @media screen and (min-width: 750px) {
      font-size: var(--collection-carousel-heading-size, var(--font-size, var(--section-heading-level-size)));
    }
  }

  /* The theme's slideshow paints its own page-coloured background, which shows up as a band across
     a section with a colour of its own. */
  .collection-carousel__carousel slideshow-container {
    background: transparent;
  }

  /* Arrows sit at the edges and stay visible, as in the design, instead of fading in on hover. */
  .collection-carousel__carousel slideshow-arrows {
    mix-blend-mode: normal;
  }

  .collection-carousel__carousel slideshow-arrows .slideshow-control {
    opacity: 1;
    color: currentcolor;

    /* stylelint-disable-next-line declaration-no-important */
    /* The hover-reveal animation in base.css is matched by a selector too specific to outrank
       without an unreadable one of our own, and it starts from opacity 0 - which would make
       always-visible arrows blink on hover. */
    animation: none !important;
  }

  /* No width here on purpose: the theme sizes a slide with `slideshow-slide { width: var(--slide-width) }`,
     and a class setting one of its own would outrank it and leave a single slide per view. */
  .collection-carousel__slide {
    padding-inline: var(--gap-lg, 1rem);
  }

  .collection-carousel__item {
    display: grid;
    gap: var(--gap-xl, 1.25rem);
    color: inherit;
    text-decoration: none;
  }

  .collection-carousel__media {
    display: block;
    overflow: hidden;
    aspect-ratio: var(--collection-carousel-ratio, 1);
  }

  .collection-carousel__image {
    inline-size: 100%;
    block-size: 100%;

    /* Collection images come in every shape, and the design wants one clean grid, so they fill the
       frame rather than letterboxing inside it. */
    object-fit: cover;
  }

  .collection-carousel__label {
    font-size: var(--collection-carousel-label-size);
    letter-spacing: 0.06em;
    text-align: center;
  }

  .collection-carousel--uppercase .collection-carousel__label {
    text-transform: uppercase;
  }

  /* Both views share one set of arrows, so the view that does not overflow hides them. */
  @media screen and (min-width: 750px) {
    .collection-carousel--arrows-mobile-only slideshow-arrows {
      display: none;
    }
  }

  /* One or two at a time on a phone, where five would be unreadable. Same calculation as the
     desktop track, so a slide is still an exact fraction of the width and the snap lands clean. */
  @media screen and (max-width: 749px) {
    .collection-carousel {
      --slide-width: calc(100% / var(--collection-carousel-columns-mobile, 2));
    }
  }
{% endstylesheet %}

