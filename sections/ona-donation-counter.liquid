{%- comment -%}
  Water For Good contribution counter.

  Ported from the legacy theme (`sections/ona-donation-counter.liquid` on theme
  160335790271) for the 2026 cutover. The markup and the measurements are the
  ones Formswell approved and that are live today — card 71x92 at 83px, 16px
  gaps, 2px frame, and the horizontal split line across each card — so the two
  themes render the counter identically.

  Two deliberate differences from the legacy copy:

  1. The styles live here. On the legacy theme they sit in ONA's `main.css`,
     which this theme does not carry, so the section would have rendered
     unstyled. Everything below is scoped to `.donation-counter`.
  2. Fonts come from the brand tokens (`--font-brand-text` = Karla,
     `--font-brand-display` = Silk Serif) instead of being hard-coded. Karla is
     the same face the legacy counter used, so the numerals are unchanged. The
     CTA is the one real substitution: legacy sets it in "Palmer Lake Print",
     which this theme does not ship -- it falls back to the brand display face.
     NEEDS A FORMSWELL DECISION before go-live.

  The number itself is `shop.metafields.custom.donation_total`, written by the
  recompute job in ona-data-platform (`scripts/ops/wfg-donation-counter.ts`).
  The section only formats it, and renders $0 rather than breaking if the
  metafield is missing.
{%- endcomment -%}

{%- liquid
  assign donation_total = shop.metafields.custom.donation_total.value | default: 0
  assign amount = donation_total | floor
-%}

{%- comment -%}
  `spacing-style` is the class that defines --spacing-scale. The snippet below
  emits `max(20px, calc(var(--spacing-scale) * Npx))` for any padding above
  20px, so without the class that value is invalid and every padding setting
  from 21 to 100 silently does nothing.
{%- endcomment -%}
<section
  class="donation-counter spacing-style"
  style="
    background-color: {{ section.settings.bg_color }};
    {% render 'spacing-style', settings: section.settings %}
    --donation-button-background: {{ section.settings.button_bg_color }};
    --donation-button-text: {{ section.settings.button_text_color }};
    --dc-card-gap: {{ section.settings.card_gap }}px;
    --dc-digit-size: {{ section.settings.digit_size }}px;
    --dc-gap-title: {{ section.settings.gap_title }}px;
    --dc-gap-counter: {{ section.settings.gap_counter }}px;
    --dc-gap-subtitle: {{ section.settings.gap_subtitle }}px;
    --dc-heading-size: {{ section.settings.heading_size }}px;
    --dc-subtitle-size: {{ section.settings.subtitle_size }}px;
    --dc-heading-color: {{ section.settings.heading_color }};
    --dc-subtitle-color: {{ section.settings.subtitle_color }};
    --dc-card-bg: {{ section.settings.card_bg_color }};
    --dc-card-ink: {{ section.settings.card_ink_color }};
    --dc-frame-color: {{ section.settings.frame_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="donation-counter__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="donation-counter__heading">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="donation-counter__display" data-amount="{{ amount }}">
      <div class="donation-counter__cards">
        <div class="donation-counter__card donation-counter__card--symbol">
          <span>$</span>
        </div>

        {%- assign num_str = amount | append: '' -%}
        {%- assign num_len = num_str | size -%}
        {%- for i in (1..num_len) -%}
          {%- assign char_index = i | minus: 1 -%}
          {%- assign digit = num_str | slice: char_index, 1 -%}

          <div class="donation-counter__card">
            <span>{{ digit }}</span>
          </div>

          {%- assign pos = num_len | minus: i -%}
          {%- assign pos_mod = pos | modulo: 3 -%}
          {%- if pos > 0 and pos_mod == 0 -%}
            <div class="donation-counter__card donation-counter__card--comma">
              <span>,</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.subtitle != blank -%}
      <p class="donation-counter__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.learn_more_text != blank and section.settings.learn_more_url != blank -%}
      <div class="donation-counter__actions">
        <a href="{{ section.settings.learn_more_url }}" class="button donation-counter__cta">
          {{- section.settings.learn_more_text -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .donation-counter {
    /* The four values come from the editor via spacing-style; the class on the
       section supplies both --spacing-scale and the 0px defaults it falls back
       to, so no literal fallback belongs here. Earlier ones read 43/30/52 and
       matched the configured values exactly, which is why the broken scale
       looked correct. */
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    text-align: center;
    color: #ffffff;
  }

  .donation-counter__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .donation-counter__heading {
    font-family: var(--font-brand-text, 'Karla', sans-serif);
    font-size: var(--dc-heading-size, 16px);
    font-weight: 400;
    letter-spacing: calc(0.09 / 16 * 1em);
    line-height: 1.2;
    margin: 0 0 var(--dc-gap-title, 20px);
    color: var(--dc-heading-color, #fbf8f3);
  }

  .donation-counter__display {
    display: inline-block;
    margin: 0 auto var(--dc-gap-counter, 39px);
  }

  .donation-counter__cards {
    display: inline-flex;
    align-items: center;
    gap: var(--dc-card-gap, 16px);
    border: 2px solid var(--dc-frame-color, #000);
    border-radius: 12px;
    padding: 13px 14px;
  }

  .donation-counter__card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Card keeps the live 71x92 @ 83px proportions; one size control scales all three. */
    width: calc(var(--dc-digit-size, 83px) * 71 / 83);
    height: calc(var(--dc-digit-size, 83px) * 92 / 83);
    background: var(--dc-card-bg, #f2f0eb);
    font-family: var(--font-brand-text, 'Karla', sans-serif);
    font-size: var(--dc-digit-size, 83px);
    font-weight: 700;
    line-height: 1;
    color: var(--dc-card-ink, #441925);
  }

  /* The split across the middle of each card -- it reads as a flip-counter. */
  .donation-counter__card::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 100%;
    height: 5px;
    background-color: var(--dc-card-ink, #441925);
    pointer-events: none;
    z-index: 1;
  }

  .donation-counter__card--symbol {
    background: var(--dc-card-bg, #f2f0eb);
  }

  .donation-counter__card--comma {
    width: 15px;
    background: transparent;
    color: var(--dc-card-bg, #f2f0eb);
    font-size: calc(var(--dc-digit-size, 83px) * 72 / 83);
    font-weight: 700;
  }

  /*
   * The comma card inherits the split line above. On the default background it
   * is invisible -- the line is #441925 and so is the section -- which is how
   * it renders on the live theme today, so it is left exactly as it is rather
   * than "fixed" here. Change `bg_color` away from #441925 and a dark bar
   * appears across the comma. Formswell's call, not a silent deviation.
   */

  .donation-counter__subtitle {
    font-family: var(--font-brand-text, 'Karla', sans-serif);
    font-size: var(--dc-subtitle-size, 16px);
    font-weight: 400;
    letter-spacing: calc(-0.09 / 16 * 1em);
    line-height: 1.2;
    margin: 0 0 var(--dc-gap-subtitle, 7px);
    color: var(--dc-subtitle-color, #fbf8f3);
  }

  .donation-counter__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  /* Reuse the global theme button, overriding only its editable colours. */
  .donation-counter__cta.button {
    --button-background-color: var(--donation-button-background);
    --button-color: var(--donation-button-text);
  }

  @media screen and (max-width: 749px) {
    .donation-counter {
      padding: 40px 15px;
    }

    .donation-counter__cards {
      gap: 3px;
      padding: 8px 10px;
    }

    .donation-counter__card {
      width: 48px;
      height: 68px;
      font-size: 48px;
    }

    .donation-counter__card::after {
      height: 3px;
    }

    .donation-counter__card--comma {
      width: 18px;
      font-size: 48px;
    }

    .donation-counter__heading {
      font-size: 13px;
      letter-spacing: 2px;
    }

  }

  @media screen and (max-width: 480px) {
    .donation-counter__cards {
      gap: 2px;
      border-radius: 8px;
      padding: 6px 8px;
    }

    .donation-counter__card {
      width: 36px;
      height: 52px;
      border-radius: 4px;
      font-size: 36px;
    }

    .donation-counter__card--comma {
      width: 14px;
      font-size: 36px;
    }

    /*
     * Six-figure totals overflow a 320px viewport at the sizes above. The row
     * is $ + n digits + a comma every third digit, so six digits is 8 children:
     * 7 cards x 36 + 14 comma + 7 gaps x 2 + 16 padding + 4 border = 300px,
     * against 320 - 30 section padding = 290px available. At 32/12 it comes to
     * 270px and fits. Guarding on the 8th child means a five-digit total -- the
     * only case this campaign can reach, goal $20,000 -- keeps the measurements
     * that were matched against the live counter, untouched. Codex, PR #150.
     */
    .donation-counter__cards:has(> .donation-counter__card:nth-child(8)) .donation-counter__card {
      width: 32px;
      height: 46px;
      font-size: 32px;
    }

    .donation-counter__cards:has(> .donation-counter__card:nth-child(8)) .donation-counter__card--comma {
      width: 12px;
      font-size: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contribution counter",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#441925"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title text",
      "default": "DOLLARS CONTRIBUTED SO FAR"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle text",
      "default": "Enjoy great coffee while helping fund clean water access."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title text",
      "default": "#fbf8f3"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle text",
      "default": "#fbf8f3"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#f2f0eb"
    },
    {
      "type": "color",
      "id": "card_ink_color",
      "label": "Card digits and split line",
      "default": "#441925"
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Counter frame",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Counter size"
    },
    {
      "type": "range",
      "id": "digit_size",
      "label": "Digit size",
      "info": "Scales the number cards; the mobile sizes stay fixed so the counter keeps fitting narrow screens.",
      "min": 24,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 83
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Text sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Title size",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing between items"
    },
    {
      "type": "range",
      "id": "gap_title",
      "label": "Gap below title",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_counter",
      "label": "Gap below counter",
      "info": "Space between the number and the subtitle.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 39
    },
    {
      "type": "range",
      "id": "gap_subtitle",
      "label": "Gap below subtitle",
      "info": "Space between the subtitle and the button.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "header",
      "content": "Button colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#f2f0eb"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#441925"
    },
    {
      "type": "text",
      "id": "learn_more_text",
      "label": "Link text",
      "default": "Shop Coffees"
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Link url"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 43
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Contribution counter",
      "category": "Custom"
    }
  ]
}
{% endschema %}
