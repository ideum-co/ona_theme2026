{% render 'ona-band', section: section %}
<script src="{{ 'ona-slider.js' | asset_url }}" type="module"></script>
<section class="add-image-and-text unique-testimonial-block testimonial_video_section section-full-large bg-red wowo no-padding show-image-slider fadeIn section-relative-image{% if section.settings.media_position == 'right' %} invert-columns{% endif %}" data-wow-duration="0.75s" data-wow-delay="300ms" id="{{ section.settings.id }}">
    <div class="container">
        <div class="content">
            <ona-slider class="ona-slider">
            <div class="ona-slider__nav" role="tablist" aria-label="{{ section.settings.title | default: 'Testimonials' | escape }}" data-slider-nav></div>
            <div class="img imgs-slider-testimonial wowo fadeIn slider-{{ section.settings.id }}" data-auto="{{ section.settings.slider_autoplay }}" id="slider-{{ section.settings.id }}" data-slider-track>
               {% assign i = 0  %}

               {% for block in section.blocks %}
                {%- case block.type -%}
                  {%- when 'block' -%}
                    <div class="slider-block episode_{{ forloop.index }}" data-parent="slider-{{ section.settings.id }}" data-slider-slide data-slide-label="Episode {{ forloop.index }}">
                        {% if block.settings.media_type == 'embed' or block.settings.media_type == 'upload' %}
                        <div class="scale-video">
                            {% assign unique_id = 'now' | date: '%s' %}
                            {%assign player_id = section.settings.id | append: 'uplaod_video_' | append:unique_id | append:i %}
                            {% assign video_id = '' %}
                            {% assign video_url = '' %}

                            {% assign autoplay = block.settings.autoplay %}
                            {% if block.settings.media_type == 'upload' %}

                                  {% assign video_id = block.settings.video.sources[1].url %}
                                  {% assign video_url = video_id %}
                                  <video id="{{ player_id }}" class="video-js" controls muted defaultMuted playsinline preload="auto" data-src="{{video_id}}"></video>
                            {% else %}
                                {% assign video_url = block.settings.video_url %}
                                {% assign video_id_index = video_url | split: '/' | size | minus: 1 %}
                                {% if video_url contains 'v=' %}{% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}{% else %}{% assign video_id = video_url | split: '/' | last | split: '?' | first %}{% endif %}
                                {% if video_url contains 'vimeo' %}
                                    <iframe id="{{ player_id }}" src="https://player.vimeo.com/video/{{ video_id }}" data-auto="{{ autoplay }}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen playsinline></iframe>
                                {% else if video_url != '' %}
                                    <div id="{{ player_id }}" data-auto="{{ autoplay }}"></div>
                                {% endif  %}
                             {% endif  %}
                        </div>
                          <a class="scale-cover-video play-video" data-auto="{{ autoplay }}" data-url="{{ video_url }}" data-video="{{ video_id }}" data-type="{{ block.settings.media_type }}" data-id="{{ player_id }}">
                              {% if block.settings.play_icon != blank %}<img src="{{ block.settings.play_icon | img_url: '100x' }}" alt="title-play-video" />{% endif %}
                          </a>
                          <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.image.alt | escape }}" class="wowo fadeInup scale-cover-image" data-wow-duration="0.75s" data-wow-delay="300ms">
                          {% else %}
                              <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.image.alt | escape }}" class="wowo fadeInup" data-wow-duration="0.75s" data-wow-delay="300ms">
                          {% endif %}

                          {% if block.settings.video_title != '' %}
                            <div class="testimonial_video_title">
                              <h5 class="video_episode_name">Episode {{ forloop.index }}</h5>
                              <h5 class="video_title">{{ block.settings.video_title }}</h5>
                            </div>
                          {% endif %}
                    </div>
                    {% assign i = i | plus:1 %}
                {% endcase %}
              {% endfor %}

            </div>
            </ona-slider>
            <div class="text wowo fadeInUp" data-wow-duration="0.75s" data-wow-delay="900ms">
                <h2>{{ section.settings.title }}</h2>
                <h3>{{ section.settings.subtitle }}</h3>
                <p>{{ section.settings.content }}</p>
              <p></p>
                  <p>
                  <a href="https://forms.monday.com/forms/6b1a3a5478c16210a1dae4ae5b3f86dc?r=use1" class="more-btn" target="_blank" rel="noreferrer noopener">Get In Touch</a>
                </p>
                <div class="video_select_wrap video_select_field">
                  <div class="filter-select">
                    <div class="current-value" data-current-tag="episode_1">Episode Select</div>
                    <ul>
                      {% comment %} <li><button data-tag="episode_1" disabled style="pointer-event:none">Episode Select</button></li> {% endcomment %}
                      {% for block in section.blocks %}
                      {% if block.settings.video_title != '' %}
                        <li class="{% if forloop.index == 1  %}selected{% endif %}"><button data-tag="episode_{{ forloop.index }}">Ep {{ forloop.index }}. {{ block.settings.video_title }}</button></li>
                      {% endif %}
                      {% endfor %}
                    </ul>
                    {% comment %}
                    <select class="testimonial_video_dropdown">
                      <option value="episode_1" disabled>Episode Select</option>
                      {% for block in section.blocks %}
                          {% if block.settings.video_title != '' %}
                              <option value="episode_{{ forloop.index }}" {% if forloop.index == 1  %}selected{% endif %}>Ep {{ forloop.index }}. {{ block.settings.video_title }}</option>
                          {% endif %}
                      {% endfor %}
                    </select>
                    {% endcomment %}
                  </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% stylesheet %}
  /*
   * Slider styles live with the section, not in legacy-page-layout.css: that
   * sheet is loaded only for a fixed list of page suffixes, and this section
   * has a preset, so it can be placed on any JSON template. Where the sheet is
   * absent the slides would stack at full size with nothing to collapse them.
   */
  .ona-slider__nav { display: none; }

  .ona-slider.is-enhanced .ona-slider__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    margin-block-end: clamp(1rem, 3vw, 2rem);
  }

  /* Square, uppercase, wide-tracked -- the treatment these pages already use. */
  .ona-slider__tab {
    padding: 0 0 0.5rem;
    border: 0;
    border-block-end: 2px solid transparent;
    border-radius: 0;
    background: none;
    font: inherit;
    font-size: var(--font-h6--size, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.55;
    cursor: pointer;
  }

  .ona-slider__tab:hover,
  .ona-slider__tab:focus-visible { opacity: 1; }

  .ona-slider__tab.is-active {
    opacity: 1;
    border-block-end-color: currentcolor;
  }

  /*
   * Stacking only once enhanced. Before that the track flows normally and every
   * slide is readable; a slider that collapses before its script runs loses
   * content on a slow connection.
   */
  .ona-slider.is-enhanced [data-slider-track] { display: grid; }

  .ona-slider.is-enhanced [data-slider-slide] {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }

  .ona-slider.is-enhanced [data-slider-slide].is-active {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .ona-slider.is-enhanced [data-slider-slide] { transition: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": {
    "en": "Testimonials"
  },
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "text",
      "id": "id",
      "label": {
        "en": "ID"
      }
    },
    {
      "type": "text",
      "id": "title",
      "label": {
		"en": "Title"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": {
		"en": "Subtitle"
      }
    },
    {
      "type": "textarea",
      "id": "content",
      "label": {
		"en": "Content"
      }
    },
    {
      "type": "checkbox",
      "id": "slider_autoplay",
      "label": "Slider Auto Play",
      "default":false
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": {
        "en": "Slider"
      },
      "settings": [
          {
            "type": "select",
            "id": "media_type",
            "label": "Media Type",
            "info": "Select media to show",
            "options": [
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "embed",
                "label": "YouTube/Vimeo URL"
              },
              {
                "value": "upload",
                "label": "Upload Video"
              }
            ]
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": {
      		"en": "Image"
            }
          },
          {
            "type": "video",
            "id": "video",
            "label": "Select Video"
          },
          {
              "type": "video_url",
              "id": "video_url",
              "label": "YouTube/Vimeo",
              "accept": [
                "youtube",
                "vimeo"
              ]
          },
          {
            "type": "text",
            "id": "video_title",
            "label": "Title"
          },
        {
          "type": "image_picker",
          "id": "play_icon",
          "label": {
    		"en": "Play Icon"
          }
       },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Enable Auto Play",
            "default":false
          }
      ]
    }
  ],
  "presets": [
    {
      "name": {
        "en": "Testimonials"
      },
      "category": {
        "en": "Text"
      }
    }
  ]
}
{% endschema %}
