{%- liquid
  assign settings = section.settings
  assign badge_label = settings.accessible_label | default: settings.fallback_text | default: 'Promotion'

  # The badge can be one or two stacked layers. Each layer resolves to an
  # uploaded image first, then the bundled Black Friday art, then (back layer
  # only) the text fallback. The front layer is optional.
  assign has_back = false
  if settings.image != blank or settings.use_bf_art or settings.fallback_text != blank
    assign has_back = true
  endif

  assign has_front = false
  if settings.enable_top_layer
    if settings.image_top != blank or settings.use_bf_art
      assign has_front = true
    endif
  endif
-%}

{%- capture back_layer -%}
  <span class="floating-badge__layer floating-badge__layer--back{% if settings.animate and settings.animate_back %} floating-badge__layer--animated{% endif %}">
    <span class="floating-badge__rotator" style="--fb-duration: {{ settings.duration }}s; --fb-direction: {{ settings.direction }};">
      {%- if settings.image != blank -%}
        {{
          settings.image
          | image_url: width: 800
          | image_tag:
            widths: '120, 180, 240, 360, 480, 640, 800',
            sizes: '(max-width: 749px) 120px, 200px',
            loading: 'eager',
            class: 'floating-badge__image',
            alt: ''
        }}
      {%- elsif settings.use_bf_art -%}
        <img class="floating-badge__image" src="{{ 'floating-badge-bf-bg.svg' | asset_url }}" alt="" loading="eager" width="233" height="227">
      {%- else -%}
        <span class="floating-badge__fallback" aria-hidden="true">{{ settings.fallback_text | escape }}</span>
      {%- endif -%}
    </span>
  </span>
{%- endcapture -%}

{%- capture front_layer -%}
  {%- if has_front -%}
    <span class="floating-badge__layer floating-badge__layer--front{% if settings.animate and settings.animate_front %} floating-badge__layer--animated{% endif %}">
      <span class="floating-badge__rotator" style="--fb-duration: {{ settings.duration_top }}s; --fb-direction: {{ settings.direction_top }};">
        {%- if settings.image_top != blank -%}
          {{
            settings.image_top
            | image_url: width: 800
            | image_tag:
              widths: '120, 180, 240, 360, 480, 640, 800',
              sizes: '(max-width: 749px) 120px, 200px',
              loading: 'eager',
              class: 'floating-badge__image',
              alt: ''
          }}
        {%- else -%}
          <img class="floating-badge__image" src="{{ 'floating-badge-bf-text.svg' | asset_url }}" alt="" loading="eager" width="233" height="227">
        {%- endif -%}
      </span>
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- capture badge_content -%}{{ back_layer }}{{ front_layer }}{%- endcapture -%}

<div
  class="floating-badge floating-badge--{{ settings.position }}{% if settings.hide_on_mobile %} floating-badge--hide-mobile{% endif %}"
  style="
    --floating-badge-size: {{ settings.size }}px;
    --floating-badge-size-mobile: {{ settings.size_mobile }}px;
    --floating-badge-offset-vertical: {{ settings.offset_vertical }}px;
    --floating-badge-offset-horizontal: {{ settings.offset_horizontal }}px;
    --floating-badge-z-index: {{ settings.z_index }};
    --floating-badge-background: {{ settings.fallback_background }};
    --floating-badge-color: {{ settings.fallback_text_color }};
  "
  {{ section.shopify_attributes }}
>
  {%- if settings.link != blank -%}
    <a
      class="floating-badge__link"
      href="{{ settings.link }}"
      aria-label="{{ badge_label | escape }}"
      {% if settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    >
      {{ badge_content }}
    </a>
  {%- else -%}
    <div class="floating-badge__link" role="img" aria-label="{{ badge_label | escape }}">
      {{ badge_content }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .floating-badge {
    position: fixed;
    z-index: var(--floating-badge-z-index, 10);
    width: var(--floating-badge-size);
    height: var(--floating-badge-size);
    pointer-events: none;
  }

  .floating-badge--top-left,
  .floating-badge--top-right {
    top: var(--floating-badge-offset-vertical);
  }

  .floating-badge--bottom-left,
  .floating-badge--bottom-right {
    bottom: var(--floating-badge-offset-vertical);
  }

  .floating-badge--top-left,
  .floating-badge--bottom-left {
    left: var(--floating-badge-offset-horizontal);
  }

  .floating-badge--top-right,
  .floating-badge--bottom-right {
    right: var(--floating-badge-offset-horizontal);
  }

  .floating-badge__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    pointer-events: auto;
    text-decoration: none;
  }

  /* Each layer fills the badge and stacks on top of the previous one, so the
     background art and the text sit in the same circle and spin independently. */
  .floating-badge__layer {
    position: absolute;
    inset: 0;
  }

  .floating-badge__rotator,
  .floating-badge__image,
  .floating-badge__fallback {
    display: block;
    width: 100%;
    height: 100%;
  }

  .floating-badge__link:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .floating-badge__image {
    object-fit: contain;
  }

  .floating-badge__fallback {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    padding: 18%;
    border: 1px solid currentcolor;
    border-radius: 50%;
    background: var(--floating-badge-background);
    color: var(--floating-badge-color);
    font-size: clamp(0.7rem, 1.1vw, 1rem);
    line-height: 1.15;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Each rotator reads its OWN --fb-duration / --fb-direction, so the two
       layers can turn at different speeds and in opposite directions. */
    .floating-badge__layer--animated .floating-badge__rotator {
      animation: floating-badge-spin var(--fb-duration, 12s) linear infinite var(--fb-direction, normal);
      transform-origin: center;
      will-change: transform;
    }

    .floating-badge__link:hover .floating-badge__layer--animated .floating-badge__rotator {
      animation-play-state: paused;
    }
  }

  @keyframes floating-badge-spin {
    to { transform: rotate(360deg); }
  }

  @media screen and (max-width: 749px) {
    .floating-badge {
      width: var(--floating-badge-size-mobile);
      height: var(--floating-badge-size-mobile);
    }

    .floating-badge--hide-mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Floating badge",
  "tag": "section",
  "class": "floating-badge-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "enable_top_layer", "label": "Two layers (background + top)", "default": true, "info": "Off = a single spinning badge. On = a background layer with a second layer (e.g. the lettering) on top, each with its own speed and direction." },
    { "type": "checkbox", "id": "use_bf_art", "label": "Use the bundled Black Friday badge art", "default": true, "info": "When a layer has no image uploaded, fall back to the packaged 'Black Friday Sale' artwork." },
    { "type": "image_picker", "id": "image", "label": "Background layer image", "info": "Optional. Overrides the bundled background art." },
    { "type": "image_picker", "id": "image_top", "label": "Top layer image", "info": "Optional. Overrides the bundled lettering.", "visible_if": "{{ section.settings.enable_top_layer }}" },
    { "type": "text", "id": "fallback_text", "label": "Fallback text", "default": "New Harvest Sale", "info": "Shown only if the background layer has no image and the bundled art is off." },
    { "type": "text", "id": "accessible_label", "label": "Accessible label", "default": "View the current promotion" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in a new tab", "default": false },

    { "type": "header", "content": "Position and size" },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-right"
    },
    { "type": "range", "id": "size", "label": "Size", "min": 60, "max": 360, "step": 5, "unit": "px", "default": 180 },
    { "type": "range", "id": "size_mobile", "label": "Size on mobile", "min": 40, "max": 240, "step": 5, "unit": "px", "default": 100 },
    { "type": "range", "id": "offset_vertical", "label": "Vertical offset", "min": 0, "max": 400, "step": 5, "unit": "px", "default": 140 },
    { "type": "range", "id": "offset_horizontal", "label": "Horizontal offset", "min": 0, "max": 240, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "z_index", "label": "Layer", "min": 1, "max": 100, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },

    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "animate", "label": "Animate (rotate)", "default": true, "info": "Master switch. Off = both layers sit still. On = each layer below can spin or stay still on its own." },
    { "type": "checkbox", "id": "animate_back", "label": "Spin the background layer", "default": true, "visible_if": "{{ section.settings.animate }}" },
    { "type": "range", "id": "duration", "label": "Background speed (seconds per turn)", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 16, "visible_if": "{{ section.settings.animate and section.settings.animate_back }}" },
    {
      "type": "select",
      "id": "direction",
      "label": "Background direction",
      "options": [
        { "value": "normal", "label": "Clockwise" },
        { "value": "reverse", "label": "Counterclockwise" }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.animate and section.settings.animate_back }}"
    },
    { "type": "checkbox", "id": "animate_front", "label": "Spin the top layer", "default": true, "visible_if": "{{ section.settings.animate and section.settings.enable_top_layer }}" },
    { "type": "range", "id": "duration_top", "label": "Top speed (seconds per turn)", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 10, "visible_if": "{{ section.settings.animate and section.settings.animate_front and section.settings.enable_top_layer }}" },
    {
      "type": "select",
      "id": "direction_top",
      "label": "Top direction",
      "options": [
        { "value": "normal", "label": "Clockwise" },
        { "value": "reverse", "label": "Counterclockwise" }
      ],
      "default": "reverse",
      "visible_if": "{{ section.settings.animate and section.settings.animate_front and section.settings.enable_top_layer }}"
    },

    { "type": "header", "content": "Fallback style" },
    { "type": "color", "id": "fallback_background", "label": "Background", "default": "#8A1538" },
    { "type": "color", "id": "fallback_text_color", "label": "Text color", "default": "#F5F4EA" }
  ],
  "presets": [{ "name": "Floating badge" }]
}
{% endschema %}
