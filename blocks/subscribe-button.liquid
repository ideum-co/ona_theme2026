{%- doc -%}
  A subscribe button for the product card that opens the product page's own purchase options in an
  anchored panel, so a shopper can start a subscription without leaving the grid.

  The panel offers the subscription only. It used to lead with "One time purchase", preselected,
  above a button reading "Add to cart" - so pressing Subscribe and then the one button in the
  panel that appeared bought a one-time item at full price. Order #120030 was one of those. The
  card already carries its own add to cart button beside this one for the one-time case.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant

  assign unique_id = block.id | append: '-' | append: product.id
  assign trigger_id = 'SubscribeTrigger-' | append: unique_id
  assign panel_id = 'SubscribePanel-' | append: unique_id
  assign form_id = 'SubscribeForm-' | append: unique_id
  assign form_component_id = 'SubscribeFormComponent-' | append: unique_id
  assign anchor_slug = unique_id | handleize
  assign anchor_name = '--subscribe-trigger-' | append: anchor_slug

  assign has_variants = false
  if product.has_only_default_variant == false and product.variants_count > 1
    assign has_variants = true
  endif

  # Product-level selling plan groups are not the same question as "can this variant be
  # subscribed to": a 200g-only plan leaves the 1kg variant with no allocation. Submitting then
  # would add a one-time item, which is the bug this panel exists to close, so the button is
  # held closed and `purchase-options` explains why.
  assign variant_is_subscribable = false
  if variant.selling_plan_allocations.size > 0
    assign variant_is_subscribable = true
  endif
-%}

{%- comment -%}
  Nothing to subscribe to without a selling plan, so the button stays out of the card entirely
  rather than opening an empty panel.
{%- endcomment -%}
{%- unless product == blank or product.selling_plan_groups.size == 0 -%}
  {%- comment -%}
    Carries `variant-select` as well: the panel's custom properties - gap, border colour, viewport
    margin - are declared on that class, and without it `top: calc(anchor(bottom) + var(--gap))`
    is invalid at computed-value time and the panel loses its anchoring.
  {%- endcomment -%}
  <subscribe-popover-component
    class="variant-select subscribe-block"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      id="{{ trigger_id }}"
      class="button subscribe-block__trigger {{ block_settings.style_class }}"
      ref="trigger"
      on:click="/toggle"
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
      style="anchor-name: {{ anchor_name }};"
    >
      {{- block_settings.label | default: 'Subscribe' -}}
    </button>

    <div
      id="{{ panel_id }}"
      class="variant-select__panel subscribe-block__panel"
      ref="panel"
      on:click="/handlePanelClick"
      style="position-anchor: {{ anchor_name }};"
    >
      <div class="variant-select__header">
        <span class="variant-select__title">{{ block_settings.label | default: 'Subscribe' }}</span>
        <button
          type="button"
          class="button button-unstyled variant-select__close"
          on:click="/close"
          aria-label="{{ 'actions.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>

      <div class="subscribe-block__body">
        {%- if has_variants -%}
          {%- render 'variant-select-dropdown',
            product: product,
            unique_id: unique_id,
            form_component_id: form_component_id
          -%}
        {%- endif -%}

        {%- render 'purchase-options',
          product: product,
          form_id: form_id,
          unique_id: unique_id,
          subscription_only: true
        -%}

        <product-form-component
          id="{{ form_component_id }}"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          on:submit="/handleSubmit"
        >
          <div
            class="visually-hidden"
            aria-live="assertive"
            role="status"
            aria-atomic="true"
            ref="liveRegion"
          ></div>
          {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              ref="variantId"
              value="{{ variant.id }}"
              {% if variant.available == false %}
                disabled
              {% endif %}
            >
            <input
              type="hidden"
              name="quantity"
              value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
            >
            {%- comment -%}
              Carries the trigger's own label, so the button that completes the action says the
              same word as the button that started it. The separate `submit_label` setting is
              gone: every template stored the schema default "Add to cart" against it, which is
              exactly the wording that made shoppers think they were buying once.

              Precompute it: Liquid does not allow a filter (`| default:`) inside a `render` tag
              argument -- doing so is a parse error ("Expected end_of_string but found pipe"),
              which makes this block fail to compile and, in turn, makes every template that uses
              the `subscribe` block invalid. Assign first, then pass it.
            {%- endcomment -%}
            {%- assign subscribe_submit_label = block_settings.label | default: 'Subscribe' -%}
            {%- assign subscribe_can_add = false -%}
            {%- if variant.available and variant_is_subscribable -%}
              {%- assign subscribe_can_add = true -%}
            {%- endif -%}
            {%- render 'add-to-cart-button',
              add_to_cart_text: subscribe_submit_label,
              class: 'subscribe-block__submit add-to-cart-button',
              can_add_to_cart: subscribe_can_add,
              show_icon: false,
              product: product
            -%}
          {%- endform -%}
        </product-form-component>
      </div>
    </div>
  </subscribe-popover-component>

  {%- render 'variant-select-styles' -%}
  {%- render 'add-to-cart-button-styles' -%}
{%- endunless -%}

{% stylesheet %}
  /* Stretches to the row instead of sizing to its own text, so it always matches whatever the
     add to cart button next to it measures - that one is taller because it carries an icon. */
  .subscribe-block {
    display: block;
    align-self: stretch;
    inline-size: 100%;
  }

  .subscribe-block__trigger.button {
    inline-size: 100%;
    block-size: 100%;
    justify-content: center;
  }

  /* Positioned inside the card rather than in the top layer: the card's own overflow clips it, so
     it can never lie across the next card in a grid or a carousel. The containing block is
     `.product-card__content`, which is the nearest positioned ancestor, so `inset-inline: 0` is
     the full width of the card.

     `anchor(top)` puts its bottom edge on the top of the button row. Where anchor positioning is
     not supported the panel simply reaches the bottom of the card instead - still inside it. */
  .subscribe-block .subscribe-block__panel {
    /* Overrides the variant panel's own positioning, including the `position: fixed` it falls back
       to without CSS anchor positioning - fixed would escape the card just like the top layer did. */
    position: absolute;
    inset-block-start: auto;
    inset-inline: 0;
    inset-block-end: 0;
    inset-block-end: anchor(top);
    display: none;
    inline-size: auto;
    min-inline-size: 0;
    max-inline-size: none;

    /* Not `100%`: the containing block is `.group-block-content`, the button row, which is about
       43px tall - the panel collapsed to that and its contents fell outside the box. A viewport
       cap keeps it independent of the row, and the card's overflow still clips it. */
    max-block-size: min(60vh, 26rem);
    z-index: var(--layer-raised, 2);
  }

  .subscribe-block[open] .subscribe-block__panel {
    display: flex;
    flex-direction: column;
  }

  /* Hover, focus and open all read the same: dark outline on a light fill. Drawn with an inset
     shadow rather than a border so the button's box never changes size between states. */
  .subscribe-block__trigger.button:is(:hover, :focus-visible),
  .subscribe-block[open] .subscribe-block__trigger.button {
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: inset 0 0 0 1px var(--color-foreground);
  }

  .subscribe-block__body {
    display: grid;
    gap: var(--gap-lg);
    padding: var(--padding-lg);

    /* Without min-block-size the body would refuse to shrink and overflow the panel instead of
       scrolling inside it. */
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .subscribe-block__submit.button {
    inline-size: 100%;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.subscribe_button",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_subscribe_button"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.button_primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.button_secondary"
        },
        {
          "value": "button-unstyled",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    }
  ],
  "presets": [
    {
      "name": "t:names.subscribe_button",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
