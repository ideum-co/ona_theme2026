{% liquid
  assign current_handle = closest.collection.handle
  assign pills = 'all:All Products|milk-based:Milk-based Coffee|filter:Filter Coffee|espresso:Espresso Coffee|ready-to-brew:Ready to Brew|special-release:Special Release|candy:Candy|rare-coffee:Rare Coffee|reserve:Reserve' | split: '|'
%}

<div
  class="category-pills spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <nav
    class="category-pills__scroll"
    aria-label="Shop by category"
  >
    {% for pill in pills %}
      {% liquid
        assign pill_parts = pill | split: ':'
        assign pill_handle = pill_parts[0]
        assign pill_label = pill_parts[1]
        assign is_active = false
        if current_handle == pill_handle
          assign is_active = true
        endif
      %}
      <a
        href="/collections/{{ pill_handle }}"
        class="category-pills__pill{% if is_active %} is-active{% endif %}"
        {% if is_active %}
          aria-current="page"
        {% endif %}
      >
        {{ pill_label }}
      </a>
    {% endfor %}
  </nav>
</div>

{% stylesheet %}
  .category-pills {
    width: 100%;
    grid-column: 1 / -1;
  }

  .category-pills__scroll {
    display: flex;
    gap: var(--gap-xs);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: 2px;
  }

  .category-pills__scroll::-webkit-scrollbar {
    display: none;
  }

  .category-pills__pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border: 1px solid var(--border-color);
    border-radius: var(--style-border-radius-pills);
    padding: var(--gap-2xs) var(--gap-md);
    font-size: var(--font-size--xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
    background: var(--color-background);
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .category-pills__pill:hover {
    border-color: var(--color-foreground);
  }

  .category-pills__pill.is-active {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category pills",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Category pills",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
