{%- doc -%}
  One panel of the product tabs section.

  The label lives here rather than on the section so a tab is one thing in the editor: rename it,
  reorder it, or fill it, all in the same place. The section reads these labels to draw the strip.

  Public on purpose: a private type (an underscore prefix) is not offered in "Add block", so the
  tabs could not be added from the editor at all.

  Content is whatever theme or app blocks the tab holds, which is what keeps this usable before and
  after the move to metaobjects: today a `custom-liquid` or `product-metafield-text` block reads
  `closest.product`, tomorrow the same slot takes a block that reads a metaobject entry, and the
  tab chrome does not change either way.
{%- enddoc -%}

{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="product-tabs__panel"
  id="ProductTabPanel-{{ block.id }}"
  role="tabpanel"
  aria-labelledby="ProductTab-{{ block.id }}"
  tabindex="0"
  ref="panels[]"
  {{ block.shopify_attributes }}
>
  {{ children }}
</div>

{% schema %}
{
  "name": "Tab",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "info": "The wording in the tab strip. A tab with no label keeps its content on the page but gets no tab."
    }
  ],
  "presets": [
    {
      "name": "Tab"
    }
  ]
}
{% endschema %}
