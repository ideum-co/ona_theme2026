{%- liquid
  assign product_resource = closest.product
-%}
{%- capture ona_tags_style -%}margin-top: 0;{% render 'spacing-style', settings: block.settings %}{%- endcapture -%}
{%- capture ona_tags_markup -%}
  {%- render 'ona-product-tags-pdp',
    product: product_resource,
    class: 'ona-pdp-tags spacing-style',
    style: ona_tags_style,
    attrs: block.shopify_attributes
  -%}
{%- endcapture -%}
{%- liquid
  assign ona_tags_trimmed = ona_tags_markup | strip
  assign dbg_pr_blank = false
  if product_resource == blank
    assign dbg_pr_blank = true
  endif
  assign dbg_markup_blank = false
  if ona_tags_trimmed == blank
    assign dbg_markup_blank = true
  endif
  assign dbg_len = ona_tags_markup | strip | size
  assign dbg_tsval = product_resource.metafields.custom_product.tag_status.value
-%}
<div class="onadebug" style="background:yellow;color:black;font-size:12px;padding:6px;z-index:9999;position:relative">ONADEBUG pr_blank={{ dbg_pr_blank }} | title={{ product_resource.title }} | layout={{ section.settings.layout_type }} | tsval={{ dbg_tsval }} | markupblank={{ dbg_markup_blank }} | len={{ dbg_len }}</div>
{%- if ona_tags_trimmed != blank -%}
  {{ ona_tags_markup }}
{%- elsif request.design_mode -%}
  <div class="product_single_custom_tag_black ona-pdp-tags ona-pdp-tags--placeholder" style="margin-top: 0;" {{ block.shopify_attributes }}>
    <span class="custom_product_tags"><h5>Promo tag none active</h5></span>
  </div>
{%- elsif product_resource != blank and section.settings.layout_type == 'carousel' -%}
  <div class="ona-pdp-tags ona-pdp-tags--empty" aria-hidden="true"></div>
{%- endif -%}

{% schema %}
{
  "name": "Promo tags",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Shows scheduled promo badges." },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [ { "name": "Promo tags", "category": "t:categories.product" } ]
}
{% endschema %}
