{% liquid
  assign unset_image_tag = false
  if block.settings.image_position == 'contain'
    assign unset_image_tag = true
  endif

  # Whether this block actually has media. Connected to a dynamic source (e.g. a product
  # metaobject), the image or video comes back blank when the product has nothing assigned.
  assign has_media = false
  if block.settings.media_type == 'image' and block.settings.image != blank
    assign has_media = true
  elsif block.settings.media_type == 'video' and block.settings.video != blank
    assign has_media = true
  endif

  # Per-block choice for the empty case. Defaults to hiding (and treats an older block saved
  # before this setting the same way); turn it off to show a placeholder on the storefront too.
  assign hide_when_empty = true
  if block.settings.hide_when_empty == false
    assign hide_when_empty = false
  endif

  # Show the media when there is some; in the theme editor always show it (placeholder included) so
  # the block stays selectable and media can be assigned; on the storefront with no media, show the
  # placeholder only when the merchant has turned off "hide when empty".
  assign show_media = false
  if has_media or request.design_mode or hide_when_empty == false
    assign show_media = true
  endif
%}

{% if show_media %}
  {% render 'media', unset_image_tag: unset_image_tag %}
{% endif %}

{% schema %}
{
  "name": "t:names.media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide when no media",
      "info": "On the storefront, hide this media when no image or video is set (for example a product with no metaobject image), so no stock placeholder shows. The theme editor always shows a placeholder so you can still assign one. Turn off to show a placeholder on the storefront too.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.media_type == 'image'  }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.loop",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.autoplay",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "t:settings.image_position_mobile",
      "info": "t:info.image_position_mobile",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.media"
    }
  ]
}
{% endschema %}
