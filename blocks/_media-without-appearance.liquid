{% liquid
  assign unset_image_tag = false
  if block.settings.image_position == 'contain'
    assign unset_image_tag = true
  endif

  # Whether this block actually has media. Connected to a dynamic source (e.g. a product
  # metaobject), the image or video comes back blank when the product has nothing assigned.
  assign has_media = false
  if block.settings.media_type == 'image' and block.settings.image != blank
    assign has_media = true
  elsif block.settings.media_type == 'video' and block.settings.video != blank
    assign has_media = true
  endif
%}

{%- comment -%}
  On the storefront, render nothing when there is no media, so an unassigned (dynamic) image does
  not fall back to a stock placeholder. In the theme editor we keep the placeholder so the block
  stays selectable and a merchant can still assign media.
{%- endcomment -%}
{% if has_media or request.design_mode %}
  {% render 'media', unset_image_tag: unset_image_tag %}
{% endif %}

{% schema %}
{
  "name": "t:names.media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.media_type == 'image'  }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.loop",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.autoplay",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "t:settings.image_position_mobile",
      "info": "t:info.image_position_mobile",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.media"
    }
  ]
}
{% endschema %}
