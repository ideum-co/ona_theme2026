{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
%}

{% render 'purchase-options',
  product: product,
  form_id: form_id,
  unique_id: block.id,
  label: block.settings.label,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Purchase options",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Purchase options"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Purchase options",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
